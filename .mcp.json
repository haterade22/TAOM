{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@949a27ef1e5fda1a6e7b561e777bcece345c6ffd",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "E:/repos/TAOM"
      ],
      "env": {}
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.8.31",
        "E:\\repos\\TAOM",
        "E:\\Steam\\steamapps\\common\\Mount & Blade II Bannerlord\\Modules",
        "E:\\LOTRAOMAssets\\LOTRAOM_Jan_1_Patreon\\Modules\\LOTRAOM\\ModuleData"
      ],
      "env": {}
    },
    "git": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-git@2026.8.18"],
      "env": {}
    },
    "ilspy": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "ilspy_mcp_server.server"],
      "env": {
        "ILSPY_PATH": "ilspycmd"
      }
    },
    "taom-moduledata": {
      "type": "stdio",
      "command": "python",
      "args": ["E:/repos/TAOM/tools/taom_mcp_server.py"],
      "env": {}
    },
    "imagine": {
      "type": "http",
      "url": "https://mcp.imagine.art"
    },
    "elevenlabs": {
      "type": "stdio",
      "command": "uvx",
      "args": ["elevenlabs-mcp@0.12.2"],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}",
        "ELEVENLABS_MCP_BASE_PATH": "${CLAUDE_PROJECT_DIR:-E:/repos/TAOM}/.voice-scratch",
        "ELEVENLABS_MCP_OUTPUT_MODE": "files"
      }
    }
  }
}
