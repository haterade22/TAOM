{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@7a2968335f2198b966864de1ce3655c8e485a653",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "E:/repos/TAOM"
      ],
      "env": {}
    },
    "ilspy": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "ilspy_mcp_server.server"],
      "env": {
        "ILSPY_PATH": "ilspycmd"
      }
    },
    "taom-moduledata": {
      "type": "stdio",
      "command": "python",
      "args": ["E:/repos/TAOM/tools/taom_mcp_server.py"],
      "env": {}
    },
    "imagine": {
      "type": "http",
      "url": "https://mcp.imagine.art"
    },
    "elevenlabs": {
      "type": "stdio",
      "command": "uvx",
      "args": ["elevenlabs-mcp@0.12.2"],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}",
        "ELEVENLABS_MCP_BASE_PATH": "${CLAUDE_PROJECT_DIR:-E:/repos/TAOM}/.voice-scratch",
        "ELEVENLABS_MCP_OUTPUT_MODE": "files"
      }
    }
  }
}
