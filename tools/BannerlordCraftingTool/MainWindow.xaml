<Window x:Class="BannerlordCraftingTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="Bannerlord Weapon Piece Aligner" Height="780" Width="1250" MinHeight="620" MinWidth="1050"
        Background="#1E1E1E" Foreground="#D4D4D4">
    <Window.Resources>
        <!-- ============ Dark theme palette ============ -->
        <SolidColorBrush x:Key="PanelBrush"      Color="#252526"/>
        <SolidColorBrush x:Key="InputBrush"      Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BtnBrush"        Color="#333337"/>
        <SolidColorBrush x:Key="BtnHoverBrush"   Color="#3E3E42"/>
        <SolidColorBrush x:Key="BtnPressedBrush" Color="#2A2A2C"/>
        <SolidColorBrush x:Key="LineBrush"       Color="#3F3F46"/>
        <SolidColorBrush x:Key="AccentBrush"     Color="#569CD6"/>
        <SolidColorBrush x:Key="TextBrush"       Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SubtleBrush"     Color="#8A8A8A"/>
        <SolidColorBrush x:Key="DisabledBrush"   Color="#5A5A5A"/>

        <!-- ============ Button ============ -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource BtnBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#262628"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#303034"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ TextBox ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E2E32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ComboBox items (dark popup) ============ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#37446B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ComboBox (closed box + arrow + dark popup chrome) ============ -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Data="M0,0 L8,0 L4,5 Z" Fill="#9A9A9A"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="7,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Tabs ============ -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" Padding="14,6">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ToolTip ============ -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="MaxWidth" Value="320"/>
        </Style>

        <!-- ============ Dark scrollbars ============ -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#4A4A50" CornerRadius="3" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="11"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: File loading -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,3">
                <TextBlock Text="Pieces XML:" VerticalAlignment="Center" Width="82" Foreground="#666" FontSize="11"/>
                <TextBox x:Name="PiecesPathBox" Width="265" Margin="0,0,3,0"
                         Background="#2D2D2D" Foreground="#D4D4D4" BorderBrush="#444" Padding="3" FontSize="11"/>
                <Button Content="Browse" Width="56" Margin="0,0,3,0" FontSize="11" Click="BrowsePieces_Click"/>
                <Button Content="Load"   Width="46" Margin="0,0,3,0" FontSize="11" Click="LoadPieces_Click"/>
                <Button Content="Add +"  Width="46" FontSize="11" Click="AddPieces_Click"
                        ToolTip="Append pieces from another XML without clearing existing ones"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Templates XSLT:" VerticalAlignment="Center" Width="100" Foreground="#666" FontSize="11"/>
                <TextBox x:Name="TemplatesPathBox" Width="255" Margin="0,0,3,0"
                         Background="#2D2D2D" Foreground="#D4D4D4" BorderBrush="#444" Padding="3" FontSize="11"/>
                <Button Content="Browse" Width="56" Margin="0,0,3,0" FontSize="11" Click="BrowseTemplates_Click"/>
                <Button Content="Load"   Width="46" FontSize="11" Click="LoadTemplates_Click"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Template selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Weapon Template:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666" FontSize="11"/>
            <ComboBox x:Name="TemplateCombo" Width="210" FontSize="11"
                      Background="#2D2D2D" Foreground="#D4D4D4" BorderBrush="#444"
                      SelectionChanged="TemplateCombo_SelectionChanged"/>
        </StackPanel>

        <!-- Row 2: Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Piece selection -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="PIECES" FontSize="10" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,8"/>

                <TextBlock Text="Blade" Foreground="#4E9FD4" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="BladeSearch" FontSize="10" Tag="Blade" Margin="0,0,0,2"
                         Background="#1A1A1A" Foreground="#AAA" BorderBrush="#333" Padding="2,1"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="BladeCombo" Tag="Blade" FontSize="11" Margin="0,0,0,8"
                          Background="#2D2D2D" Foreground="#D4D4D4" BorderBrush="#444"
                          SelectionChanged="PieceCombo_SelectionChanged"/>

                <TextBlock Text="Guard" Foreground="#C75050" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="GuardSearch" FontSize="10" Tag="Guard" Margin="0,0,0,2"
                         Background="#1A1A1A" Foreground="#AAA" BorderBrush="#333" Padding="2,1"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="GuardCombo" Tag="Guard" FontSize="11" Margin="0,0,0,8"
                          Background="#2D2D2D" Foreground="#D4D4D4" BorderBrush="#444"
                          SelectionChanged="PieceCombo_SelectionChanged"/>

                <TextBlock Text="Handle" Foreground="#4EC94E" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="HandleSearch" FontSize="10" Tag="Handle" Margin="0,0,0,2"
                         Background="#1A1A1A" Foreground="#AAA" BorderBrush="#333" Padding="2,1"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="HandleCombo" Tag="Handle" FontSize="11" Margin="0,0,0,8"
                          Background="#2D2D2D" Foreground="#D4D4D4" BorderBrush="#444"
                          SelectionChanged="PieceCombo_SelectionChanged"/>

                <TextBlock Text="Pommel" Foreground="#C9A04E" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="PommelSearch" FontSize="10" Tag="Pommel" Margin="0,0,0,2"
                         Background="#1A1A1A" Foreground="#AAA" BorderBrush="#333" Padding="2,1"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="PommelCombo" Tag="Pommel" FontSize="11" Margin="0,0,0,12"
                          Background="#2D2D2D" Foreground="#D4D4D4" BorderBrush="#444"
                          SelectionChanged="PieceCombo_SelectionChanged"/>

                <Separator Background="#2A2A2A" Margin="0,0,0,10"/>

                <TextBlock Text="ZOOM (2D)" FontSize="10" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="1x" Foreground="#444" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <Slider x:Name="ZoomSlider" Minimum="1" Maximum="12" Value="3" Width="118"
                            VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged"/>
                    <TextBlock Text="12x" Foreground="#444" FontSize="10" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Center: 2D / 3D tabs -->
            <TabControl Grid.Column="1" Background="#141414" BorderBrush="#2A2A2A" Margin="0,0,10,0"
                        SelectionChanged="CenterTabs_SelectionChanged">
                <!-- 2D Preview -->
                <TabItem Header="2D Preview">
                    <Border Background="#141414">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Background="Transparent">
                            <Canvas x:Name="WeaponCanvas" Width="220" Background="Transparent"
                                    HorizontalAlignment="Center" Margin="0,20,0,20"/>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- 3D Preview -->
                <TabItem Header="3D Preview">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- FBX folder row -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,6,6,4" Background="#1E1E1E">
                            <TextBlock Text="FBX Folder:" VerticalAlignment="Center" Foreground="#666" FontSize="11" Margin="0,0,6,0"/>
                            <TextBox x:Name="FbxFolderBox" Width="310" FontSize="11"
                                     Background="#2D2D2D" Foreground="#D4D4D4" BorderBrush="#444" Padding="3"/>
                            <Button Content="Browse" Width="58" Margin="4,0,4,0" FontSize="11" Click="BrowseFbxFolder_Click"/>
                            <Button Content="Reload" Width="52" FontSize="11" Click="ReloadFbx_Click"
                                    ToolTip="Clear mesh cache and reload all FBX files"/>
                            <TextBlock x:Name="FbxStatusLabel" VerticalAlignment="Center" Foreground="#666"
                                       FontSize="10" Margin="8,0,0,0"/>
                        </StackPanel>
                        <!-- HelixToolkit viewport -->
                        <h:HelixViewport3D x:Name="Viewport3D" Grid.Row="1" Background="#141414"
                                           ShowViewCube="False" ShowCoordinateSystem="False"
                                           IsInertiaEnabled="True"
                                           AllowDrop="True"
                                           DragEnter="Viewport3D_DragEnter"
                                           Drop="Viewport3D_Drop"
                                           MouseLeftButtonDown="Viewport3D_MouseLeftButtonDown"
                                           MouseLeftButtonUp="Viewport3D_MouseLeftButtonUp">
                            <h:HelixViewport3D.Camera>
                                <PerspectiveCamera Position="0,0,300" LookDirection="0,0,-1"
                                                   UpDirection="0,1,0" FieldOfView="25"/>
                            </h:HelixViewport3D.Camera>
                            <h:SunLight/>
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <AmbientLight Color="#404040"/>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                            <ModelVisual3D x:Name="SceneRoot"/>
                        </h:HelixViewport3D>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Right: Offset editor + XML output -->
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="WeaponLengthLabel" Text="Weapon length: —" FontSize="12" FontWeight="Bold"
                           Foreground="#7CC96A" Margin="0,0,0,10"
                           ToolTip="Crafted reach (raw units = cm). 'reach' = the rounded WeaponLength stat the game stores."/>
                <TextBlock Text="OFFSET EDITOR" FontSize="10" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,8"/>

                <Border x:Name="OffsetEditor" Background="#252526" CornerRadius="3" Padding="10"
                        Margin="0,0,0,10" IsEnabled="False">
                    <StackPanel>
                        <TextBlock x:Name="SelectedPieceLabel" Text="(click a piece to edit)"
                                   Foreground="#555" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Step:" Foreground="#666" FontSize="10" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="0.1" Tag="0.1" GroupName="Step" FontSize="11"
                                         Foreground="#CCC" Margin="0,0,10,0" Checked="StepRadio_Checked"/>
                            <RadioButton Content="0.5" Tag="0.5" GroupName="Step" FontSize="11"
                                         Foreground="#CCC" Margin="0,0,10,0" Checked="StepRadio_Checked"/>
                            <RadioButton Content="1"   Tag="1"   GroupName="Step" FontSize="11"
                                         Foreground="#CCC" Margin="0,0,10,0" IsChecked="True" Checked="StepRadio_Checked"/>
                            <RadioButton Content="5"   Tag="5"   GroupName="Step" FontSize="11"
                                         Foreground="#CCC" Checked="StepRadio_Checked"/>
                        </StackPanel>

                        <TextBlock Text="piece_offset" Foreground="#666" FontSize="10" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="PieceOffsetBox" Width="112" Tag="piece_offset"
                                     Background="#1A1A1A" Foreground="#9CDCFE" BorderBrush="#444"
                                     Padding="3" FontSize="12"
                                     LostFocus="OffsetBox_LostFocus" KeyDown="OffsetBox_KeyDown"/>
                            <Button Content="−" Width="30" Margin="5,0,2,0" FontSize="13"
                                    Tag="piece_offset,-1" Click="OffsetStep_Click"/>
                            <Button Content="+" Width="30" FontSize="13"
                                    Tag="piece_offset,1" Click="OffsetStep_Click"/>
                        </StackPanel>

                        <TextBlock Text="previous_piece_offset" Foreground="#666" FontSize="10" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="PrevOffsetBox" Width="112" Tag="previous_piece_offset"
                                     Background="#1A1A1A" Foreground="#9CDCFE" BorderBrush="#444"
                                     Padding="3" FontSize="12"
                                     LostFocus="OffsetBox_LostFocus" KeyDown="OffsetBox_KeyDown"/>
                            <Button Content="−" Width="30" Margin="5,0,2,0" FontSize="13"
                                    Tag="previous_piece_offset,-1" Click="OffsetStep_Click"/>
                            <Button Content="+" Width="30" FontSize="13"
                                    Tag="previous_piece_offset,1" Click="OffsetStep_Click"/>
                        </StackPanel>

                        <TextBlock Text="next_piece_offset" Foreground="#666" FontSize="10" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="NextOffsetBox" Width="112" Tag="next_piece_offset"
                                     Background="#1A1A1A" Foreground="#9CDCFE" BorderBrush="#444"
                                     Padding="3" FontSize="12"
                                     LostFocus="OffsetBox_LostFocus" KeyDown="OffsetBox_KeyDown"/>
                            <Button Content="−" Width="30" Margin="5,0,2,0" FontSize="13"
                                    Tag="next_piece_offset,-1" Click="OffsetStep_Click"/>
                            <Button Content="+" Width="30" FontSize="13"
                                    Tag="next_piece_offset,1" Click="OffsetStep_Click"/>
                        </StackPanel>

                        <TextBlock Text="scale_factor (%)" Foreground="#666" FontSize="10" Margin="0,12,0,3"/>
                        <TextBox x:Name="ScaleBox" Width="112" HorizontalAlignment="Left"
                                 Background="#1A1A1A" Foreground="#9CDCFE" BorderBrush="#444"
                                 Padding="3" FontSize="12"
                                 ToolTip="Per-use &lt;Piece scale_factor&gt; (default 100). Scales the mesh and all its distances."
                                 LostFocus="OffsetBox_LostFocus" KeyDown="OffsetBox_KeyDown"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="XML OUTPUT" FontSize="10" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,6"/>
                <TextBox x:Name="XmlOutputBox" IsReadOnly="True" TextWrapping="Wrap"
                         Height="190" VerticalScrollBarVisibility="Auto"
                         Background="#1A1A1A" Foreground="#9CDCFE" FontFamily="Consolas" FontSize="11"
                         BorderBrush="#333" Padding="8" Margin="0,0,0,6"/>
                <Button Content="Copy BuildData to Clipboard" Click="CopyXml_Click"
                        HorizontalAlignment="Stretch" FontSize="11" Padding="0,5"/>
                <Button Content="Export tuned offsets (JSON)" Click="ExportOffsets_Click"
                        HorizontalAlignment="Stretch" FontSize="11" Padding="0,5" Margin="0,6,0,0"
                        ToolTip="Write only the pieces whose offsets changed (dirty) to a JSON file for AI-assisted XML patching"/>
            </StackPanel>
        </Grid>

        <!-- Row 3: Status bar -->
        <Border Grid.Row="3" Background="#252526" Padding="8,4" Margin="0,6,0,0" CornerRadius="2">
            <TextBlock x:Name="StatusLabel" Text="Load pieces XML and templates XSLT to begin."
                       Foreground="#555" FontSize="11"/>
        </Border>
    </Grid>
</Window>
