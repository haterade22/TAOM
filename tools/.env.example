# TAOM Tools — Environment Variable Overrides
# Copy this file to .env and set values matching your machine.
# Scripts fall back to the hardcoded defaults if these are unset.

# Full path to the downloaded map PNG used by faction map scripts
# Default: C:\Users\mikew\Downloads\Vista_dot-settlements-with-borders.png
TAOM_MAP_IMAGE=

# Directory containing cropped culture/region PNGs for faction map assembly
# Default: E:\LOTRAOMAssets\Culture Selection
TAOM_REGIONS_DIR=

# Output directory for assembled faction map assets
# Default: <repo>/tools/factionmap_output
TAOM_FACTION_MAP_OUTPUT=

# Path to the TAOM_Map module settlements.xml (map maker's copy)
# Default: E:\Steam\steamapps\common\Mount & Blade II Bannerlord\Modules\TAOM_Map\ModuleData\settlements.xml
TAOM_MAP_FILE=

# Base path to the LOTRLOME_Armory gondor item directory
# Default: E:\Steam\steamapps\common\Mount & Blade II Bannerlord\Modules\LOTRLOME_Armory\ModuleData\LOTRLOME_items\gondor
TAOM_ARMORY_BASE=
