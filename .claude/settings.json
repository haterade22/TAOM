{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "mcp__git__git_add",
      "mcp__git__git_commit",
      "mcp__git__git_reset",
      "mcp__git__git_checkout",
      "mcp__git__git_create_branch",
      "mcp__filesystem__write_file",
      "mcp__filesystem__edit_file",
      "mcp__filesystem__move_file",
      "mcp__filesystem__create_directory",
      "mcp__serena__create_text_file",
      "mcp__serena__replace_content",
      "mcp__serena__replace_in_files",
      "mcp__serena__delete_lines",
      "mcp__serena__replace_lines",
      "mcp__serena__insert_at_line",
      "mcp__serena__replace_symbol_body",
      "mcp__serena__insert_after_symbol",
      "mcp__serena__insert_before_symbol",
      "mcp__serena__rename_symbol",
      "mcp__serena__safe_delete_symbol",
      "mcp__serena__execute_shell_command",
      "mcp__serena__jet_brains_move",
      "mcp__serena__jet_brains_safe_delete",
      "mcp__serena__jet_brains_rename",
      "mcp__serena__jet_brains_inline_symbol"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "TAOM_PYBIN": "C:/Python314/python.exe"
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/detect-docs-gaps.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-no-verify.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/validate-push.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-claude-files-tracked.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-commit-subject-version.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-dangerous-git.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-broad-git-add.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-moduledata-validation.sh",
            "statusMessage": "Validating ModuleData refs before commit…",
            "timeout": 60
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-native-dll-crt.sh",
            "statusMessage": "Checking vendored native DLL links a static CRT…",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-doc-config-drift.sh",
            "statusMessage": "Linting docs for config drift, version, and budget…",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/config-protection.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mcp-health-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify-csharp-edit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-polearm-shield-parity.sh",
            "statusMessage": "Checking no roster pairs a shield with a weapon the AI will not draw…",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mark-verification-run.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mark-verification-run.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mcp-health-mark.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mark-verification-run.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/log-agent.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-deep-review.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-verification-evidence.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-version-tagged.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-stop.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "codex@openai-codex": true
  }
}
