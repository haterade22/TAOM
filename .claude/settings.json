{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/detect-docs-gaps.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-build-before-commit.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/validate-push.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-changelog-changed.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-claude-files-tracked.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-broad-git-add.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-moduledata-validation.sh",
            "statusMessage": "Validating ModuleData refs before commit…"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-native-dll-crt.sh",
            "statusMessage": "Checking vendored native DLL links a static CRT…"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-doc-config-drift.sh",
            "statusMessage": "Linting docs for config drift, version, and budget…"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/config-protection.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/suggest-compact.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mcp-health-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify-csharp-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify-test-results.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/mark-verification-run.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mcp-health-mark.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-compact.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/log-agent.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-changelog-updated.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-deep-review.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-verification-evidence.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-version-tagged.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-stop.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "codex@openai-codex": true
  }
}
