<?xml version="1.0" encoding="UTF-8"?>
<!--
  TAOM.Dependencies passive alias stub for Bannerlord.MBOptionScreen (MCM).
  See Stubs/Bannerlord.Harmony/_Module/SubModule.xml for the full design
  rationale. Real MCMv5.dll + Bannerlord.MBOptionScreen.v1.4.{0-5}.dll
  + ModuleLoader load via TAOM.Dependencies's SubModule.xml.
-->
<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/BUTR/Bannerlord.XmlSchemas/master/SubModule.xsd">
    <Id value="Bannerlord.MBOptionScreen" />
    <Name value="MBOptionScreen / MCM (provided by TAOM.Dependencies)" />
    <Version value="v5.12.99.0" />
    <DefaultModule value="true" />
    <SingleplayerModule value="true" />
    <MultiplayerModule value="true" />
    <Official value="false" />
    <ModuleCategory value="Singleplayer" />
    <ModuleType value="Community" />
    <Url value="" />

    <DependedModules>
        <DependedModule Id="TAOM.Dependencies" />
        <DependedModule Id="Bannerlord.Harmony" />
        <DependedModule Id="Bannerlord.UIExtenderEx" />
        <DependedModule Id="Bannerlord.ButterLib" />
    </DependedModules>
    <DependedModuleMetadatas>
        <DependedModuleMetadata id="TAOM.Dependencies" order="LoadBeforeThis" />
        <DependedModuleMetadata id="Bannerlord.Harmony" order="LoadBeforeThis" />
        <DependedModuleMetadata id="Bannerlord.UIExtenderEx" order="LoadBeforeThis" />
        <DependedModuleMetadata id="Bannerlord.ButterLib" order="LoadBeforeThis" />
    </DependedModuleMetadatas>

    <SubModules>
        <SubModule>
            <Name value="Bannerlord.MBOptionScreen Alias Stub" />
            <DLLName value="TAOM.Dependencies.dll" />
            <SubModuleClassType value="TAOM.Dependencies.AliasStubSubModule" />
            <Tags>
                <!-- Fails Module.CheckIfSubmoduleCanBeLoadable in every mode (v1.5.7, and BLSE's
                     ModuleInfoHelper agrees), so the engine skips this entry before it looks for
                     TAOM.Dependencies.dll in this folder's bin and shows "Cannot find" (#969).
                     The entry stays: BLSE treats a module with no SubModule as metadata-only. -->
                <Tag key="IsNoRenderModeElement" value="true" />
            </Tags>
        </SubModule>
    </SubModules>
</Module>
