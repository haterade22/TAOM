<?xml version="1.0" encoding="UTF-8"?>
<Module xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/BUTR/Bannerlord.XmlSchemas/master/SubModule.xsd">
  <Id value="TAOM" />
  <Name value="TAOM" />
  <Version value="v2.0.25" />
  <DefaultModule value="false" />
  <ModuleCategory value="Singleplayer"/>
  <ModuleType value="Community" />
  <DependedModules>
    <DependedModule Id="Native" />
    <DependedModule Id="SandBoxCore" />
    <DependedModule Id="Sandbox" />
    <DependedModule Id="CustomBattle" />
    <!-- Issue #371. TAOM does not merely call into TAOM.Dependencies — Main/TAOM.csproj takes a
         ProjectReference on it and resolves HarmonyLib AND Bannerlord.UIExtenderEx THROUGH that
         assembly. A missing or stale copy therefore fails at the member level during patch
         application, the preview patches never attach, and every character renders in bind pose.
         Until now this hard requirement was declared nowhere, so the launcher had nothing to check
         and a user could run any TAOM against any Dependencies. <DependedModule> is the
         engine-honoured element (ModuleInfo.LoadWithFullPath parses it; it does NOT parse
         DependedModuleMetadatas), so this is what actually blocks a broken pairing. -->
  </DependedModules>
  <DependedModuleMetadatas>
    <DependedModuleMetadata id="Native" order="LoadBeforeThis" version="v1.4.8.*" />
    <!-- Version-pinned mirror of the DependedModule above, for BUTR/BLSE launchers (which DO read
         this block). Bump this alongside Dependencies/_Module/SubModule.xml's <Version> whenever
         the Dependencies assembly changes — a stale pairing is the #371 failure mode. -->
   <DependedModuleMetadata id="SandBoxCore" order="LoadBeforeThis" />
    <DependedModuleMetadata id="Sandbox" order="LoadBeforeThis" />
    <DependedModuleMetadata id="CustomBattle" order="LoadBeforeThis" />
    <!-- Co-op interop (2026-07-31). BUTR/BLSE launchers read this block; the VANILLA launcher does
         not — `TaleWorlds.ModuleManager.ModuleInfo.LoadWithFullPath` (installed v1.4.7) parses only
         DependedModules, ModulesToLoadAfterThis, IncompatibleModules and SubModules, with no branch
         for DependedModuleMetadatas at all. The engine-honoured pin is the <ModulesToLoadAfterThis>
         element below; this line is the BUTR-launcher mirror of it. Deliberately NOT a
         <DependedModule> — that would make TAOM unlaunchable without the co-op mod installed. -->
    <DependedModuleMetadata id="BannerlordTogether" order="LoadAfterThis" optional="true" />
    <DependedModuleMetadata id="BattleLinkMPClient" order="LoadAfterThis" optional="true" />
    <DependedModuleMetadata id="Coop" order="LoadAfterThis" optional="true" />
  </DependedModuleMetadatas>
  <!-- Engine-honoured load-order pin (vanilla launcher topology-sorts on this + DependedModules).
       Ordering TAOM before the co-op layer is what the Priority.High on the DeclareWar/MakePeace
       prefixes assumes: TAOM validates racial enmity / War of the Ring constraints first, and a
       blocked action is never synced. Unknown ids are ignored by the launcher, so listing a mod the
       player doesn't have costs nothing. Keep in sync with
       Dependencies/_Module/coop-modules.txt [modules] — pinned by BundledDependencyManifestTests. -->
  <ModulesToLoadAfterThis>
    <Module Id="BannerlordTogether" />
    <Module Id="BattleLinkMPClient" />
    <!-- BannerlordCoop (Workshop 3770450698) — distinct from BannerlordTogether; launcher id is the
         bare "Coop". Ordering TAOM first matters for the same Priority.High DeclareWar/MakePeace
         reason as above. Details: docs/research/bannerlordcoop-internals.md -->
    <Module Id="Coop" />
  </ModulesToLoadAfterThis>
