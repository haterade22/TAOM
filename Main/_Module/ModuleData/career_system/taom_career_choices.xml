<?xml version="1.0" encoding="utf-8"?>
<CareerChoices>

  <!-- ═══ Root (always active) ═══ -->
  <Choice id="warboss_root" group_id="" type="Passive"
          description="{=taom_warboss_root_desc}Rally the Horde grants +5% troop damage and scales duration with Leadership."
          icon_sprite="career_choice_warboss_root">
    <PassiveEffect type="TroopDamage" magnitude="0.05" operation="Add" is_percentage="true" />
    <Mutations>
      <Mutation target_id="warboss_rally_horde" property="Duration"
                calculator="skill_scaling" skill="Leadership" factor="0.02" operation="Add" />
    </Mutations>
  </Choice>

  <!-- ═══ Tier 1: Brutality (melee damage) ═══ -->
  <ChoiceGroup id="warboss_brutality" career_id="warboss" tier="1">
    <Choice id="warboss_brutality_keystone" type="Keystone"
            description="{=taom_warboss_brut_key}Rally the Horde also charges from damage dealt. Ability radius increased."
            icon_sprite="career_choice_brutality_key">
      <Mutations>
        <Mutation target_id="warboss_rally_horde" property="Radius"
                  calculator="flat" value="3" operation="Add" />
      </Mutations>
    </Choice>
    <Choice id="warboss_brutality_p1" type="Passive"
            description="{=taom_warboss_brut_p1}+10% personal melee damage."
            icon_sprite="career_choice_brutality_p1">
      <PassiveEffect type="Damage" magnitude="0.10" operation="Add" is_percentage="true" attack_type_mask="Melee" />
    </Choice>
    <Choice id="warboss_brutality_p2" type="Passive"
            description="{=taom_warboss_brut_p2}+5% armor penetration."
            icon_sprite="career_choice_brutality_p2">
      <PassiveEffect type="ArmorPenetration" magnitude="0.05" operation="Add" is_percentage="true" />
    </Choice>
    <Choice id="warboss_brutality_p3" type="Passive"
            description="{=taom_warboss_brut_p3}+15% swing speed."
            icon_sprite="career_choice_brutality_p3">
      <PassiveEffect type="SwingSpeed" magnitude="0.15" operation="Add" is_percentage="true" />
    </Choice>
    <Choice id="warboss_brutality_p4" type="Passive"
            description="{=taom_warboss_brut_p4}+50 max health."
            icon_sprite="career_choice_brutality_p4">
      <PassiveEffect type="Health" magnitude="50" operation="Add" />
    </Choice>
  </ChoiceGroup>

  <!-- ═══ Tier 1: Dominion (party/army buffs) ═══ -->
  <ChoiceGroup id="warboss_dominion" career_id="warboss" tier="1">
    <Choice id="warboss_dominion_keystone" type="Keystone"
            description="{=taom_warboss_dom_key}Rally the Horde duration extended. Troops gain morale boost in battle."
            icon_sprite="career_choice_dominion_key">
      <Mutations>
        <Mutation target_id="warboss_rally_horde" property="Duration"
                  calculator="flat" value="4" operation="Add" />
      </Mutations>
    </Choice>
    <Choice id="warboss_dominion_p1" type="Passive"
            description="{=taom_warboss_dom_p1}+10% troop morale."
            icon_sprite="career_choice_dominion_p1">
      <PassiveEffect type="TroopMorale" magnitude="0.10" operation="Add" is_percentage="true" />
    </Choice>
    <Choice id="warboss_dominion_p2" type="Passive"
            description="{=taom_warboss_dom_p2}+5% party size."
            icon_sprite="career_choice_dominion_p2">
      <PassiveEffect type="PartySize" magnitude="0.05" operation="Add" is_percentage="true" />
    </Choice>
    <Choice id="warboss_dominion_p3" type="Passive"
            description="{=taom_warboss_dom_p3}+5% troop damage."
            icon_sprite="career_choice_dominion_p3">
      <PassiveEffect type="TroopDamage" magnitude="0.05" operation="Add" is_percentage="true" />
    </Choice>
    <Choice id="warboss_dominion_p4" type="Passive"
            description="{=taom_warboss_dom_p4}-10% troop wages."
            icon_sprite="career_choice_dominion_p4">
      <PassiveEffect type="TroopWages" magnitude="-0.10" operation="Add" is_percentage="true" />
    </Choice>
  </ChoiceGroup>

