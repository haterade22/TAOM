<?xml version="1.0" encoding="utf-8"?>
<!--
  Career-tied quest definitions (Phase 6, verified on Bannerlord 1.4.5).
  Each <CareerQuest> binds to a (career_id, tier); completing its objectives unlocks that tier of
  the career's choice tree (hybrid with the level gate) and applies its rewards. Careers/tiers with
  no entry here simply fall through to the level gate (graceful — like the Gondor-first rollout of
  the career system itself).

  Objective types : WinBattles, SkillThreshold(param=skill id), SettlementsCaptured, TournamentsWon,
                    RenownThreshold, GoldAccumulated, DefeatEnemyLords (capture an at-war lord),
                    VisitSettlementType(param=Town/Castle/Village)
  Reward types    : UnlockTier(amount=1-3), GrantRenown(amount), GrantInfluence(amount),
                    GrantItem(param=item id, amount=count), GrantAttributeFlag(param=flag)

  Proof of life: one Gondor career (captain_of_osgiliath) tier-2 quest. Author the rest in Phase 2.
-->
<CareerQuests>

  <CareerQuest id="captain_of_osgiliath_t2"
               career_id="captain_of_osgiliath"
               tier="2"
               title_key="{=taom_cq_capt_osg_t2_title}The Defense of the East Bank"
               description_key="{=taom_cq_capt_osg_t2_desc}Osgiliath's ruins must hold against the Shadow. Prove yourself worthy of the rank of Captain — win Gondor's battles, master the blade, and let your renown spread along the Anduin.">
    <Objectives>
      <Objective type="WinBattles"       target="15"  task_key="{=taom_cq_capt_osg_t2_obj_battles}Win battles for Gondor" />
      <Objective type="SkillThreshold"   target="100" param="OneHanded" task_key="{=taom_cq_capt_osg_t2_obj_skill}Master the One Handed blade" />
      <Objective type="RenownThreshold"  target="200" task_key="{=taom_cq_capt_osg_t2_obj_renown}Win renown along the Anduin" />
    </Objectives>
    <Rewards>
      <Reward type="UnlockTier"          amount="2" />
      <Reward type="GrantRenown"         amount="100" />
      <Reward type="GrantAttributeFlag"  param="captain_of_osgiliath_proven" />
    </Rewards>
  </CareerQuest>

</CareerQuests>
