<?xml version="1.0" encoding="utf-8"?>
<AbilityTuning>

  <!-- All values are whole-number percentages (15 = 15%). Executors convert to engine scale. -->

  <!-- Global: shared between all 50 careers. Cooldown is a fixed timer (seconds) — abilities start ready, lock for cooldown_seconds after activation. -->
  <Global cooldown_seconds="30" />

  <!-- Infantry: AoE buff to all nearby troops -->
  <Infantry
    damage_bonus="15"
    damage_reduction="10"
    radius="50"
    />

  <!-- Ranged: AoE buff to the caster and all nearby troops (every archetype is AoE). ranged_damage_bonus lands on
       DamageMultiplierBonus, which the engine applies to every hit, melee included; the name says where it is aimed, not where it stops. -->
  <Ranged
    speed_bonus="15"
    ranged_damage_bonus="20"
    draw_speed_bonus="20"
    />

  <!-- Cavalry: AoE buff to the caster and all nearby troops; mount_speed_bonus and charge_damage_bonus apply on each
       buffed rider's MOUNT (#611), damage_bonus on the rider. -->
  <Cavalry
    mount_speed_bonus="20"
    charge_damage_bonus="25"
    damage_bonus="10"
    />

</AbilityTuning>
