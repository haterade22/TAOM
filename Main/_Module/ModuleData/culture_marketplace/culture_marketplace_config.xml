<?xml version="1.0" encoding="utf-8"?>
<!--
  Culture Marketplace overrides — optional.

  When this file is empty the engine auto-derives culture → items pools from MBObjectManager
  (group by ItemObject.Culture.StringId, with ID-prefix fallback for items missing the attribute).

  Three sections:

  1. <Culture id="..."> — per-culture blacklist / weight boost.
       <Blacklist><Item id="anduril" /></Blacklist>     keep specific items quest-only
       <Boost>   <Item id="..." weight="3.0" /></Boost> bias weighted-draw toward an item
       armour_from="rivendell"                          a culture with no armour of its own
                                                        draws the named culture's character
                                                        armour into its pool, and its lord kit
                                                        (docs/features/armour-acquisition.md)
       <Stock from="rivendell" kind="armour" match="silver" weight="1" />
                                                        items this culture's markets carry
                                                        beyond its own (#755): from one
                                                        culture's items (or, without from,
                                                        any item), kind any | armour |
                                                        weapons | not_armour, ids the match
                                                        pattern finds.
                                                        Rows apply in order; the first to add
                                                        an item sets its weight. A culture
                                                        with Stock rows takes its market
                                                        armour from them, not armour_from.

  2. <Routing> — cross-culture item routing (top-level).
       <Item id="warg_brown" cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />
     Items listed here IGNORE their `Culture.X` attribute and ID-prefix fallback. They
     appear ONLY in the listed cultures' pools. Use this for items that culturally belong
     to a faction GROUP rather than a single culture — e.g., wargs are Isengard-tagged in
     the upstream XML but lore-correctly should appear in every "evil" culture's markets.

     Optional `min_stock="N"` (0–100) guarantees at least N units in each listed culture's
     town markets — the daily tick tops up if the roster count drops below the floor.
     min_stock injection BYPASSES PerTownTotalRosterCap (lore-essential items must always
     be available). Bad values (negative, non-integer, over ceiling) revert to 0 with warn.

  Weight validation: 0 <= weight <= 1000, finite (NaN / Infinity rejected). Bad values
  revert to 1.0 with a warning written to the TAOM log. Lifetime: provider is
  Reuse.Singleton; changes require a full Bannerlord restart, not a save reload.
-->
<CultureMarketplaceConfig>

  <!-- Cultures that own no Armory armour draw on a related culture's, the mapping the Armourer's
       Commission rows use (Mike, 2026-09-27: "Lord kit and markets"). Their towns' markets then carry
       that culture's armour, which the armour acquisition gate sells by armoury level, and their lord
       harness is that culture's lord kit. -->
  <!-- Lindon stocks Rivendell's silver and silver-gold armour, never the gold, the plain cloth and
       leather pieces that are neither (capes, leather boots, light torsos, the mask hood: what Lindon's
       troops wear), and every Rivendell weapon (Mike, 2026-10-08, #755). <Stock> rows replace
       armour_from for the market; armour_from still names its lord kit and material donor. -->
  <Culture id="lindon" armour_from="rivendell">
    <Stock from="rivendell" kind="armour" match="silver" />
    <Stock from="rivendell" kind="armour" match="^(rivendell_(boots|boots_leather[0-9]|cape_[ab]|helmet_mask_hood|pauldron_cape|pauldron_leather_(cape|robe)|torso_light_light_tier[0-9]|vambraces_gloves1)|starter_(cavalry|infantry|ranged)_rivendell_(body|leg)_a)$" />
    <Stock from="rivendell" kind="weapons" />
  </Culture>
  <!-- Arthedain stocks the Arnor kit and the Numenorean blades, and Gondor's goods only where the Arnor
       kit has no slot: swords, axes, spears, lances, bows, shields, harness (Mike, 2026-10-08, #755). The Arnor
       pieces are tagged Culture.gondor and the blades carry no culture, so both are picked by id; the
       first row to add an item sets its weight. The king's crown is never sold (Mike, 2026-10-08): it is
       Arthedain's lord's-ladder head reward (armour_acquisition_config.xml, <LadderPieces>). -->
  <Culture id="arthedain" armour_from="gondor">
    <Blacklist>
      <Item id="sk_ar_art_crown_king_a" />
    </Blacklist>
    <Stock match="^sk_ar_art_" weight="3" />
    <Stock match="^numenorean_" weight="3" />
    <Stock from="gondor" kind="not_armour" weight="0.5" />
  </Culture>
  <!-- Gondor's own pool carries the Arnor pieces (tagged Culture.gondor); the crown stays out of it too. -->
  <Culture id="gondor">
    <Blacklist>
      <Item id="sk_ar_art_crown_king_a" />
    </Blacklist>
  </Culture>
  <Culture id="lothlorien" armour_from="rivendell" />
  <Culture id="abanissa" armour_from="aserai" />
  <Culture id="shaghana" armour_from="aserai" />
  <Culture id="battania" armour_from="khuzait" />
  <Culture id="goblin" armour_from="mordor" />
  <Culture id="mistymountainorcs" armour_from="mordor" />
  <Culture id="bluecraig" armour_from="mordor" />
  <Culture id="umbar" armour_from="mordor" />

  <Routing>
    <!-- Warg mounts from LOTRLOME_Armory/ModuleData/LOTRLOME_items/LOTRAOM_horses.xml are tagged
         Culture.isengard upstream but should appear in all four "evil" culture markets.
         min_stock="1" guarantees at least one of each variant + the saddle is always
         available in Isengard / Mordor / Gundabad / Dol Guldur towns. -->
    <Item id="warg_brown"  cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />
    <Item id="warg_dark"   cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />
    <Item id="warg_albino" cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />
    <Item id="warg_saddle" cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />

    <!-- Dwarven war rams and their bardings (#515), from
         LOTRLOME_Armory/ModuleData/LOTRLOME_items/LOTRAOM_horses.xml. Unlike the wargs above,
         all ten already carry culture="Culture.erebor" upstream, so the auto-derived pool
         would place them correctly on its own. These entries are here for min_stock: routing
         is the only way to guarantee a floor, and Ironpass ram cavalry is unusable if a player
         cannot reliably buy a remount or replace lost barding. Routing an already-erebor item
         to erebor is a no-op for pool placement (CultureItemPoolService.BuildPools). -->
    <Item id="taom_war_ram_a" cultures="erebor" min_stock="1" />
    <Item id="taom_war_ram_b" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_light_a" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_light_b" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_med_a" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_med_b" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_heavy_a" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_heavy_b" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_elite_a" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_elite_b" cultures="erebor" min_stock="1" />

    <!-- The great elk and its saddle (#636), from the same Armory file, already
         culture="Culture.mirkwood" upstream. Here for min_stock, as the rams are: a Mirkwood town
         always has one to sell, and the saddle is the seat of the great elk and the Animalia elk and
         moose alike, not optional armour. -->
    <Item id="taom_elk_a" cultures="mirkwood" min_stock="1" />
    <Item id="taom_elk_saddle_a" cultures="mirkwood" min_stock="1" />
    <!-- The Animalia elk (#646), the elk_rider career's starting mount (Mike, 2026-09-23: "The starting
         elk should also be available in the marketplace"), so a player who loses it can buy the same
         one. Routing puts it in the Mirkwood pool, like any routed item, and min_stock guarantees a
         Mirkwood town always has one (the guaranteed-stock pass adds it by id, whatever its
         is_merchandise="false"). The Animalia moose (Mike, 2026-09-23: it may be sold) is routed the
         same way: with armour acquisition on, the daily draw refuses every item its XML marks
         non-merchandise, so the guaranteed stock is its route into the market (Mike, 2026-09-27).
         AnimaliaMountWiringTests pins the career start's mount and saddle here. -->
    <Item id="taom_animalia_elk_a" cultures="mirkwood" min_stock="1" />
    <Item id="taom_animalia_moose_a" cultures="mirkwood" min_stock="1" />
  </Routing>

</CultureMarketplaceConfig>
