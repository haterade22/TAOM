<?xml version="1.0" encoding="utf-8"?>
<!--
  Culture Marketplace overrides — optional.

  When this file is empty the engine auto-derives culture → items pools from MBObjectManager
  (group by ItemObject.Culture.StringId, with ID-prefix fallback for items missing the attribute).

  Three sections:

  1. <Culture id="..."> — per-culture blacklist / weight boost.
       <Blacklist><Item id="anduril" /></Blacklist>     keep specific items quest-only
       <Boost>   <Item id="..." weight="3.0" /></Boost> bias weighted-draw toward an item

  2. <Routing> — cross-culture item routing (top-level).
       <Item id="warg_brown" cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />
     Items listed here IGNORE their `Culture.X` attribute and ID-prefix fallback. They
     appear ONLY in the listed cultures' pools. Use this for items that culturally belong
     to a faction GROUP rather than a single culture — e.g., wargs are Isengard-tagged in
     the upstream XML but lore-correctly should appear in every "evil" culture's markets.

     Optional `min_stock="N"` (0–100) guarantees at least N units in each listed culture's
     town markets — the daily tick tops up if the roster count drops below the floor.
     min_stock injection BYPASSES PerTownTotalRosterCap (lore-essential items must always
     be available). Bad values (negative, non-integer, over ceiling) revert to 0 with warn.

  Weight validation: 0 <= weight <= 1000, finite (NaN / Infinity rejected). Bad values
  revert to 1.0 with a warning written to the TAOM log. Lifetime: provider is
  Reuse.Singleton; changes require a full Bannerlord restart, not a save reload.
-->
<CultureMarketplaceConfig>

  <Routing>
    <!-- Warg mounts from Alliance.Wargs/ModuleData/Items/LOTR/lotr_warg.xml are tagged
         Culture.isengard upstream but should appear in all four "evil" culture markets.
         min_stock="1" guarantees at least one of each variant + the saddle is always
         available in Isengard / Mordor / Gundabad / Dol Guldur towns. -->
    <Item id="warg_brown"  cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />
    <Item id="warg_dark"   cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />
    <Item id="warg_albino" cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />
    <Item id="warg_saddle" cultures="isengard,mordor,gundabad,dolguldur" min_stock="1" />

    <!-- Dwarven war rams and their bardings (#515), from
         LOTRLOME_Armory/ModuleData/LOTRLOME_items/LOTRAOM_horses.xml. Unlike the wargs above,
         all ten already carry culture="Culture.erebor" upstream, so the auto-derived pool
         would place them correctly on its own. These entries are here for min_stock: routing
         is the only way to guarantee a floor, and Ironpass ram cavalry is unusable if a player
         cannot reliably buy a remount or replace lost barding. Routing an already-erebor item
         to erebor is a no-op for pool placement (CultureItemPoolService.BuildPools). -->
    <Item id="taom_war_ram_a" cultures="erebor" min_stock="1" />
    <Item id="taom_war_ram_b" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_light_a" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_light_b" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_med_a" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_med_b" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_heavy_a" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_heavy_b" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_elite_a" cultures="erebor" min_stock="1" />
    <Item id="taom_ram_barding_elite_b" cultures="erebor" min_stock="1" />
  </Routing>

</CultureMarketplaceConfig>
