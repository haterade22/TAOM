    <Material culture="khuzait" item="taom_lords_material_khuzait" />
    <Material culture="aserai" item="taom_lords_material_aserai" />
    <Material culture="empire" item="taom_lords_material_empire" />
  </LordsMaterials>

  <LadderWeapons>
    <!-- The culture's named weapons (LOTRLOME_items/LOTRAOM_weapons.xml) -->
    <Weapon culture="gondor" item="anduril" />
    <Weapon culture="gondor" item="strider_sword" />
    <Weapon culture="gondor" item="glamdring_sword" />
    <Weapon culture="gondor" item="wm_gondor_boromir_sword" />
    <Weapon culture="gondor" item="wm_gondor_faramir_sword" />
    <Weapon culture="vlandia" item="theoden_sword" />
    <Weapon culture="vlandia" item="eomer_sword" />
    <Weapon culture="vlandia" item="eowyn_sword" />
    <Weapon culture="mordor" item="wm_sauron_mace" />
    <Weapon culture="mordor" item="witchking_sword" />
    <Weapon culture="mordor" item="nazgul_sword" />
    <Weapon culture="mirkwood" item="wm_legolas_sword" />
    <Weapon culture="mirkwood" item="wm_thranduil_sword" />
    <Weapon culture="erebor" item="sm_dwarf_dain_hammer_a" />
    <Weapon culture="erebor" item="sm_dwarf_dain_axe_a" />
    <Weapon culture="rivendell" item="wm_fingon_sword" />
    <Weapon culture="rivendell" item="wm_turin_sword" />
