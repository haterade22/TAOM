    <Item id="glamdring_sword" />
    <Item id="eomer_sword" />
    <Item id="eowyn_sword" />
    <Item id="witchking_sword" />
    <Item id="nazgul_sword" />
    <Item id="wm_gondor_boromir_sword" />
    <Item id="wm_gondor_faramir_sword" />
    <Item id="wm_legolas_sword" />
    <Item id="wm_thranduil_sword" />
    <Item id="sm_dwarf_dain_hammer_a" />
    <Item id="sm_dwarf_dain_axe_a" />
    <!-- Named 2026-09-28 (Mike): Tuor's heirloom axes, Galadriel's sword and the seven Noldor swords -->
    <Item id="wm_tuors_axe_1h" />
    <Item id="wm_tuors_axe" />
    <Item id="wm_galadriel_sword" />
    <Item id="wm_fingon_sword" />
    <Item id="wm_turin_sword" />
    <Item id="wm_celegorm_sword" />
    <Item id="wm_finwe_sword" />
    <Item id="wm_ingwe_sword" />
    <Item id="wm_finarin_sword" />
    <Item id="wm_voronwe_sword" />
    <!-- LOTRLOME_Armory LOTRLOME_items/LOTRAOM_shields.xml -->
    <Item id="wm_boromir_shield" />
    <Item id="wm_theoden_shield" />
  </NamedWeapons>

  <LordEvent chance="0.08" cooldown_days="90" leave_relation="5" />
  <VisitingArmourer chance_per_day="0.04" duration_days="7" level_bonus="1" />

  <!-- Mike's placeholder numbers (#693, 2026-09-28), to tune in play. -->
  <LordsLadder count_knockouts="true">
    <Step slot="hands" quest="taom_lords_gear_hands" materials="10" />
    <Step slot="legs" quest="taom_lords_gear_legs" materials="15" />
    <Step slot="shoulders" quest="taom_lords_gear_shoulders" materials="20" />
    <Step slot="head" quest="taom_lords_gear_head" materials="30" />
    <Step slot="body" quest="taom_lords_gear_body" materials="40" />
    <Step slot="weapon" quest="taom_lords_gear_weapon" materials="60" />
  </LordsLadder>

  <LordsMaterials base_chance="0.1" chance_per_ten_kills="0.01" max_chance="0.6" min_units="1" max_units="3">
    <Material culture="gondor" item="taom_lords_material_gondor" />
    <Material culture="vlandia" item="taom_lords_material_vlandia" />
    <Material culture="erebor" item="taom_lords_material_erebor" />
    <Material culture="sturgia" item="taom_lords_material_sturgia" />
    <Material culture="rivendell" item="taom_lords_material_rivendell" />
    <Material culture="mirkwood" item="taom_lords_material_mirkwood" />
    <Material culture="mordor" item="taom_lords_material_mordor" />
    <Material culture="isengard" item="taom_lords_material_isengard" />
    <Material culture="dolguldur" item="taom_lords_material_dolguldur" />
