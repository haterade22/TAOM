	<string id="taom_enlist_duty_recruitment_errand_title" text="{=taom_enlist_duty_recruitment_errand_title}a recruiting errand" />
	<string id="taom_enlist_duty_relief_dispatch_title" text="{=taom_enlist_duty_relief_dispatch_title}to carry word to a hard-pressed fief" />
	<string id="taom_enlist_duty_road_patrol_title" text="{=taom_enlist_duty_road_patrol_title}a road patrol" />
	<string id="taom_enlist_duty_scout_route_title" text="{=taom_enlist_duty_scout_route_title}to scout the road ahead" />
