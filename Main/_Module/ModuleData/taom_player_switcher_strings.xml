<?xml version="1.0" encoding="utf-8"?>
<strings>

	<!-- Player Switcher (#514). Player-facing text for the character creation hero picker. -->

	<string id="taom_ps_title" text="{=taom_ps_title}Play as an existing lord" />
	<string id="taom_ps_hint" text="{=taom_ps_hint}Pick a lord to take their place. You keep their face, gear, skills, clan and kingdom. The character you build is set aside." />

	<!-- Group headers. These match the three lists the picker renders. -->
	<string id="taom_ps_group_kingdom" text="{=taom_ps_group_kingdom}Royal House" />
	<string id="taom_ps_group_clans" text="{=taom_ps_group_clans}Clan Leaders" />
	<string id="taom_ps_group_wanderers" text="{=taom_ps_group_wanderers}Wanderers" />

	<!-- Shown after a group header when that group has nobody in it. Only 20 of 39 cultures
	     have wanderers, so an empty group is ordinary rather than a fault. -->
	<string id="taom_ps_none" text="{=taom_ps_none}none" />

	<string id="taom_ps_clear" text="{=taom_ps_clear}Play as my own character" />
	<string id="taom_ps_selected" text="{=taom_ps_selected}Selected: {HERO}" />

	<string id="taom_ps_switched" text="{=taom_ps_switched}You now play as {HERO} of {CLAN}." />
	<string id="taom_ps_failed" text="{=taom_ps_failed}You could not take the place of {HERO}. Continuing as your own character." />
	<string id="taom_ps_unavailable" text="{=taom_ps_unavailable}The player switcher could not start and is disabled for this session." />

</strings>
