<?xml version="1.0" encoding="utf-8"?>
<strings>

	<!-- Player Switcher (#514). Player-facing text for the character creation hero picker.
	     Every key here is rendered by C# or by the picker prefab; a key with no consumer is a
	     translated dead weight and, usually, the fossil of a step that was specified and never built. -->


	<!-- Group headers. These match the three lists the picker renders. -->
	<string id="taom_ps_group_kingdom" text="{=taom_ps_group_kingdom}Royal House" />
	<string id="taom_ps_group_clans" text="{=taom_ps_group_clans}Clan Leaders" />
	<string id="taom_ps_group_wanderers" text="{=taom_ps_group_wanderers}Wanderers" />

	<!-- Shown after a group header when that group has nobody in it. Only 20 of 39 cultures
	     have wanderers, so an empty group is ordinary rather than a fault. -->
	<string id="taom_ps_none" text="{=taom_ps_none}none" />


	<string id="taom_ps_switched" text="{=taom_ps_switched}You now play as {HERO}." />
	<string id="taom_ps_partial" text="{=taom_ps_partial}You are now {HERO}, but part of the handover did not finish. See the log." />
	<string id="taom_ps_failed" text="{=taom_ps_failed}You could not take the place of {HERO}. Continuing as your own character." />
	<string id="taom_ps_unavailable" text="{=taom_ps_unavailable}The player switcher could not start and is disabled for this session." />

	<!-- Kingdom-join offer, raised once after an adoption. The takeover path never sees this,
	     because a taken-over lord already belongs to their clan's kingdom. -->
	<string id="taom_ps_join_title" text="{=taom_ps_join_title}Swear to a king?" />
	<string id="taom_ps_join_body" text="{=taom_ps_join_body}Your clan stands alone. {KINGDOM} would take your oath and your banner. Join them now?" />
	<string id="taom_ps_join_yes" text="{=taom_ps_join_yes}Swear the oath" />
	<string id="taom_ps_join_no" text="{=taom_ps_join_no}Stay independent" />

</strings>
