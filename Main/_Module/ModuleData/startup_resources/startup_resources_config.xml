<?xml version="1.0" encoding="utf-8"?>
<!--
  StartupResources config — values applied at new-game start.

  Attributes:
    gold        = denars granted to each alive Lord hero of this culture at new-game start
                  (player clan is skipped; see playerGold for the player). Default 0.
    influence   = influence granted to each eligible CLAN of this culture at new-game start
                  (StartupInfluenceService applies to clans, not lords). Default 0.
    playerGold  = denars granted to the PLAYER hero at CC finalize, by selected culture.
                  Range [0, 10_000_000]. Out-of-range or non-numeric values revert to 0
                  with a logged warning. Default 0 (no warning when missing).

  Edits to this file take effect on the next Bannerlord process restart, not save reload.
-->
<StartupResources>
  <!-- Elven cultures -->
  <Culture id="rivendell"   gold="600000" influence="1250" playerGold="4000"  />
  <Culture id="lothlorien"  gold="600000" influence="1250" playerGold="4000"  />
  <Culture id="mirkwood"    gold="600000" influence="1250" playerGold="4000"  />

  <!-- Dwarven cultures -->
  <Culture id="erebor"      gold="800000" influence="1000" playerGold="3500"  />

  <!-- Human Good cultures -->
  <Culture id="gondor"      gold="100000" influence="1000" playerGold="2000"  />
  <Culture id="vlandia"     gold="50000"  influence="50"   playerGold="2000"  />
  <Culture id="sturgia"     gold="50000"  influence="50"   playerGold="2000"  />

  <!-- Human Evil / Eastern cultures -->
  <Culture id="empire"      gold="50000"  influence="100"  playerGold="2000"  />
  <Culture id="battania"    gold="50000"  influence="100"  playerGold="2000"  />
  <Culture id="aserai"      gold="50000"  influence="100"  playerGold="2000"  />
  <Culture id="khuzait"     gold="75000"  influence="1000" playerGold="2000"  />

  <!-- Independent Harad-region kingdoms (full kingdoms with NPC clans + lords; Shaghana 9 lords, Abanissa 8 lords) -->
  <!-- Both cultures are now fully playable in character creation (the issue-#111 narrative-menu
       coverage has landed), so their `playerGold` rows below are live. -->
  <Culture id="shaghana"    gold="50000"  influence="100"  playerGold="2000"  />
  <Culture id="abanissa"    gold="50000"  influence="100"  playerGold="2000"  />

  <!-- Orcish / Dark cultures -->
  <Culture id="mordor"      gold="50000"  influence="500"  playerGold="2000"  />
  <Culture id="isengard"    gold="75000"  influence="500"  playerGold="2000"  />
  <Culture id="gundabad"    gold="75000"  influence="1000" playerGold="2000"  />
  <Culture id="dolguldur"   gold="75000"  influence="500"  playerGold="2000"  />
  <Culture id="umbar"       gold="200000" influence="1000" playerGold="2000"  />

  <!-- Goblin-town and the Moria orcs. Both shipped CC-selectable in June 2026 with no row here at
       all, so every player who picked one started on 0 denars — and because a missing culture is
       documented above as a silent default of 0, nothing logged it. Sized against their nearest
       peers: Goblin-town is a scavenging mountain kingdom (5 clans), Moria is the larger power
       (15 clans, 33 fiefs), so it sits level with Gundabad rather than below it. -->
  <Culture id="goblin"             gold="50000"  influence="500"  playerGold="2000"  />
  <Culture id="mistymountainorcs"  gold="75000"  influence="1000" playerGold="2000"  />

  <!-- Promoted out of a borrowed culture 2026-08-10: Blue Craig off goblin, Lindon off rivendell.
       Each now needs its own row — before the split they inherited nothing, because these values
       are keyed on culture and their kingdoms had none of their own. Blue Craig is the smaller of
       the two goblin realms (5 clans, 1 town); Lindon is an old elven realm with a single great
       haven, so it sits below Rivendell's treasury but keeps elven influence. -->
  <Culture id="bluecraig"          gold="40000"  influence="400"  playerGold="2000"  />
  <Culture id="lindon"             gold="500000" influence="1250" playerGold="4000"  />
</StartupResources>
