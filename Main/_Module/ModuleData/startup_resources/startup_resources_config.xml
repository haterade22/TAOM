<?xml version="1.0" encoding="utf-8"?>
<!--
  StartupResources config — values applied at new-game start.

  Attributes:
    gold        = denars granted to each alive Lord hero of this culture at new-game start
                  (player clan is skipped; see playerGold for the player). Default 0.
    influence   = influence granted to each eligible CLAN of this culture at new-game start
                  (StartupInfluenceService applies to clans, not lords). Default 0.
    playerGold  = denars granted to the PLAYER hero at CC finalize, by selected culture.
                  Range [0, 10_000_000]. Out-of-range or non-numeric values revert to 0
                  with a logged warning. Default 0 (no warning when missing).

  Edits to this file take effect on the next Bannerlord process restart, not save reload.

  Flattened 2026-08-14 on a standing balance decision: every culture starts its clans on the
  same 1,000 influence and its lords on the same 250,000 denars, so no faction opens the
  campaign with a structural economic head start. The elven realms are the single exception
  at 500,000, keeping the "old, wealthy, few" character they had before the flattening.

  Worth knowing before retuning. Erebor is the one large move DOWN, from 800,000, where it had
  been the richest culture on the map by a factor of four. Everything else moved UP or stayed
  level: Blue Craig from 40,000 and vlandia (Rohan) and sturgia (Dale) from 50,000 gold and 50
  influence, a twentyfold influence jump; Umbar from 200,000. The elven realms came down from
  600,000 to the 500,000 exception. playerGold was deliberately NOT flattened and still varies
  by culture.
-->
<StartupResources>
  <!-- Elven cultures — the one exception to the flat 250,000 -->
  <Culture id="rivendell"   gold="500000" influence="1000" playerGold="4000"  />
  <Culture id="lothlorien"  gold="500000" influence="1000" playerGold="4000"  />
  <Culture id="mirkwood"    gold="500000" influence="1000" playerGold="4000"  />
  <Culture id="lindon"      gold="500000" influence="1000" playerGold="4000"  />

  <!-- Dwarven cultures -->
  <Culture id="erebor"      gold="250000" influence="1000" playerGold="3500"  />

  <!-- Human Good cultures -->
  <Culture id="gondor"      gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="vlandia"     gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="sturgia"     gold="250000" influence="1000" playerGold="2000"  />

  <!-- Human Evil / Eastern cultures -->
  <Culture id="empire"      gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="battania"    gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="aserai"      gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="khuzait"     gold="250000" influence="1000" playerGold="2000"  />

  <!-- Independent Harad-region kingdoms (full kingdoms with NPC clans + lords; Shaghana 9 lords, Abanissa 8 lords) -->
  <!-- Both cultures are now fully playable in character creation (the issue-#111 narrative-menu
       coverage has landed), so their `playerGold` rows below are live. -->
  <Culture id="shaghana"    gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="abanissa"    gold="250000" influence="1000" playerGold="2000"  />

  <!-- Orcish / Dark cultures -->
  <Culture id="mordor"      gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="isengard"    gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="gundabad"    gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="dolguldur"   gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="umbar"       gold="250000" influence="1000" playerGold="2000"  />

  <!-- Goblin-town and the Moria orcs. Both shipped CC-selectable in June 2026 with no row here at
       all, so every player who picked one started on 0 denars — and because a missing culture is
       documented above as a silent default of 0, nothing logged it. -->
  <Culture id="goblin"             gold="250000" influence="1000" playerGold="2000"  />
  <Culture id="mistymountainorcs"  gold="250000" influence="1000" playerGold="2000"  />

  <!-- Promoted out of a borrowed culture 2026-08-10: Blue Craig off goblin, Lindon off rivendell.
       Each needs its own row: before the split they inherited nothing, because these values are
       keyed on culture and their kingdoms had none of their own. Lindon sits with the other
       elven realms above. -->
  <Culture id="bluecraig"          gold="250000" influence="1000" playerGold="2000"  />
</StartupResources>
