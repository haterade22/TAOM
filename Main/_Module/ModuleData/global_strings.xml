<?xml version="1.0" encoding="utf-8"?>
<strings>

	<!-- Time-control keybinding names for Options > Keybindings > Campaign Map.
	     This file MUST be named global_strings.xml and live at ModuleData/ root. The keybinding
	     screen reads Module.CurrentModule.GlobalTextManager (GameKeyOptionVM.RefreshValues), and
	     GlobalTextManager.LoadDefaultTexts() populates that manager by scanning every module for the
	     LITERAL path ModuleData/global_strings.xml. It does NOT read <XmlNode id="GameText"> entries
	     from SubModule.xml, which feed the separate per-Game GameTextManager instead. Native ships
	     the vanilla and NavalDLC key names in its own global_strings.xml for exactly this reason.
	     The trailing numbers are the game key ids: KeyOptionVM builds the lookup from
	     ((GameKeyDefinition)Id).ToString(), not from StringId. Keep them in step with
	     TaomTimeControlHotKeyCategory. -->
	<string id="str_key_name.TaomTimeControlHotKeyCategory_500" text="{=taom_key_fast_forward}Fast Forward (TAOM)" />
	<string id="str_key_description.TaomTimeControlHotKeyCategory_500" text="{=taom_key_fast_forward_desc}Applies the TAOM fast-forward speed multiplier. Shares a key with the vanilla pause toggle by default, which is deliberate." />
	<string id="str_key_name.TaomTimeControlHotKeyCategory_501" text="{=taom_key_extra_fast_forward}Extra Fast Forward (TAOM)" />
	<string id="str_key_description.TaomTimeControlHotKeyCategory_501" text="{=taom_key_extra_fast_forward_desc}Applies the higher TAOM fast-forward multiplier. Defaults to E, which is also Rotate Camera Right; rebind either one to stop them firing together." />
	<string id="str_key_name.TaomTimeControlHotKeyCategory_502" text="{=taom_key_turbo}Turbo Time, hold Ctrl (TAOM)" />
	<string id="str_key_description.TaomTimeControlHotKeyCategory_502" text="{=taom_key_turbo_desc}Hold Ctrl together with this key for the highest TAOM speed multiplier. Releasing either key restores the previous speed." />

	<!-- Career ability activation, shown under Options > Keybindings > Action because the key is
	     pressed in a mission rather than on the campaign map. Same numbering rule as above: the
	     trailing number is the game key id, kept in step with TaomCareerHotKeyCategory. -->
	<string id="str_key_name.TaomCareerHotKeyCategory_510" text="{=taom_key_career_ability}Career Ability (TAOM)" />
	<string id="str_key_description.TaomCareerHotKeyCategory_510" text="{=taom_key_career_ability_desc}Activates your career ability during a battle once its energy bar is full. Defaults to V." />

	<!-- Seat of Seeing (docs/features/seat-of-seeing.md), under Options > Keybindings > Action because the key is pressed in a
	     mission. Same numbering rule as above: the trailing number is the game key id, kept in step with
	     TaomSeatHotKeyCategory. -->
	<string id="str_key_name.TaomSeatHotKeyCategory_530" text="{=taom_key_seat_take}Take the Seat (TAOM)" />
	<string id="str_key_description.TaomSeatHotKeyCategory_530" text="{=taom_key_seat_take_desc}Lifts your view off your hero so you can fly over the field, and brings it back with a short glide. Your hero stands fast while you are up, or fights on if that setting is on. Defaults to Q." />
	<string id="str_key_name.TaomSeatHotKeyCategory_531" text="{=taom_key_seat_keep}Keep to this soldier or company (TAOM)" />
	<string id="str_key_description.TaomSeatHotKeyCategory_531" text="{=taom_key_seat_keep_desc}In the Seat, keeps the view on the soldier at the middle of the screen, or under the cursor while one shows, or on the company you have selected in the order panel, and orbits it. Press it again, or fly, to let go. Defaults to Insert." />
	<string id="str_key_name.TaomSeatHotKeyCategory_532" text="{=taom_key_seat_take_soldier}Take this soldier (TAOM)" />
	<string id="str_key_description.TaomSeatHotKeyCategory_532" text="{=taom_key_seat_take_soldier_desc}In the Seat, after your hero has fallen in a battle, takes the soldier at the middle of the screen, or the nearest one of the company you keep to, who then carries your orders. Defaults to Delete." />
	<string id="str_key_name.TaomSeatHotKeyCategory_533" text="{=taom_key_seat_quicken}Quicken time (TAOM)" />
	<string id="str_key_description.TaomSeatHotKeyCategory_533" text="{=taom_key_seat_quicken_desc}In a battle, steps mission time up one level: 0.25, 0.5, 1, 2, 4 and 10. Level 10 needs the Seat up or nobody left for you to fight as. It works from the Seat or from your hero's eyes, in single player only. Defaults to Page Up." />
	<string id="str_key_name.TaomSeatHotKeyCategory_534" text="{=taom_key_seat_slow}Slow time (TAOM)" />
	<string id="str_key_description.TaomSeatHotKeyCategory_534" text="{=taom_key_seat_slow_desc}In a battle, steps mission time down one level, to a quarter of normal speed at the lowest. Defaults to Page Down." />
	<string id="str_key_name.TaomSeatHotKeyCategory_535" text="{=taom_key_seat_stay}Stay time (TAOM)" />
	<string id="str_key_description.TaomSeatHotKeyCategory_535" text="{=taom_key_seat_stay_desc}In a battle, cancels fast time and pauses the mission; press it again to go on. The Seat's view still flies while the battle is paused. Defaults to Home." />
	<string id="str_key_name.TaomSeatHotKeyCategory_536" text="{=taom_key_seat_hide}Hide the interface (TAOM)" />
	<string id="str_key_description.TaomSeatHotKeyCategory_536" text="{=taom_key_seat_hide_desc}In the Seat, hides the whole interface for a clean view. Press it again to bring the interface back; it also comes back when you open the order panel. Defaults to End." />

	<!-- Marshal's Word (docs/features/marshals-word.md), under Options > Keybindings > Action because the keys are used in a
	     mission. Same numbering rule as above: the trailing number is the game key id, kept in step with
	     TaomMarshalHotKeyCategory. -->
	<string id="str_key_name.TaomMarshalHotKeyCategory_540" text="{=taom_key_marshal_queue}Give the Order in Turn (TAOM)" />
	<string id="str_key_description.TaomMarshalHotKeyCategory_540" text="{=taom_key_marshal_queue_desc}Hold while you give an order with the order panel open, and the company carries it out after its current orders. Defaults to Left Shift." />
	<string id="str_key_name.TaomMarshalHotKeyCategory_541" text="{=taom_key_marshal_mark}Mark, Do Not Move (TAOM)" />
	<string id="str_key_description.TaomMarshalHotKeyCategory_541" text="{=taom_key_marshal_mark_desc}Hold while you order a charge on an enemy company with the order panel open, and your company marks it as its target and keeps its own movement order. A mark steers archers and other ranged soldiers; soldiers fighting hand to hand choose their own foe. Defaults to Left Ctrl." />
	<string id="str_key_name.TaomMarshalHotKeyCategory_542" text="{=taom_key_marshal_widths}Keep the Widths (TAOM)" />
	<string id="str_key_description.TaomMarshalHotKeyCategory_542" text="{=taom_key_marshal_widths_desc}Hold while you drag a line for several companies with the order panel open, and they turn as one body without stretching. Defaults to Left Alt." />
	<string id="str_key_name.TaomMarshalHotKeyCategory_543" text="{=taom_key_marshal_fire}Change the Archers' Fire (TAOM)" />
	<string id="str_key_description.TaomMarshalHotKeyCategory_543" text="{=taom_key_marshal_fire_desc}Press with a company selected to switch its archers between firing at will, drawing their bows to hold until your word (or for 14 seconds at most), and drawing and holding until most of them are ready, when the word is given for you. Defaults to Comma." />
	<string id="str_key_name.TaomMarshalHotKeyCategory_544" text="{=taom_key_marshal_word}Give the Word (TAOM)" />
	<string id="str_key_description.TaomMarshalHotKeyCategory_544" text="{=taom_key_marshal_word_desc}Press with a company selected, and its archers who hold a drawn bow loose together. Defaults to M." />
	<string id="str_key_name.TaomMarshalHotKeyCategory_545" text="{=taom_key_marshal_hold}Hold the Line (TAOM)" />
	<string id="str_key_description.TaomMarshalHotKeyCategory_545" text="{=taom_key_marshal_hold_desc}Press with a company selected: its shielded foot soldiers in a shield wall, circle or square stop attacking and keep their places, and strike back for a few seconds when wounded. A charge, a retreat or a second press lets them fight. Defaults to Period." />

	<!-- Realm Borders (#698), under Options > Keybindings > Campaign Map. Same numbering rule as
	     above: the trailing number is the game key id, kept in step with
	     TaomRealmBordersHotKeyCategory. -->
	<string id="str_key_name.TaomRealmBordersHotKeyCategory_520" text="{=taom_key_realm_borders}Show Realm Borders (TAOM)" />
	<string id="str_key_description.TaomRealmBordersHotKeyCategory_520" text="{=taom_key_realm_borders_desc}Shows or hides the realm borders and the realm names on the campaign map. Defaults to M." />
	<string id="str_key_name.TaomRealmBordersHotKeyCategory_521" text="{=taom_key_realm_borders_mode}Realm Borders Map Mode (TAOM)" />
	<string id="str_key_description.TaomRealmBordersHotKeyCategory_521" text="{=taom_key_realm_borders_mode_desc}Switches the realm borders between the realms, the Free Peoples against the Shadow, and your allies and enemies. Defaults to G." />

	<!-- Cheat Menu, under Options > Keybindings > Campaign Map. Same numbering rule as above:
	     the trailing number is the game key id, kept in step with TaomCheatMenuHotKeyCategory. -->
	<string id="str_key_name.TaomCheatMenuHotKeyCategory_550" text="{=taom_key_cheat_menu}Open Cheat Menu (TAOM)" />
	<string id="str_key_description.TaomCheatMenuHotKeyCategory_550" text="{=taom_key_cheat_menu_desc}Opens the TAOM cheat menu on the campaign map, like the Cheats button. Works only while Enable Cheat Menu is on in Mod Options, in single player. Defaults to H." />
	<string id="str_key_name.TaomCheatMenuHotKeyCategory_551" text="{=taom_key_battle_cheat_menu}Open Battle Cheat Menu (TAOM)" />
	<string id="str_key_description.TaomCheatMenuHotKeyCategory_551" text="{=taom_key_battle_cheat_menu_desc}Opens the TAOM battle cheat list in a mission, like the Cheats item in the Esc menu. Works only while Enable Cheat Menu is on in Mod Options, in single player. Defaults to H." />

	<!-- Advanced Starting Options (v1.5.x main-menu screen), the MENU half (#604).
	     Same contract as the keybinding rows above: the ASO screen runs before any campaign
	     exists and every lookup it makes (option names, list items, the {LastStandKingdomId}
	     interpolation) goes through Module.CurrentModule.GlobalTextManager, which reads THIS
	     file and nothing else. These rows sat in taom_module_strings.xml for a while and the
	     screen showed "ERROR: Text with id str_campaign_starting_options_item_name doesn't
	     exist! Variation: rivendell" for every TAOM kingdom.

	     Being in this file is necessary but not sufficient for the rows that reuse a VANILLA
	     variation id (the eight renamed kingdoms and the four Calradia rewrites below): the
	     loader appends a same-id row behind Native's and the lookup is a first-match scan, so
	     Native's "Sturgia" would still win. No XSLT runs on this path either. SubModule.cs
	     re-applies every row of this file through GameText.SetVariationWithId at load
	     (GlobalStringsOverrides), which replaces Native's entry in place.

	     The in-game half, str_advanced_start_value_name.<id> (Escape-menu summary), stays in
	     taom_module_strings.xml: that reader uses the per-Game manager, which merges GameText
	     XMLs by id. TaomStartOptionsProviderTests pins both placements. -->
