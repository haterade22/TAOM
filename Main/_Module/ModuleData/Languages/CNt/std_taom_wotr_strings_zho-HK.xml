<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema"
      type="string">
  <tags>
    <tag language="Traditional Chinese" />
  </tags>
  <strings>
    <string id="taom_wotr_title" text="魔戒大戰" />
    <string id="taom_wotr_leaders" text="領袖" />
    <string id="taom_wotr_allies" text="盟友" />
    <string id="taom_wotr_breakdown_header" text="戰局優勢明細" />
    <string id="taom_wotr_total_stats_header" text="戰果總計" />
    <string id="taom_wotr_total" text="總計：{MOMENTUM}" />
    <string id="taom_wotr_battles_won" text="獲勝場次" />
    <string id="taom_wotr_villages_raided" text="劫掠村莊數" />
    <string id="taom_wotr_fiefs_captured" text="攻佔封地數" />
    <string id="taom_wotr_army_gathered" text="集結軍團數" />
    <string id="taom_wotr_relative_strength" text="相對實力" />
    <string id="taom_wotr_enemies_killed" text="殺敵數" />
    <string id="taom_wotr_settlements_captured" text="攻佔聚落數" />
    <string id="taom_wotr_momentum" text="戰局優勢" />
    <string id="taom_wotr_desc_battle" text="{WINNER_LEADER}率領的{WINNER_FACTION}軍團擊潰了{LOSER_LEADER}率領的{LOSER_FACTION}軍團，殺敵{CASUALTIES}人。" />
    <string id="taom_wotr_desc_siege" text="{LEADER}率領的{FACTION}軍團攻佔了{SETTLEMENT}。" />
    <string id="taom_wotr_desc_raid" text="{FACTION}的{PARTY}劫掠了{SETTLEMENT}村。" />
    <string id="taom_wotr_desc_army" text="{LEADER}率領的軍團已經集結。" />
    <string id="taom_wotr_desc_strength" text="我方實力比敵人高出{PERCENTAGE}%！" />
    <string id="taom_wotr_desc_kills" text="我軍在戰鬥中擊殺了{CASUALTIES}名敵人。" />
    <string id="taom_wotr_victory_title" text="戰爭結束" />
    <string id="taom_wotr_victory_free" text="戰爭結束了。自由人民堅持到底，爲子孫贏得了未來。自由萬歲！" />
    <string id="taom_wotr_victory_evil" text="人類與精靈的國度都已覆滅。索隆萬歲！" />
    <string id="taom_wotr_continue" text="繼續" />
    <string id="taom_wotr_chronicle_events" text="戰事紀要" />
    <string id="taom_wc_siege_lost" text="戰鬥尚未分出勝負，{TARGET}便已易手。" />
    <string id="taom_wc_fellowship_title" text="遠征隊啟程" />
    <string id="taom_wc_fellowship_occurred" text="九名行者秘密離開幽谷，帶著至尊魔戒南行。埃爾隆德家族正在聚集力量。" />
    <string id="taom_wc_khazaddum_title" text="凱薩督姆之橋" />
    <string id="taom_wc_khazaddum_occurred" text="在摩瑞亞深處，灰袍朝聖者與炎魔一同墜落。迷霧山脈的半獸人蜂擁而出，自由人民為之哀悼。" />
    <string id="taom_wc_breaking_title" text="遠征隊的分裂" />
    <string id="taom_wc_breaking_occurred" text="在帕斯加蘭，烏魯克撲向遠征隊。波洛米爾為保護哈比人而死，剛鐸失去了它的繼承人。" />
    <string id="taom_wc_theoden_title" text="希奧頓王" />
    <string id="taom_wc_theoden_occurred" text="擺脫了巧言的讒言，希奧頓重新執起寶劍。裏德馬克向它的國王集結。" />
    <string id="taom_wc_hornburg_title" text="號角堡之戰" />
    <string id="taom_wc_hornburg_open" text="艾森加德的大軍與黑蠻地的山民向{TARGET}進發。此戰必須在{DAYS}天內分出勝負。" />
    <string id="taom_wc_hornburg_lapsed" text="{TARGET}並未遭到進攻。艾森加德的兵馬轉向了別處。" />
    <string id="taom_wc_hornburg_held" text="號角堡徹夜堅守，艾森加德的大軍在城牆前崩潰。" />
    <string id="taom_wc_hornburg_fell" text="{TARGET}陷落，白手統治了西伏爾德。" />
    <string id="taom_wc_ents_title" text="樹人的最後行軍" />
    <string id="taom_wc_ents_occurred" text="范貢森林的樹人衝下艾森加德，淹沒了薩茹曼的深坑。白手的鍛爐歸於沉寂。" />
    <string id="taom_wc_lorien_title" text="洛絲羅瑞恩遭襲" />
    <string id="taom_wc_lorien_open" text="黑影自多古爾都而出，攻打金色森林。{TARGET}必須堅守{DAYS}天。" />
    <string id="taom_wc_lorien_lapsed" text="多古爾都的大軍始終未能抵達{TARGET}。" />
    <string id="taom_wc_lorien_held" text="夫人的力量堅守不墜，多古爾都的大軍自金色森林退卻。" />
    <string id="taom_wc_lorien_fell" text="{TARGET}陷入火海，洛絲羅瑞恩的光輝日漸黯淡。" />
    <string id="taom_wc_osgiliath_title" text="歐斯吉利亞斯的陷落" />
    <string id="taom_wc_osgiliath_open" text="魔窟大軍渡過安都因河，直撲{TARGET}。剛鐸必須守住這座廢城{DAYS}天。" />
    <string id="taom_wc_osgiliath_lapsed" text="魔多並未進犯{TARGET}，河面依舊平靜。" />
    <string id="taom_wc_osgiliath_held" text="法拉米爾守住了安都因河的渡口，魔窟大軍退了回去。" />
    <string id="taom_wc_osgiliath_fell" text="{TARGET}陷落，通往米那斯提力斯的道路就此敞開。" />
    <string id="taom_wc_dale_title" text="河谷邦之戰" />
    <string id="taom_wc_dale_open" text="東夷與多古爾都僕從向河谷邦的疆域進軍。{TARGET}必須堅守{DAYS}天。" />
    <string id="taom_wc_dale_lapsed" text="東夷轉道而去，{TARGET}得以倖免。" />
    <string id="taom_wc_dale_held" text="河谷邦的人類與孤山矮人並肩而立，東夷大軍被擊退了。" />
    <string id="taom_wc_dale_fell" text="{TARGET}落入東夷之手，孤山矮人出兵馳援他們的朋友。" />
    <string id="taom_wc_corsairs_title" text="烏姆巴爾的海盜" />
    <string id="taom_wc_corsairs_open" text="烏姆巴爾的黑帆沿安都因河而上，直撲{TARGET}。剛鐸必須守住這座港口{DAYS}天。" />
    <string id="taom_wc_corsairs_lapsed" text="海盜滯留海上，{TARGET}得以平安無事。" />
    <string id="taom_wc_corsairs_held" text="烏姆巴爾的艦隊被逐出{TARGET}，剛鐸南方的封地士氣大振。" />
    <string id="taom_wc_corsairs_fell" text="海盜奪取了{TARGET}，他們的船隻控制了河道。" />
    <string id="taom_wc_north_title" text="北方的戰爭" />
    <string id="taom_wc_north_open" text="貢達巴德的奧克與黑蠻地的山民南下進犯北方。{TARGET}必須堅守{DAYS}天。" />
    <string id="taom_wc_north_lapsed" text="北方的戰火並未波及{TARGET}。" />
    <string id="taom_wc_north_held" text="遊民與阿塞丹的人們守住了{TARGET}，北方依舊自由。" />
    <string id="taom_wc_north_fell" text="{TARGET}陷落了，陰影蔓延至整個埃利阿多。" />
    <string id="taom_wc_gondor_title" text="剛鐸之圍" />
    <string id="taom_wc_gondor_open" text="那茲古爾之王率領魔多大軍進攻{TARGET}。這座城必須堅守{DAYS}天。" />
    <string id="taom_wc_gondor_lapsed" text="魔多的大軍按兵不動，{TARGET}在陰暗的天空下等待着。" />
    <string id="taom_wc_gondor_held" text="洛希爾人在黎明時分趕到，{TARGET}之圍在佩蘭諾平原上被解除了。" />
    <string id="taom_wc_gondor_fell" text="{TARGET}的城門被攻破，白城落入魔多之手。" />
    <string id="taom_wc_blackgate_title" text="黑門開啟" />
    <string id="taom_wc_blackgate_occurred" text="西方的將領們進軍魔拉南，要將那隻眼從魔戒持有者身上引開。戰爭的命運如今繫於魔戒之上。" />
    <string id="taom_wc_hornburg_fate" text="艾森加德的大軍徹夜猛攻{TARGET}，黎明時號角堡依然屹立。" />
    <string id="taom_event_category_chronicle" text="戰爭紀事" />
    <string id="taom_event_category_coronation" text="加冕" />
    <string id="taom_event_effects" text="效果" />
    <string id="taom_event_effect_days" text="持續{DAYS}天" />
    <string id="taom_event_side_free" text="自由人民" />
    <string id="taom_event_side_evil" text="陰影" />
    <string id="taom_event_effect_volunteers" text="志願兵徵募率" />
    <string id="taom_event_effect_escape" text="額外逃脫判定" />
    <string id="taom_event_effect_momentum" text="魔戒大戰局勢" />
    <string id="taom_event_effect_note" text="此處數值為本事件在上限之前的貢獻，且上限即使對單一效果也同樣適用。你自己氏族的封地與領主永遠不受影響。" />
    <string id="taom_event_effect_escape_note" text="額外逃脫判定的概率，為所示百分比乘以領主通常的逃脫概率。" />
    <string id="taom_wc_breaking_averted" text="At Parth Galen the Uruk-hai are thrown back. Boromir lives, and Gondor keeps its Captain-General." />
    <string id="taom_wc_hornburg_repulsed" text="The assault on {TARGET} breaks. Sauron is angry that Saruman's greed spoiled his plan, and Mordor ends its alliance with Isengard." />
  </strings>
</base>
