<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema"
      type="string">
  <tags>
    <tag language="Traditional Chinese" />
  </tags>
  <strings>
    <string id="taom_wotr_title" text="魔戒聖戰" />
    <string id="taom_wotr_leaders" text="領袖" />
    <string id="taom_wotr_allies" text="盟友" />
    <string id="taom_wotr_breakdown_header" text="聲勢明細" />
    <string id="taom_wotr_total_stats_header" text="總體數據" />
    <string id="taom_wotr_total" text="總計：{MOMENTUM}" />
    <string id="taom_wotr_battles_won" text="已勝戰役" />
    <string id="taom_wotr_villages_raided" text="已劫掠村莊" />
    <string id="taom_wotr_fiefs_captured" text="已奪取封地" />
    <string id="taom_wotr_army_gathered" text="已集結軍隊" />
    <string id="taom_wotr_relative_strength" text="相對實力" />
    <string id="taom_wotr_enemies_killed" text="已殺敵人" />
    <string id="taom_wotr_settlements_captured" text="已奪取定居點" />
    <string id="taom_wotr_momentum" text="聲勢" />
    <string id="taom_wotr_desc_battle" text="{WINNER_FACTION}的軍隊在{WINNER_LEADER}的率領下，擊潰了由{LOSER_LEADER}率領的{LOSER_FACTION}軍隊，殺敵{CASUALTIES}人。" />
    <string id="taom_wotr_desc_siege" text="{FACTION}的軍隊在{LEADER}的率領下，攻佔了{SETTLEMENT}。" />
    <string id="taom_wotr_desc_raid" text="{FACTION}的{PARTY}襲擊了{SETTLEMENT}村莊。" />
    <string id="taom_wotr_desc_army" text="一支由{LEADER}率領的軍隊已經集結。" />
    <string id="taom_wotr_desc_strength" text="我們比敵人強大{PERCENTAGE}%！" />
    <string id="taom_wotr_desc_kills" text="我軍在戰鬥中斬殺了 {CASUALTIES} 名敵人。" />
    <string id="taom_wotr_victory_title" text="戰爭終結" />
    <string id="taom_wotr_victory_free" text="戰爭結束了。自由人民堅持到了最後，為他們的子孫贏得了未來。自由萬歲！" />
    <string id="taom_wotr_victory_evil" text="人類與精靈的王國已然覆滅。索倫萬歲！" />
    <string id="taom_wotr_continue" text="繼續" />
    <string id="taom_wotr_chronicle_events" text="編年紀事" />
    <string id="taom_wc_siege_lost" text="戰事尚未分出勝負，{TARGET} 便已易主。" />
    <string id="taom_wc_fellowship_title" text="魔戒遠征隊啟程" />
    <string id="taom_wc_fellowship_occurred" text="九名行者秘密離開瑞文戴爾，攜至尊魔戒南行。愛隆的家族正匯聚力量。" />
    <string id="taom_wc_khazaddum_title" text="凱薩督姆之橋" />
    <string id="taom_wc_khazaddum_occurred" text="在摩瑞亞的深處，灰袍朝聖者與炎魔一同墜落。迷霧山脈的半獸人蜂擁而出，自由民族為之哀悼。" />
    <string id="taom_wc_breaking_title" text="遠征隊的離散" />
    <string id="taom_wc_breaking_occurred" text="在帕斯加蘭，強獸人撲向遠征隊。波羅莫為護衛哈比人而死，剛鐸失去了它的繼承人。" />
    <string id="taom_wc_theoden_title" text="希優頓王" />
    <string id="taom_wc_theoden_occurred" text="擺脫了巧言的讒言，希優頓重新執起佩劍。驃騎國為其國王集結。" />
    <string id="taom_wc_hornburg_title" text="號角堡之戰" />
    <string id="taom_wc_hornburg_open" text="艾辛格的大軍與登蘭德的山地人進軍 {TARGET}。此戰必須在 {DAYS} 日內分出勝負。" />
    <string id="taom_wc_hornburg_lapsed" text="{TARGET} 未遭攻擊。艾辛格的集結轉向了別處。" />
    <string id="taom_wc_hornburg_held" text="號角堡撐過了長夜，艾辛格的大軍在它的城牆前潰散。" />
    <string id="taom_wc_hornburg_fell" text="{TARGET} 陷落，白手統治了西伏谷。" />
    <string id="taom_wc_ents_title" text="樹人的最後進軍" />
    <string id="taom_wc_ents_occurred" text="范貢森林的樹人衝下艾辛格，淹沒了薩魯曼的坑窖。白手的熔爐就此沉寂。" />
    <string id="taom_wc_lorien_title" text="羅斯洛立安遇襲" />
    <string id="taom_wc_lorien_open" text="黑影自多爾哥多出擊，襲向黃金森林。{TARGET} 必須堅守 {DAYS} 日。" />
    <string id="taom_wc_lorien_lapsed" text="多爾哥多的大軍始終未抵達 {TARGET}。" />
    <string id="taom_wc_lorien_held" text="女皇的力量屹立不搖，多爾哥多的大軍自黃金森林退卻。" />
    <string id="taom_wc_lorien_fell" text="{TARGET} 陷入火海，羅斯洛立安的光芒日漸黯淡。" />
    <string id="taom_wc_osgiliath_title" text="奧斯吉力亞斯的陷落" />
    <string id="taom_wc_osgiliath_open" text="魔窟大軍渡過安都因河，直逼 {TARGET}。剛鐸必須守住這座廢墟之城 {DAYS} 日。" />
    <string id="taom_wc_osgiliath_lapsed" text="魔多並未進犯 {TARGET}，大河依舊平靜。" />
    <string id="taom_wc_osgiliath_held" text="法拉墨守住了安都因河的渡口，魔窟大軍撤退了。" />
    <string id="taom_wc_osgiliath_fell" text="{TARGET} 陷落，通往米那斯提力斯的道路門戶洞開。" />
    <string id="taom_wc_dale_title" text="河谷邦之戰" />
    <string id="taom_wc_dale_open" text="東方人與多爾哥多的爪牙進軍河谷邦王國。{TARGET} 必須堅守 {DAYS} 日。" />
    <string id="taom_wc_dale_lapsed" text="東方人轉身離去，{TARGET} 得以倖免。" />
    <string id="taom_wc_dale_held" text="河谷邦的人類與伊魯伯的矮人並肩而戰，東方人的大軍被擊退。" />
    <string id="taom_wc_dale_fell" text="{TARGET} 落入東方人之手，伊魯伯的矮人出兵馳援他們的盟友。" />
    <string id="taom_wc_corsairs_title" text="昂巴的海盜" />
    <string id="taom_wc_corsairs_open" text="昂巴的黑帆沿安都因河逼近 {TARGET}。剛鐸必須守住該港 {DAYS} 天。" />
    <string id="taom_wc_corsairs_lapsed" text="海盜徘徊於海上，{TARGET} 得享安寧。" />
    <string id="taom_wc_corsairs_held" text="昂巴的艦隊被逐出 {TARGET}，剛鐸南方諸領振奮不已。" />
    <string id="taom_wc_corsairs_fell" text="海盜奪取了 {TARGET}，他們的船隻控制了河道。" />
    <string id="taom_wc_north_title" text="北方之戰" />
    <string id="taom_wc_north_open" text="剛達巴的半獸人與登蘭德的丘陵人南下進犯北方。{TARGET} 必須堅守 {DAYS} 天。" />
    <string id="taom_wc_north_lapsed" text="北方的戰火未及 {TARGET}。" />
    <string id="taom_wc_north_held" text="遊俠與雅西頓的人類守住了 {TARGET}，北方依然自由。" />
    <string id="taom_wc_north_fell" text="{TARGET} 陷落，陰影蔓延至伊利雅德。" />
    <string id="taom_wc_gondor_title" text="剛鐸之圍" />
    <string id="taom_wc_gondor_open" text="戒靈之王率領魔多大軍進攻 {TARGET}。此城必須堅守 {DAYS} 天。" />
    <string id="taom_wc_gondor_lapsed" text="魔多的大軍按兵不動，{TARGET} 在昏暗的天空下靜待。" />
    <string id="taom_wc_gondor_held" text="洛汗騎兵於黎明時分趕到，{TARGET} 之圍在佩蘭諾平原上被解。" />
    <string id="taom_wc_gondor_fell" text="{TARGET} 的城門被攻破，白城落入魔多之手。" />
    <string id="taom_wc_blackgate_title" text="黑門開啟" />
    <string id="taom_wc_blackgate_occurred" text="西方的將領們進軍魔拉南，欲引開魔眼對持戒人的注視。戰爭的命運如今繫於至尊魔戒。" />
  </strings>
</base>
