<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema"
      type="string">
  <tags>
    <tag language="Traditional Chinese" />
  </tags>
  <strings>
    <string id="taom_lotr_issue_grain_title" text="{ISSUE_SETTLEMENT}需要種子穀物" />
    <string id="taom_lotr_issue_grain_desc" text="{ISSUE_SETTLEMENT}的居民失去了他們的種子穀物，若不播種田地，他們將會挨餓。" />
    <string id="taom_lotr_issue_grain_brief" text="陰影對我們來說太沉重了，旅行者。鼠患和嚴冬奪走了我們的種子穀物。若無穀物播種，我們撐不過今年。" />
    <string id="taom_lotr_issue_grain_accept" text="難道就沒有辦法了嗎？" />
    <string id="taom_lotr_issue_grain_expl" text="若您能為我們帶來{COUNT}份穀物，我們就能在季節更替前播種田地。我們沒有足夠的錢幣來購買這麼多穀物。" />
    <string id="taom_lotr_issue_grain_soln" text="我會為你找到那些糧食。" />
    <string id="taom_lotr_issue_grain_task" text="收集糧食({COUNT})" />
    <string id="taom_lotr_issue_supplies_title" text="缺乏糧草的軍隊" />
    <string id="taom_lotr_issue_supplies_desc" text="一位正在備戰的領主需要糧食來餵養集結的軍隊,然後才能出征。" />
    <string id="taom_lotr_issue_supplies_brief" text="我的士兵正在集結,但刀劍填不飽肚子。沒有糧食餵養他們,這支軍隊在上戰場前就會潰散。" />
    <string id="taom_lotr_issue_supplies_accept" text="你需要多少糧食?" />
    <string id="taom_lotr_issue_supplies_expl" text="給我帶來{COUNT}份糧食,我的士兵就能吃飽了出征。做到這一點,王國將會記住你的功勞。" />
    <string id="taom_lotr_issue_supplies_soln" text="我會為你的軍隊帶來糧食。" />
    <string id="taom_lotr_issue_supplies_task" text="將糧食送至軍隊({COUNT})" />
    <string id="taom_lotr_issue_draught_title" text="{ISSUE_SETTLEMENT}需要役畜" />
    <string id="taom_lotr_issue_draught_desc" text="{ISSUE_SETTLEMENT}村失去了耕牛,無法耕種田地。" />
    <string id="taom_lotr_issue_draught_brief" text="我們的牛被奪走了——有些被掠奪者搶走,有些死於飢荒。沒有牲畜拉犁,土地堅硬,田地無法播種。" />
    <string id="taom_lotr_issue_draught_accept" text="什麼能幫上忙?" />
    <string id="taom_lotr_issue_draught_expl" text="如果你能給我們趕來{COUNT}頭牛,我們就能在季節轉換前再次開墾土地。" />
    <string id="taom_lotr_issue_draught_soln" text="我會給你帶牛來。" />
    <string id="taom_lotr_issue_draught_task" text="運送牛({COUNT})" />
    <string id="taom_lotr_issue_crafting_title" text="{ISSUE_SETTLEMENT}需要鐵" />
    <string id="taom_lotr_issue_crafting_desc" text="{ISSUE_SETTLEMENT}的鐵匠缺少鐵,無法修補工具和刀劍。" />
    <string id="taom_lotr_issue_crafting_brief" text="鐵匠鋪冷清了,旅人。沒有鐵,鐵匠既不能給馬釘蹄鐵,也不能修補犁頭,整個村莊都因此受苦。" />
    <string id="taom_lotr_issue_crafting_accept" text="你從哪裡能弄到鐵?" />
    <string id="taom_lotr_issue_crafting_expl" text="給我們帶來{COUNT}條鐵錠,鐵匠鋪就能再次響起鐵錘聲。我們自己沒有足夠的錢來購買這麼多。" />
    <string id="taom_lotr_issue_crafting_soln" text="我會為你找到鐵。" />
    <string id="taom_lotr_issue_crafting_task" text="運送鐵({COUNT})" />
    <string id="taom_lotr_issue_tools_title" text="{ISSUE_SETTLEMENT}需要工具" />
    <string id="taom_lotr_issue_tools_desc" text="{ISSUE_SETTLEMENT}的居民缺乏工具來耕種土地和製作物品。" />
    <string id="taom_lotr_issue_tools_brief" text="我們的鐮刀鏽蝕不堪,鐵錘也都斷了。沒有好工具,誠實的勞動也變得緩慢。" />
    <string id="taom_lotr_issue_tools_accept" text="你需要什麼?" />
    <string id="taom_lotr_issue_tools_expl" text="如果你能給我們帶來{COUNT}套工具,村莊就能重整旗鼓,再次繁榮起來。" />
    <string id="taom_lotr_issue_tools_soln" text="我會給你帶來工具。" />
    <string id="taom_lotr_issue_tools_task" text="運送工具({COUNT})" />
    <string id="taom_lotr_issue_horses_title" text="缺少戰馬的領主" />
    <string id="taom_lotr_issue_horses_desc" text="一位領主在戰爭和損耗中失去了坐騎,需要新的戰馬給他的騎兵。" />
    <string id="taom_lotr_issue_horses_brief" text="戰爭對馬匹無情,旅人。我的馬在艱苦的道路上累倒了,而沒有坐騎的騎兵不過是行動遲緩的步兵。" />
    <string id="taom_lotr_issue_horses_accept" text="你需要多少匹馬?" />
    <string id="taom_lotr_issue_horses_expl" text="給我帶來{COUNT}匹健壯的馬,我的騎兵就能再次出征。你會得到豐厚的報酬。" />
    <string id="taom_lotr_issue_horses_soln" text="我會給你帶來馬匹。" />
    <string id="taom_lotr_issue_horses_task" text="運送馬匹({COUNT})" />
    <string id="taom_lotr_issue_recruits_title" text="幫派的新鮮血液" />
    <string id="taom_lotr_issue_recruits_desc" text="一位幫派頭目想要俘虜的亡命之徒為他效命。" />
    <string id="taom_lotr_issue_recruits_brief" text="幫派的強大取決於人數,而我的人手不足。給我帶來不愛法律的俘虜,我會好好利用他們。" />
    <string id="taom_lotr_issue_recruits_accept" text="什麼樣的俘虜?" />
    <string id="taom_lotr_issue_recruits_expl" text="給我帶來{COUNT}名盜賊俘虜,我會讓他們幹活。這裡有賞金給你,不問緣由。" />
    <string id="taom_lotr_issue_recruits_soln" text="我會給你帶來俘虜。" />
    <string id="taom_lotr_issue_recruits_task" text="交付盜賊俘虜({COUNT})" />
    <string id="taom_lotr_issue_laborers_title" text="礦場的勞力" />
    <string id="taom_lotr_issue_laborers_desc" text="一位地主需要強壯的勞力進行苦工,願意收納被俘的盜賊。" />
    <string id="taom_lotr_issue_laborers_brief" text="礦坑需要工人,但自由民不願下去。給我帶來戴著鐐銬的盜賊,他們會用鎬頭掙得口糧。" />
    <string id="taom_lotr_issue_laborers_accept" text="你要囚犯?" />
    <string id="taom_lotr_issue_laborers_expl" text="給我帶來{COUNT}名盜賊俘虜充作勞工,我會付你捕捉他們的辛勞費。" />
    <string id="taom_lotr_issue_laborers_soln" text="我會給你帶來俘虜。" />
    <string id="taom_lotr_issue_laborers_task" text="交付盜賊俘虜({COUNT})" />
    <string id="taom_lotr_issue_banditbase_title" text="{ISSUE_SETTLEMENT}附近的巢穴" />
    <string id="taom_lotr_issue_banditbase_desc" text="一窩劫掠者在{ISSUE_SETTLEMENT}附近的道路上橫行。" />
    <string id="taom_lotr_issue_banditbase_brief" text="旅人啊,山丘裡有他們的污穢巢穴。他們搶走我們的財物和人民,而守衛太少無法將他們剷除。" />
    <string id="taom_lotr_issue_banditbase_accept" text="這巢穴在哪裡?" />
    <string id="taom_lotr_issue_banditbase_expl" text="剿滅那些在我們道路上出沒的劫掠者,我們會給你報酬。這片土地會因此鬆一口氣。" />
    <string id="taom_lotr_issue_banditbase_soln" text="我會把他們清剿乾淨。" />
    <string id="taom_lotr_issue_outlaws_title" text="商道上的不法之徒" />
    <string id="taom_lotr_issue_outlaws_desc" text="劫掠團夥正在扼殺一位商人的貿易,必須予以剿滅。" />
    <string id="taom_lotr_issue_outlaws_brief" text="我的商隊因道路上的劫掠者而無法通行。擊破足夠多的團夥,貿易才能再次暢通。" />
    <string id="taom_lotr_issue_outlaws_accept" text="多少個團夥?" />
    <string id="taom_lotr_issue_outlaws_expl" text="擊敗那些在道路上肆虐的團夥——幾場勝仗就能讓其餘的人逃散——我會慷慨地支付你報酬。" />
    <string id="taom_lotr_issue_outlaws_soln" text="我會清理道路。" />
    <string id="taom_lotr_issue_poachers_title" text="一幫盜獵者" />
    <string id="taom_lotr_issue_poachers_desc" text="一大幫盜獵者正在毀掉一位商人的狩獵生意。" />
    <string id="taom_lotr_issue_poachers_brief" text="盜獵者變得大膽且人數眾多——他們把樹林劫掠一空,驅趕誠實的獵人。必須有人制止他們。" />
    <string id="taom_lotr_issue_poachers_accept" text="他們在哪裡活動?" />
    <string id="taom_lotr_issue_poachers_expl" text="擊敗盜獵者團夥,樹林就會再次屬於我們。這裡有賞金給你。" />
    <string id="taom_lotr_issue_poachers_soln" text="我會處理他們。" />
    <string id="taom_lotr_issue_captured_title" text="我被囚禁的手下" />
    <string id="taom_lotr_issue_captured_desc" text="一個幫派頭目的手下被賞金獵人抓走,他想要救回他們。" />
    <string id="taom_lotr_issue_captured_brief" text="賞金獵人抓走了我的一些手下,想要把他們賣掉。打倒那些關押他們的惡棍,就有賞金——私下的賞金。" />
    <string id="taom_lotr_issue_captured_accept" text="誰關押著他們?" />
    <string id="taom_lotr_issue_captured_expl" text="找到抓走我手下的團夥並擊潰他們。做到這點,你就能得到報酬,不問緣由。" />
    <string id="taom_lotr_issue_captured_soln" text="我會解救你的手下。" />
    <string id="taom_lotr_issue_deserters_title" text="逃兵掠奪{ISSUE_SETTLEMENT}" />
    <string id="taom_lotr_issue_deserters_desc" text="一幫逃兵對{ISSUE_SETTLEMENT}進行勒索,並殺死了拒絕的人。" />
    <string id="taom_lotr_issue_deserters_brief" text="帶著劍的敗兵來搶我們的糧食和錢財,他們已經殺了人。我們無法獨自對抗他們。" />
    <string id="taom_lotr_issue_deserters_accept" text="我會幫忙。他們在哪裡?" />
    <string id="taom_lotr_issue_deserters_expl" text="埋伏等待,在逃兵到來時擊潰他們。替我們除掉他們,你會得到我們的感激和賞金。" />
    <string id="taom_lotr_issue_deserters_soln" text="我會終結他們的劫掠。" />
    <string id="taom_lotr_issue_commons_title" text="公地之亂" />
    <string id="taom_lotr_issue_commons_desc" text="武裝的敵對者正以武力奪取村莊的放牧公地。" />
    <string id="taom_lotr_issue_commons_brief" text="惡徒佔據了我們的放牧地,驅趕任何靠近的人。我們的牲畜挨餓,而他們卻霸佔著土地。" />
    <string id="taom_lotr_issue_commons_accept" text="他們是什麼人?" />
    <string id="taom_lotr_issue_commons_expl" text="用武力將敵對者趕出我們的公地,牧場就能重歸我們所有。我們會盡力支付報酬。" />
    <string id="taom_lotr_issue_commons_soln" text="我會把他們趕走。" />
    <string id="taom_lotr_issue_rivalgang_title" text="敵幫來襲" />
    <string id="taom_lotr_issue_rivalgang_desc" text="敵對幫派正在搶佔某犯罪頭目的地盤,必須予以鎮壓。" />
    <string id="taom_lotr_issue_rivalgang_brief" text="另一幫人以為能奪走屬於我的東西。在巷弄中擊潰他們,街道就會恢復平靜——而你也能拿到報酬。" />
    <string id="taom_lotr_issue_rivalgang_accept" text="他們聚集在哪裡?" />
    <string id="taom_lotr_issue_rivalgang_expl" text="擊敗敵對幫派,殺雞儆猴。做到這點,就有豐厚的賞金等著你。" />
    <string id="taom_lotr_issue_rivalgang_soln" text="包在我身上。" />
    <string id="taom_lotr_issue_spy_title" text="敵國間諜" />
    <string id="taom_lotr_issue_spy_desc" text="一位領主懷疑有敵方特務正在對付他,希望將間諜的隊伍獵殺。" />
    <string id="taom_lotr_issue_spy_brief" text="草叢中有條毒蛇——我敵人的特務,帶著一幫刺客四處活動。在他們動手之前找到並消滅他們。" />
    <string id="taom_lotr_issue_spy_accept" text="我如何辨認他們?" />
    <string id="taom_lotr_issue_spy_expl" text="追獵間諜的隊伍並消滅之。為我除去這個威脅,你會得到豐厚的獎賞。" />
    <string id="taom_lotr_issue_spy_soln" text="我會追獵他們。" />
    <string id="taom_lotr_issue_revolt_title" text="叛逆貴族" />
    <string id="taom_lotr_issue_revolt_desc" text="一位小貴族煽動農民叛亂,必須予以鎮壓。" />
    <string id="taom_lotr_issue_revolt_brief" text="一個小領主煽動農民反抗他們的主人,並聚集武裝人員。趁叛亂蔓延前擊潰他的力量。" />
    <string id="taom_lotr_issue_revolt_accept" text="他在哪裡集結?" />
    <string id="taom_lotr_issue_revolt_expl" text="擊敗叛徒和他的烏合之眾,秩序就會恢復。你將因此獲得獎賞。" />
    <string id="taom_lotr_issue_revolt_soln" text="我會鎮壓這場叛亂。" />
    <string id="taom_lotr_issue_company_title" text="麻煩傭兵團" />
    <string id="taom_lotr_issue_company_desc" text="一支受雇騷擾領主的傭兵隊必須被驅逐。" />
    <string id="taom_lotr_issue_company_brief" text="我的敵人派了一支傭兵團到我的領地。他們受人之託燒殺劫掠。替我擊潰他們。" />
    <string id="taom_lotr_issue_company_accept" text="他們在哪裡劫掠?" />
    <string id="taom_lotr_issue_company_expl" text="擊敗傭兵團,我的領地就能重歸平靜。我會給你豐厚的報酬。" />
    <string id="taom_lotr_issue_company_soln" text="我會擊潰他們。" />
    <string id="taom_lotr_issue_prodigal_title" text="負債親族" />
    <string id="taom_lotr_issue_prodigal_desc" text="一位領主的年輕親族落入幫派之手,因債務被扣為人質。" />
    <string id="taom_lotr_issue_prodigal_brief" text="我那愚蠢的年輕表親落入盜賊之手,現在他們用債務扣押他。擊潰那幫人,解救他。" />
    <string id="taom_lotr_issue_prodigal_accept" text="他被關在哪裡?" />
    <string id="taom_lotr_issue_prodigal_expl" text="擊敗扣押我親族的幫派,把他帶出來。我會付出數倍於他債務的賞金。" />
    <string id="taom_lotr_issue_prodigal_soln" text="我會解救你的親族。" />
    <string id="taom_lotr_issue_rival_title" text="宿敵" />
    <string id="taom_lotr_issue_rival_desc" text="一位領主希望在戰鬥中活捉敵對領主。" />
    <string id="taom_lotr_issue_rival_brief" text="有位領主,我想看他被羞辱——活捉他,讓他顏面盡失。在戰鬥中俘虜一位敵方領主,我會視之為莫大的功勞。" />
    <string id="taom_lotr_issue_rival_accept" text="你要他活著?" />
    <string id="taom_lotr_issue_rival_expl" text="在戰鬥中俘虜一名敵方領主,此事便算完成。你將獲得豐厚的報酬。" />
    <string id="taom_lotr_issue_rival_soln" text="我會為你帶來一名俘虜領主。" />
    <string id="taom_lotr_issue_caravanambush_title" text="路上的埋伏" />
    <string id="taom_lotr_issue_caravanambush_desc" text="劫匪為一個商人的商隊設下了埋伏,必須先將他們擊潰。" />
    <string id="taom_lotr_issue_caravanambush_brief" text="我得到消息,前方道路上有強盜埋伏著等待我的商隊。觸發他們的陷阱並擊潰他們,免得他們榨乾我的血汗錢。" />
    <string id="taom_lotr_issue_caravanambush_accept" text="他們埋伏在哪裡?" />
    <string id="taom_lotr_issue_caravanambush_expl" text="找到那些埋伏等待的劫匪並消滅他們。清理道路,我的貨物——還有你的報酬——就能順利通過。" />
    <string id="taom_lotr_issue_caravanambush_soln" text="我會破壞他們的埋伏。" />
    <string id="taom_lotr_issue_escortcaravan_title" text="清理商路" />
    <string id="taom_lotr_issue_escortcaravan_desc" text="商人的商隊無法通行,直到路上的劫匪幫派被擊潰。" />
    <string id="taom_lotr_issue_escortcaravan_brief" text="只要劫匪還在路上出沒,我的貨車就不敢上路。擊敗足夠多的幫派,道路就會再次向誠實的商人開放。" />
    <string id="taom_lotr_issue_escortcaravan_accept" text="有多少人擋在路上?" />
    <string id="taom_lotr_issue_escortcaravan_expl" text="擊敗那些威脅商路的幫派,我的商隊就能再次上路。我會為安全通行付給你豐厚的報酬。" />
    <string id="taom_lotr_issue_escortcaravan_soln" text="我會清理道路。" />
    <string id="taom_lotr_issue_herd_title" text="{ISSUE_SETTLEMENT}的畜群" />
    <string id="taom_lotr_issue_herd_desc" text="{ISSUE_SETTLEMENT}的民眾需要牲畜來重建他們的畜群。" />
    <string id="taom_lotr_issue_herd_brief" text="狼群和更可怕的東西把我們的畜群減少到幾乎沒有了,旅人。沒有牲畜繁殖,村子將無法再度過一個豐足的冬天。" />
    <string id="taom_lotr_issue_herd_accept" text="你要我帶什麼來?" />
    <string id="taom_lotr_issue_herd_expl" text="為我們趕來{COUNT}頭羊,我們的畜群或許能再次壯大。我們會支付村子能拿出的報酬。" />
    <string id="taom_lotr_issue_herd_soln" text="我會為你們帶來畜群。" />
    <string id="taom_lotr_issue_herd_task" text="運送牲畜({COUNT})" />
    <string id="taom_lotr_issue_snare_title" text="貪婪者的陷阱" />
    <string id="taom_lotr_issue_snare_desc" text="一個幫派首領想要引誘一夥貪婪的對手進入陷阱並消滅他們。" />
    <string id="taom_lotr_issue_snare_brief" text="有一夥貪婪的傢伙,連自己的母親都會搶。引誘他們進來並擊潰他們,我們會分他們身上的東西——悄悄地分。" />
    <string id="taom_lotr_issue_snare_accept" text="這些對手是誰?" />
    <string id="taom_lotr_issue_snare_expl" text="對那夥貪婪的幫派設下陷阱並消滅他們。做得乾淨點,你會得到一大筆錢。" />
    <string id="taom_lotr_issue_snare_soln" text="我會搞定的。" />
    <string id="taom_lotr_issue_cantsell_title" text="無市場的貨物" />
    <string id="taom_lotr_issue_cantsell_desc" text="一位工匠的貨物積壓無人購買,需要運到有需求的市場去。" />
    <string id="taom_lotr_issue_cantsell_brief" text="我的貨架上堆滿了這裡沒人願意買的貨物,旅人。如果我的手藝能送到需要它的城鎮,我就不會在自己的工作台前挨餓了。" />
    <string id="taom_lotr_issue_cantsell_accept" text="你製作什麼?" />
    <string id="taom_lotr_issue_cantsell_expl" text="為我帶來{COUNT}批陶器送往更好的市場,我會支付你一份交易所得。" />
    <string id="taom_lotr_issue_cantsell_soln" text="我會讓你的貨物流通起來。" />
    <string id="taom_lotr_issue_cantsell_task" text="收集陶器用於交易({COUNT})" />
    <string id="taom_lotr_issue_overpriced_title" text="昂貴的原料" />
    <string id="taom_lotr_issue_overpriced_desc" text="一位工匠買不起手藝所需的原料,需要有人以便宜的價格帶來。" />
    <string id="taom_lotr_issue_overpriced_brief" text="好皮革的價格已經漲到不合理的地步,我的手藝因缺乏它而瀕臨絕境。以合理的價格為我帶來一些,我會記住這份恩情。" />
    <string id="taom_lotr_issue_overpriced_accept" text="你需要什麼?" />
    <string id="taom_lotr_issue_overpriced_expl" text="為我帶來{COUNT}批皮革,我的工坊就能再次運轉起來。我會公平地支付你報酬。" />
    <string id="taom_lotr_issue_overpriced_soln" text="我會幫你找到皮革。" />
    <string id="taom_lotr_issue_overpriced_task" text="交付皮革（{COUNT}）" />
    <string id="taom_lotr_issue_offload_title" text="燙手貨物待售" />
    <string id="taom_lotr_issue_offload_desc" text="一名幫派首領有贓物需要脫手，需要一個謹慎的人來運送。" />
    <string id="taom_lotr_issue_offload_brief" text="我這裡有一堆貨物，不能被不該看的人看見。幫我運送它們，就有乾淨的錢幣等著你——不問問題，不留姓名。" />
    <string id="taom_lotr_issue_offload_accept" text="我要運送什麼？" />
    <string id="taom_lotr_issue_offload_expl" text="弄來{COUNT}批這些貨物，悄悄地運走。幹得好的話，下次的活也是你的。" />
    <string id="taom_lotr_issue_offload_soln" text="我會運送你的貨物。" />
    <string id="taom_lotr_issue_offload_task" text="取得貨物（{COUNT}）" />
    <string id="taom_lotr_issue_revenue_title" text="實物什一稅" />
    <string id="taom_lotr_issue_revenue_desc" text="一名地主應收取穀物什一稅，但外圍農場尚未繳納。" />
    <string id="taom_lotr_issue_revenue_brief" text="那些農場欠我什一稅，是以穀物而非錢幣支付——如果他們會付的話。收回欠款帶回來，你會得到一份。" />
    <string id="taom_lotr_issue_revenue_accept" text="欠多少？" />
    <string id="taom_lotr_issue_revenue_expl" text="按什一稅的要求帶回{COUNT}份穀物，我會付給你合理的收取費。" />
    <string id="taom_lotr_issue_revenue_soln" text="我會收集你的什一稅。" />
    <string id="taom_lotr_issue_revenue_task" text="收取穀物什一稅（{COUNT}）" />
    <string id="taom_lotr_issue_arttrade_title" text="貿易投機" />
    <string id="taom_lotr_issue_arttrade_desc" text="一名有志商人需要引進貨物來獲利並證明投機可行。" />
    <string id="taom_lotr_issue_arttrade_brief" text="旅人，我想靠貿易發財，但我需要貨物來起步。給我帶來存貨，我會為我們倆把它變成黃金。" />
    <string id="taom_lotr_issue_arttrade_accept" text="你需要什麼存貨？" />
    <string id="taom_lotr_issue_arttrade_expl" text="給我帶來{COUNT}批油料來啟動投機，當賣出時你會分享利潤。" />
    <string id="taom_lotr_issue_arttrade_soln" text="我會為你的投機備貨。" />
    <string id="taom_lotr_issue_arttrade_task" text="交付交易存貨（{COUNT}）" />
    <string id="taom_lotr_issue_smugglers_title" text="打擊走私者" />
    <string id="taom_lotr_issue_smugglers_desc" text="走私集團正在削弱正當貿易，一名商人想要摧毀它。" />
    <string id="taom_lotr_issue_smugglers_brief" text="一個走私集團用不納稅的貨物充斥市場，正當商人因此破產。打斷他們的生意，貿易就會恢復正常。" />
    <string id="taom_lotr_issue_smugglers_accept" text="他們在哪裡運送貨物？" />
    <string id="taom_lotr_issue_smugglers_expl" text="擊敗走私者，瓦解他們的集團。清除道路上的他們，我會付你報酬。" />
    <string id="taom_lotr_issue_smugglers_soln" text="我會摧毀他們的集團。" />
    <string id="taom_lotr_issue_gangweapons_title" text="強奪軍械" />
    <string id="taom_lotr_issue_gangweapons_desc" text="一名幫派首領想要以武力奪取對手的武器庫。" />
    <string id="taom_lotr_issue_gangweapons_brief" text="對手幫派坐擁大量軍械，而我的手下用生鏽的刀子打鬥。擊垮他們，武器庫就是我們的——你也會分到一份。" />
    <string id="taom_lotr_issue_gangweapons_accept" text="這武器庫在哪裡？" />
    <string id="taom_lotr_issue_gangweapons_expl" text="擊敗守著武器的幫派，武器就歸我了。做到這點，你手裡就會有好錢幣。" />
    <string id="taom_lotr_issue_gangweapons_soln" text="我會奪取他們的武器庫。" />
    <string id="taom_lotr_issue_garrison_title" text="守衛城牆" />
    <string id="taom_lotr_issue_garrison_desc" text="一名領主的駐軍處境艱難，需要驅逐騷擾他們的敵人。" />
    <string id="taom_lotr_issue_garrison_brief" text="我的駐軍兵力緊張，敵人處處逼迫我們。擊退騷擾我城牆的幫派，你就能讓我的士兵喘口氣。" />
    <string id="taom_lotr_issue_garrison_accept" text="誰在逼迫你？" />
    <string id="taom_lotr_issue_garrison_expl" text="擊敗騷擾我駐軍的敵人，城牆就能守住。王國會為此獎賞你。" />
    <string id="taom_lotr_issue_garrison_soln" text="我會解救你的守軍。" />
    <string id="taom_lotr_issue_conquest_title" text="瓦解敵人的力量" />
    <string id="taom_lotr_issue_conquest_desc" text="一位領主計劃征服前,需要先擊潰敵人的野戰部隊。" />
    <string id="taom_lotr_issue_conquest_brief" text="我意欲奪取本該屬於我的領地,但敵人的力量擋在前路。在野外擊潰他的部隊,勝利將會更容易到手。" />
    <string id="taom_lotr_issue_conquest_accept" text="您要我做什麼?" />
    <string id="taom_lotr_issue_conquest_expl" text="擊敗敵人的部隊,削弱他的控制力。做到這點,征服的戰利品將有你一份。" />
    <string id="taom_lotr_issue_conquest_soln" text="我會打垮他的力量。" />
    <string id="taom_lotr_issue_raid_title" text="將戰火燒向敵境" />
    <string id="taom_lotr_issue_raid_desc" text="一位領主希望騷擾敵人的土地,並消滅他們的掠奪隊伍。" />
    <string id="taom_lotr_issue_raid_brief" text="是時候讓敵人在自己的土地上感受戰火了。追殺他的掠奪隊伍,將他們斬盡殺絕,讓他的土地知曉恐懼。" />
    <string id="taom_lotr_issue_raid_accept" text="我該在何處出擊?" />
    <string id="taom_lotr_issue_raid_expl" text="擊敗在邊境遊蕩的敵軍隊伍。染紅他的土地,你將獲得豐厚的報酬。" />
    <string id="taom_lotr_issue_raid_soln" text="我會將戰火帶給他們。" />
    <string id="taom_lotr_issue_scout_title" text="盯緊敵人" />
    <string id="taom_lotr_issue_scout_desc" text="一位領主需要擊潰敵人的巡邏隊,好讓他的斥候清楚觀察邊境地區。" />
    <string id="taom_lotr_issue_scout_brief" text="當敵人的巡邏隊在邊境遊蕩時,我對敵軍的動向一無所知。擊潰他們,讓我視野清明,我就能知道該在何處出擊。" />
    <string id="taom_lotr_issue_scout_accept" text="他的巡邏隊在哪裡遊蕩?" />
    <string id="taom_lotr_issue_scout_expl" text="擊敗在邊境掩護的敵軍巡邏隊,讓我的斥候能通行。做到這點,你會得到報酬。" />
    <string id="taom_lotr_issue_scout_soln" text="我會清理邊境。" />
    <string id="taom_lotr_issue_knight_title" text="勇士的青睞" />
    <string id="taom_lotr_issue_knight_desc" text="一位貴族女子希望看到她的信物在比武場上贏得勝利。" />
    <string id="taom_lotr_issue_knight_brief" text="我希望有一位勇士在比武大會上佩戴我的信物,以我之名贏得榮耀。在比武場上獲勝,你將贏得我永久的感激。" />
    <string id="taom_lotr_issue_knight_accept" text="您要我參加比武?" />
    <string id="taom_lotr_issue_knight_expl" text="佩戴我的信物贏得比武大會,榮耀將屬於我們雙方。你將因勝利獲得獎賞。" />
    <string id="taom_lotr_issue_knight_soln" text="我會為您奪勝。" />
    <string id="taom_lotr_issue_tutor_title" text="為繼承人的教育" />
    <string id="taom_lotr_issue_tutor_desc" text="一位領主需要精美布料和物品,以恰當的方式裝備他繼承人的教育。" />
    <string id="taom_lotr_issue_tutor_brief" text="我的繼承人必須接受符合我們家族身份的教育,需要精美的衣袍和學習所需的物品。把我需要的東西帶來,這孩子就不會有任何匱乏。" />
    <string id="taom_lotr_issue_tutor_accept" text="我需要帶來什麼?" />
    <string id="taom_lotr_issue_tutor_expl" text="給我帶來{COUNT}匹天鵝絨,為我的繼承人穿上符合領主身份的衣裝,你將得到豐厚的報酬。" />
    <string id="taom_lotr_issue_tutor_soln" text="我會為您的繼承人提供所需。" />
    <string id="taom_lotr_issue_tutor_task" text="運送精美布料({COUNT})" />
    <string id="taom_lotr_issue_training_title" text="讓扈從見血" />
    <string id="taom_lotr_issue_training_desc" text="一位地主希望讓他未經戰火的扈從在戰場上對抗真正的敵人。" />
    <string id="taom_lotr_issue_training_brief" text="我的扈從軟弱且未經考驗,而軟弱的人在第一場戰鬥中就會死去。帶領他們對抗真正的敵人,把他們鍛造成堅硬的戰士。" />
    <string id="taom_lotr_issue_training_accept" text="您要讓他們見血?" />
    <string id="taom_lotr_issue_training_expl" text="打贏幾場硬仗,教會我的扈從戰爭的技藝。讓他們變得堅韌,你將獲得教學的報酬。" />
    <string id="taom_lotr_issue_training_soln" text="我會把他們訓練成戰士。" />
    <string id="taom_lotr_issue_inn_title" text="受騙而痛苦" />
    <string id="taom_lotr_issue_inn_desc" text="一位名人被騙子騙走了財產,想要給他們一個慘痛的教訓。" />
    <string id="taom_lotr_issue_inn_brief" text="一群騙子和老千用灌鉛骰子和偽造文件奪走了我的財產。替我教訓他們,我或許還能在這城裡抬起頭來。" />
    <string id="taom_lotr_issue_inn_accept" text="誰騙了你?" />
    <string id="taom_lotr_issue_inn_expl" text="找到那些騙子,狠狠教訓他們。給他們一個永生難忘的教訓,我會盡我所能報答你。" />
    <string id="taom_lotr_issue_inn_soln" text="我會去算這筆帳。" />
    <string id="taom_lotr_issue_feud_title" text="舊日宿怨" />
    <string id="taom_lotr_issue_feud_desc" text="一場深刻的宿怨已演變成流血衝突,一位領主希望擊潰敵對派系的武裝人員。" />
    <string id="taom_lotr_issue_feud_brief" text="我家族與另一家族之間有著既深且久的血仇,如今已兵戎相見。擊潰他們的武裝人員,這場宿怨或許終能了結。" />
    <string id="taom_lotr_issue_feud_accept" text="你與誰結怨?" />
    <string id="taom_lotr_issue_feud_expl" text="擊敗敵對派系的人馬,用武力結束這場宿怨。做到這點,我家族將欠你人情。" />
    <string id="taom_lotr_issue_feud_soln" text="我會終結這場宿怨。" />
    <string id="taom_lotr_issue_daughter_title" text="被擄之女" />
    <string id="taom_lotr_issue_daughter_desc" text="一位名人的女兒被幫派擄走,她的家人希望將她救出。" />
    <string id="taom_lotr_issue_daughter_brief" text="我的女兒——他們擄走了我的女兒,旅者,索要我付不起的贖金。擊潰那些囚禁她的惡徒,把她帶回家給我。" />
    <string id="taom_lotr_issue_daughter_accept" text="她被囚禁在哪裡?" />
    <string id="taom_lotr_issue_daughter_expl" text="找到擄走我女兒的幫派並擊潰他們。把她平安帶回家,我會傾盡所有報答你。" />
    <string id="taom_lotr_issue_daughter_soln" text="我會把她帶回家。" />
    <string id="taom_lotr_issue_betting_title" text="穩贏的賭注" />
    <string id="taom_lotr_issue_betting_desc" text="一位幫派頭目在競技大會上下了重注,需要一位戰士來讓他的賭注有所回報。" />
    <string id="taom_lotr_issue_betting_brief" text="我在下一場競技大會上押了一大筆錢,我可不喜歡輸。替我贏得比賽,你能從獎金中分到豐厚的一份。" />
    <string id="taom_lotr_issue_betting_accept" text="你要我贏得競技大會?" />
    <string id="taom_lotr_issue_betting_expl" text="贏得一場競技大會,讓我的賭注有所回報。拿下獎項,我會從獎金中好好報答你。" />
    <string id="taom_lotr_issue_betting_soln" text="我會替你贏得賭注。" />
    <string id="taom_lotr_issue_special_title" text="熔爐的鐵料" />
    <string id="taom_lotr_issue_special_desc" text="一位幫派頭目想要優質鐵料來打造一批特殊刀劍。" />
    <string id="taom_lotr_issue_special_brief" text="我要打造刀劍——真正的好刀劍,不是我手下拿的那些廢物——這需要好鐵。給我帶來金屬,我會讓鐵匠們開工。" />
    <string id="taom_lotr_issue_special_accept" text="需要多少鐵?" />
    <string id="taom_lotr_issue_special_expl" text="給我帶來{COUNT}根好鐵條用於熔爐,會有錢拿——刀劍是我的事。" />
    <string id="taom_lotr_issue_special_soln" text="我會給你帶來鐵料。" />
    <string id="taom_lotr_issue_special_task" text="運送鐵料({COUNT})" />
    <string id="taom_lotr_issue_fallback_title" text="援助請求" />
    <string id="taom_lotr_issue_fallback_desc" text="當地人需要運送貨物。" />
    <string id="taom_lotr_issue_fallback_brief" text="我們身處困境,旅者。" />
    <string id="taom_lotr_issue_fallback_accept" text="我能幫什麼忙?" />
    <string id="taom_lotr_issue_fallback_expl" text="給我們帶來{COUNT}個{ITEM},我們就能得救。" />
    <string id="taom_lotr_issue_fallback_soln" text="我會帶來你們需要的東西。" />
    <string id="taom_lotr_issue_common_accepted" text="將{COUNT}個{ITEM}帶到{QUEST_SETTLEMENT}。" />
    <string id="taom_lotr_issue_common_ready" text="你已有足夠數量完成任務。返回{QUEST_SETTLEMENT}交付物品。" />
    <string id="taom_lotr_issue_common_cancel" text="協議已取消。" />
    <string id="taom_lotr_issue_common_timeout" text="你未能及時運送貨物。" />
    <string id="taom_lotr_issue_common_offer_accept" text="謝謝你。我不會忘記這份恩情。" />
    <string id="taom_lotr_issue_common_have_you" text="你帶來我們需要的東西了嗎?" />
    <string id="taom_lotr_issue_common_thanks" text="願神祝福你,旅者。你拯救了我們。" />
    <string id="taom_lotr_issue_common_await" text="我們等待你的歸來。" />
    <string id="taom_lotr_issue_common_turnin" text="是的。東西在這裡。" />
    <string id="taom_lotr_issue_common_working" text="還沒有——我正在處理。" />
    <string id="taom_lotr_issue_common_not_enough" text="你帶來的還不夠。" />
    <string id="taom_lotr_issue_common_task" text="收集物資" />
    <string id="taom_lotr_issue_pers_expl" text="給我帶來{COUNT}個俘虜,我會給你豐厚的報酬。" />
    <string id="taom_lotr_issue_pers_soln" text="我會給你帶來俘虜。" />
