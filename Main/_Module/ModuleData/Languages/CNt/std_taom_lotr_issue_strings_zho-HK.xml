<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema"
      type="string">
  <tags>
    <tag language="Traditional Chinese" />
  </tags>
  <strings>
    <string id="taom_lotr_issue_grain_title" text="{ISSUE_SETTLEMENT}需要糧種" />
    <string id="taom_lotr_issue_grain_desc" text="{ISSUE_SETTLEMENT}的居民失去了糧種。如果不能及時播種，他們就要捱餓了。" />
    <string id="taom_lotr_issue_grain_brief" text="旅人，黑暗籠罩下的日子可不好過。鼠患和嚴冬毀掉了我們的糧種。沒有糧食播種，我們就撐不過這一年。" />
    <string id="taom_lotr_issue_grain_accept" text="難道沒有辦法了嗎？" />
    <string id="taom_lotr_issue_grain_expl" text="如果你能帶來{COUNT}份糧食，我們就能趕在換季前播種。我們自己實在買不起這麼多。" />
    <string id="taom_lotr_issue_grain_soln" text="我會爲你們找來糧食。" />
    <string id="taom_lotr_issue_grain_task" text="收集穀物（{COUNT}）" />
    <string id="taom_lotr_issue_supplies_title" text="急需糧草的大軍" />
    <string id="taom_lotr_issue_supplies_desc" text="一位領主正在集結軍隊準備出征，需要糧食供養集結的士兵。" />
    <string id="taom_lotr_issue_supplies_brief" text="我的士兵正在集結，但光有劍可填不飽肚子。沒有糧食，這支大軍還沒上戰場就會散了。" />
    <string id="taom_lotr_issue_supplies_accept" text="你需要多少糧食？" />
    <string id="taom_lotr_issue_supplies_expl" text="給我帶來{COUNT}份糧食，我的部下就能喫飽了出征。辦成這件事，整個王國都會記住你的功勞。" />
    <string id="taom_lotr_issue_supplies_soln" text="我會給你的軍隊送來糧食。" />
    <string id="taom_lotr_issue_supplies_task" text="爲軍隊運送穀物（{COUNT}）" />
    <string id="taom_lotr_issue_draught_title" text="{ISSUE_SETTLEMENT}需要役畜" />
    <string id="taom_lotr_issue_draught_desc" text="{ISSUE_SETTLEMENT}村失去了耕牛，已經無法耕種田地。" />
    <string id="taom_lotr_issue_draught_brief" text="我們的耕牛沒了，有些被劫掠者搶走，有些活活餓死。沒有牲畜拉犁，硬土翻不開，田地也沒法播種。" />
    <string id="taom_lotr_issue_draught_accept" text="怎樣才能幫到你們？" />
    <string id="taom_lotr_issue_draught_expl" text="如果你能給我們趕來{COUNT}頭牛，我們就能在換季前重新翻耕土地。" />
    <string id="taom_lotr_issue_draught_soln" text="我會給你們帶來牛。" />
    <string id="taom_lotr_issue_draught_task" text="交付牛（{COUNT}）" />
    <string id="taom_lotr_issue_crafting_title" text="{ISSUE_SETTLEMENT}需要鐵料" />
    <string id="taom_lotr_issue_crafting_desc" text="{ISSUE_SETTLEMENT}的鐵匠耗盡了鐵料，沒法修理工具和刀劍。" />
    <string id="taom_lotr_issue_crafting_brief" text="旅人，鍛爐的火已經熄了。沒有鐵料，鐵匠既不能給馬釘蹄鐵，也不能修補犁鏵，整個村子都受到了影響。" />
    <string id="taom_lotr_issue_crafting_accept" text="哪裏能弄到鐵？" />
    <string id="taom_lotr_issue_crafting_expl" text="給我們帶來{COUNT}塊鐵錠，鍛爐旁就能重新響起錘聲。我們自己實在買不起這麼多鐵料。" />
    <string id="taom_lotr_issue_crafting_soln" text="我會爲你們找來鐵料。" />
    <string id="taom_lotr_issue_crafting_task" text="交付鐵錠（{COUNT}）" />
    <string id="taom_lotr_issue_tools_title" text="{ISSUE_SETTLEMENT}需要工具" />
    <string id="taom_lotr_issue_tools_desc" text="{ISSUE_SETTLEMENT}的居民缺少耕種和製作貨物所需的工具。" />
    <string id="taom_lotr_issue_tools_brief" text="我們的鐮刀已經鏽穿了，錘子也壞了。再勤快的人，沒有趁手的工具也幹不快。" />
    <string id="taom_lotr_issue_tools_accept" text="你需要什麼？" />
    <string id="taom_lotr_issue_tools_expl" text="如果你能帶來{COUNT}套工具，村子就能恢復正常，再次興旺起來。" />
    <string id="taom_lotr_issue_tools_soln" text="我會給你們帶來工具。" />
    <string id="taom_lotr_issue_tools_task" text="交付工具（{COUNT}）" />
    <string id="taom_lotr_issue_horses_title" text="缺少戰馬的領主" />
    <string id="taom_lotr_issue_horses_desc" text="一位領主的坐騎因戰鬥和日常損耗而減少，需要爲騎兵補充馬匹。" />
    <string id="taom_lotr_issue_horses_brief" text="旅人，戰爭可不會憐惜馬匹。我的馬在艱難的長途行軍中接連累垮，騎手沒了坐騎，也不過是個行動遲緩的矛兵。" />
    <string id="taom_lotr_issue_horses_accept" text="你需要多少匹馬？" />
    <string id="taom_lotr_issue_horses_expl" text="給我帶來{COUNT}匹健壯的馬，我的騎手就能重新出徵。你會得到豐厚的報酬。" />
    <string id="taom_lotr_issue_horses_soln" text="我會給你帶來馬匹。" />
    <string id="taom_lotr_issue_horses_task" text="交付馬匹（{COUNT}）" />
    <string id="taom_lotr_issue_recruits_title" text="幫派需要新血" />
    <string id="taom_lotr_issue_recruits_desc" text="一個幫派頭目想強迫俘虜爲他效力。" />
    <string id="taom_lotr_issue_recruits_brief" text="幫派人多才有力量，可我這裏缺人。不管是什麼人，只要是俘虜就給我帶來，我自有用處。" />
    <string id="taom_lotr_issue_recruits_accept" text="你要什麼樣的俘虜？" />
    <string id="taom_lotr_issue_recruits_expl" text="給我帶來{COUNT}名俘虜，我會安排他們幹活。你拿錢，我也不問他們的來路。" />
    <string id="taom_lotr_issue_recruits_soln" text="我會給你帶來俘虜。" />
    <string id="taom_lotr_issue_recruits_task" text="交付俘虜（{COUNT}）" />
    <string id="taom_lotr_issue_laborers_title" text="礦場缺人手" />
    <string id="taom_lotr_issue_laborers_desc" text="一位地主需要強壯的人手乾重活，願意接收你抓到的任何俘虜。" />
    <string id="taom_lotr_issue_laborers_brief" text="礦坑裏缺工人，可自由民都不肯下去。給我帶些戴着鐐銬的俘虜，他們得靠揮鎬幹活換口飯喫。" />
    <string id="taom_lotr_issue_laborers_accept" text="你要俘虜？" />
    <string id="taom_lotr_issue_laborers_expl" text="給我帶來{COUNT}名俘虜補充勞工隊，我會付你抓人的辛苦錢。" />
    <string id="taom_lotr_issue_laborers_soln" text="我會給你帶來俘虜。" />
    <string id="taom_lotr_issue_laborers_task" text="交付俘虜（{COUNT}）" />
    <string id="taom_lotr_issue_banditbase_title" text="{ISSUE_SETTLEMENT}附近的巢穴" />
    <string id="taom_lotr_issue_banditbase_desc" text="一夥劫掠者盤踞在{ISSUE_SETTLEMENT}附近，襲擊道路上的行人。" />
    <string id="taom_lotr_issue_banditbase_brief" text="旅人，山裏有一處賊窩。他們搶走我們的貨物，還抓走我們的人。守衛人手太少，沒法把他們一網打盡。" />
    <string id="taom_lotr_issue_banditbase_accept" text="這處巢穴在哪裏？" />
    <string id="taom_lotr_issue_banditbase_expl" text="除掉那些在道路上作惡的劫掠者，我們會給你報酬。這裏的日子也能安穩些。" />
    <string id="taom_lotr_issue_banditbase_soln" text="我會把他們一網打盡。" />
    <string id="taom_lotr_issue_outlaws_title" text="商路上的亡命徒" />
    <string id="taom_lotr_issue_outlaws_desc" text="劫掠團伙正在阻斷一位商人的生意，需要有人將他們擊潰。" />
    <string id="taom_lotr_issue_outlaws_brief" text="路上的劫掠者讓我的商隊寸步難行。多打垮幾支劫掠隊，生意纔有機會恢復。" />
    <string id="taom_lotr_issue_outlaws_accept" text="要對付多少夥人？" />
    <string id="taom_lotr_issue_outlaws_expl" text="擊敗那些在路上作惡的團伙，打幾場漂亮的勝仗，其餘的人自然就散了。我會給你豐厚的報酬。" />
    <string id="taom_lotr_issue_outlaws_soln" text="我會清除商路上的匪患。" />
    <string id="taom_lotr_issue_poachers_title" text="一夥偷獵者" />
    <string id="taom_lotr_issue_poachers_desc" text="一大羣偷獵者正在毀掉一位商人的狩獵生意。" />
    <string id="taom_lotr_issue_poachers_brief" text="偷獵者越來越多，也越來越猖狂。他們把林子裏的獵物捕殺一空，還趕走正經獵人。必須有人收拾他們。" />
    <string id="taom_lotr_issue_poachers_accept" text="他們在哪裏活動？" />
    <string id="taom_lotr_issue_poachers_expl" text="打敗那羣偷獵者，林子就又是我們的了。你會得到報酬。" />
    <string id="taom_lotr_issue_poachers_soln" text="我會對付他們。" />
    <string id="taom_lotr_issue_captured_title" text="被俘的手下" />
    <string id="taom_lotr_issue_captured_desc" text="一個幫派頭目的手下被賞金獵人抓走了，他想把他們救出來。" />
    <string id="taom_lotr_issue_captured_brief" text="賞金獵人抓走了我的幾個手下，還打算把他們賣掉。打垮看押他們的那羣混蛋，我會私下給你報酬，絕不聲張。" />
    <string id="taom_lotr_issue_captured_accept" text="誰看押着他們？" />
    <string id="taom_lotr_issue_captured_expl" text="找到抓走我手下的那夥人，把他們打垮。辦成了就有錢拿，我不會多問。" />
    <string id="taom_lotr_issue_captured_soln" text="我會救出你的人。" />
    <string id="taom_lotr_issue_deserters_title" text="逃兵劫掠{ISSUE_SETTLEMENT}" />
    <string id="taom_lotr_issue_deserters_desc" text="一夥逃兵正在勒索{ISSUE_SETTLEMENT}的居民，還殺害了拒絕交錢的人。" />
    <string id="taom_lotr_issue_deserters_brief" text="一羣拿着劍的潰兵來搶我們的糧食和錢財，已經鬧出了人命。光靠我們自己對付不了他們。" />
    <string id="taom_lotr_issue_deserters_accept" text="我會幫忙。他們在哪裏？" />
    <string id="taom_lotr_issue_deserters_expl" text="先埋伏起來，等那些逃兵來了就打垮他們。替我們除掉這羣人，我們會感謝你，也會給你報酬。" />
    <string id="taom_lotr_issue_deserters_soln" text="我會讓他們再也沒法劫掠。" />
    <string id="taom_lotr_issue_commons_title" text="公用牧地之爭" />
    <string id="taom_lotr_issue_commons_desc" text="一夥武裝人員正用武力搶佔村莊的公用牧地。" />
    <string id="taom_lotr_issue_commons_brief" text="一羣兇徒佔了我們的牧地，誰靠近就趕走誰。他們一天不走，我們的牲畜就得挨一天餓。" />
    <string id="taom_lotr_issue_commons_accept" text="他們是什麼人？" />
    <string id="taom_lotr_issue_commons_expl" text="用武力把他們趕出公用牧地，牧場就又是我們的了。我們會盡力湊出報酬。" />
    <string id="taom_lotr_issue_commons_soln" text="我會把他們趕走。" />
    <string id="taom_lotr_issue_rivalgang_title" text="敵對幫派搶地盤" />
    <string id="taom_lotr_issue_rivalgang_desc" text="一個敵對幫派正在搶佔幫派頭目的地盤，需要有人將他們擊敗。" />
    <string id="taom_lotr_issue_rivalgang_brief" text="另一夥人以爲能搶走我的地盤。去巷子裏打垮他們，街上就又能安靜下來了，你也能拿到錢。" />
    <string id="taom_lotr_issue_rivalgang_accept" text="他們在哪裏聚集？" />
    <string id="taom_lotr_issue_rivalgang_expl" text="打敗敵對幫派，讓其他人看看和我作對的下場。辦成了，就有大筆金幣等着你。" />
    <string id="taom_lotr_issue_rivalgang_soln" text="包在我身上。" />
    <string id="taom_lotr_issue_spy_title" text="敵方密探" />
    <string id="taom_lotr_issue_spy_desc" text="一位領主懷疑敵方密探正圖謀對付他，希望有人追蹤並消滅密探的隊伍。" />
    <string id="taom_lotr_issue_spy_brief" text="暗處藏着一條毒蛇，是敵人派來的密探，身邊還帶着一羣亡命徒。趁他們還沒動手，找到他們，除掉他們。" />
    <string id="taom_lotr_issue_spy_accept" text="我怎麼認出他們？" />
    <string id="taom_lotr_issue_spy_expl" text="追上並消滅密探的隊伍。替我除掉這個威脅，你會得到豐厚的獎賞。" />
    <string id="taom_lotr_issue_spy_soln" text="我會追上他們，把他們除掉。" />
    <string id="taom_lotr_issue_revolt_title" text="叛亂的貴族" />
    <string id="taom_lotr_issue_revolt_desc" text="一個小貴族煽動農民起義，需要有人將其鎮壓。" />
    <string id="taom_lotr_issue_revolt_brief" text="一個小領主煽動農民反抗貴族，還召集了一批武裝人員。趁叛亂還沒蔓延，把他的勢力打垮。" />
    <string id="taom_lotr_issue_revolt_accept" text="他在哪裏集結？" />
    <string id="taom_lotr_issue_revolt_expl" text="打敗這個叛徒和他那羣烏合之衆，秩序就能恢復。你會因爲這次效勞得到獎賞。" />
    <string id="taom_lotr_issue_revolt_soln" text="我會鎮壓這場叛亂。" />
    <string id="taom_lotr_issue_company_title" text="惹是生非的傭兵團" />
    <string id="taom_lotr_issue_company_desc" text="一羣僱傭兵受僱騷擾一位領主，需要有人將他們趕走。" />
    <string id="taom_lotr_issue_company_brief" text="我的敵人派了一支傭兵團到我的領地上。他們拿着別人的錢，到處燒殺搶掠。替我打垮他們。" />
    <string id="taom_lotr_issue_company_accept" text="他們在哪裏劫掠？" />
    <string id="taom_lotr_issue_company_expl" text="打敗這支傭兵團，我的領地就能重新安寧下來。我會給你豐厚的報酬。" />
    <string id="taom_lotr_issue_company_soln" text="我會打垮他們。" />
    <string id="taom_lotr_issue_prodigal_title" text="欠債的親人" />
    <string id="taom_lotr_issue_prodigal_desc" text="一位領主的年輕親戚和幫派混在一起，欠了債，如今被他們扣押。" />
    <string id="taom_lotr_issue_prodigal_brief" text="我有個不成器的年輕親戚，跟一羣盜賊混在一起，如今那夥人因爲他欠債把他扣住了。打垮他們，把人救出來。" />
    <string id="taom_lotr_issue_prodigal_accept" text="他被關在哪裏？" />
    <string id="taom_lotr_issue_prodigal_expl" text="打敗扣押我親人的幫派，把他救出來。我願意拿出那筆債務幾倍的錢來酬謝你。" />
    <string id="taom_lotr_issue_prodigal_soln" text="我會救出你的親人。" />
    <string id="taom_lotr_issue_rival_title" text="可恨的對手" />
    <string id="taom_lotr_issue_rival_desc" text="一位領主想讓人在戰鬥中活捉他的敵對領主。" />
    <string id="taom_lotr_issue_rival_brief" text="有個領主，我很想看他被活捉，再狠狠受一番羞辱。只要你能在戰鬥中俘虜一名敵方領主，就算幫了我一個大忙。" />
    <string id="taom_lotr_issue_rival_accept" text="你要活捉他？" />
    <string id="taom_lotr_issue_rival_expl" text="在戰鬥中俘虜一名敵方領主，任務就算完成。你會得到豐厚的獎賞。" />
    <string id="taom_lotr_issue_rival_soln" text="我會給你帶來一名被俘的領主。" />
    <string id="taom_lotr_issue_caravanambush_title" text="商路伏擊" />
    <string id="taom_lotr_issue_caravanambush_desc" text="劫掠者爲一位商人的商隊設下了埋伏，需要先擊敗他們。" />
    <string id="taom_lotr_issue_caravanambush_brief" text="我得到消息，前面的路上有強盜正埋伏着，等我的商隊經過。將計就計，趁他們還沒把我搶個精光，打垮他們。" />
    <string id="taom_lotr_issue_caravanambush_accept" text="他們埋伏在哪裏？" />
    <string id="taom_lotr_issue_caravanambush_expl" text="找到那些埋伏的劫掠者，把他們消滅。道路暢通了，我的貨物和你的報酬才能送過來。" />
    <string id="taom_lotr_issue_caravanambush_soln" text="我會粉碎他們的伏擊。" />
    <string id="taom_lotr_issue_escortcaravan_title" text="肅清商路" />
    <string id="taom_lotr_issue_escortcaravan_desc" text="只有擊敗商路上的劫掠團伙，一位商人的商隊才能通行。" />
    <string id="taom_lotr_issue_escortcaravan_brief" text="路上到處都是劫掠者，我的貨車根本不敢動身。多打垮幾支劫掠隊，正經商人才能重新做生意。" />
    <string id="taom_lotr_issue_escortcaravan_accept" text="有多少人擋道？" />
    <string id="taom_lotr_issue_escortcaravan_expl" text="打敗那些威脅商路的團伙，我的商隊就能重新上路。只要能安全通行，我會給你豐厚的報酬。" />
    <string id="taom_lotr_issue_escortcaravan_soln" text="我會掃清路上的障礙。" />
    <string id="taom_lotr_issue_herd_title" text="爲{ISSUE_SETTLEMENT}運送牲畜" />
    <string id="taom_lotr_issue_herd_desc" text="{ISSUE_SETTLEMENT}的居民需要有人運來牲畜，讓畜羣重新繁衍。" />
    <string id="taom_lotr_issue_herd_brief" text="旅人，狼和更可怕的東西幾乎害光了我們的牲畜。沒有種畜繁育，村子以後就別想過上糧食充足的冬天了。" />
    <string id="taom_lotr_issue_herd_accept" text="你想讓我帶什麼來？" />
    <string id="taom_lotr_issue_herd_expl" text="給我們趕來{COUNT}只羊，畜羣纔有機會重新繁衍。我們會盡村子所能湊出報酬。" />
    <string id="taom_lotr_issue_herd_soln" text="我會給你們帶來牲畜。" />
    <string id="taom_lotr_issue_herd_task" text="交付牲畜（{COUNT}）" />
    <string id="taom_lotr_issue_snare_title" text="給貪婪者的陷阱" />
    <string id="taom_lotr_issue_snare_desc" text="一個幫派頭目想將一夥貪婪的對手誘入陷阱，再消滅他們。" />
    <string id="taom_lotr_issue_snare_brief" text="有一夥貪得無厭的傢伙，連自己親孃都敢搶。把他們引過來幹掉，我們再悄悄分掉他們帶的東西。" />
    <string id="taom_lotr_issue_snare_accept" text="這些對手是什麼人？" />
    <string id="taom_lotr_issue_snare_expl" text="等那羣貪婪的傢伙落入圈套，就把他們解決掉。辦得乾淨利落，你就能拿到一大筆錢。" />
    <string id="taom_lotr_issue_snare_soln" text="我會辦好的。" />
    <string id="taom_lotr_issue_cantsell_title" text="無人問津的貨物" />
    <string id="taom_lotr_issue_cantsell_desc" text="一位工匠的貨物積壓賣不出去，需要運到有銷路的市場。" />
    <string id="taom_lotr_issue_cantsell_brief" text="旅人，我的貨架快被壓垮了，可這裏沒人肯買。只要把這些貨送到需要它們的城鎮，我就不用守着手藝捱餓了。" />
    <string id="taom_lotr_issue_cantsell_accept" text="你做的是什麼貨物？" />
    <string id="taom_lotr_issue_cantsell_expl" text="給我帶來{COUNT}批陶器，好送到銷路更好的市場去。我會分給你一部分賣貨的收入。" />
    <string id="taom_lotr_issue_cantsell_soln" text="我會幫你的貨物打開銷路。" />
    <string id="taom_lotr_issue_cantsell_task" text="收集陶器用於交易（{COUNT}）" />
    <string id="taom_lotr_issue_overpriced_title" text="昂貴的材料" />
    <string id="taom_lotr_issue_overpriced_desc" text="一位工匠買不起製作貨物所需的原料，需要有人便宜些賣給他。" />
    <string id="taom_lotr_issue_overpriced_brief" text="好皮革的價格漲得太離譜了，再弄不到，我的生意就要做不下去了。按公道的價錢給我帶一些來，我會記住你的幫助。" />
    <string id="taom_lotr_issue_overpriced_accept" text="你需要什麼？" />
    <string id="taom_lotr_issue_overpriced_expl" text="給我帶來{COUNT}批皮革，我的作坊就能重新開工。我會給你公道的報酬。" />
    <string id="taom_lotr_issue_overpriced_soln" text="我會爲你找來皮革。" />
    <string id="taom_lotr_issue_overpriced_task" text="交付皮革（{COUNT}）" />
    <string id="taom_lotr_issue_offload_title" text="轉移贓物" />
    <string id="taom_lotr_issue_offload_desc" text="一個幫派頭目需要轉移一批贓物，正在找能悄悄運走它們的人。" />
    <string id="taom_lotr_issue_offload_brief" text="我有一批貨，可不能讓不該看見的人看見。替我運走它們，就有一筆乾淨的錢等着你。不問來路，也不留姓名。" />
    <string id="taom_lotr_issue_offload_accept" text="我要運什麼？" />
    <string id="taom_lotr_issue_offload_expl" text="給我弄來{COUNT}批這種貨物，再悄悄轉移。辦好了，下一單生意也交給你。" />
    <string id="taom_lotr_issue_offload_soln" text="我會運走你的貨物。" />
    <string id="taom_lotr_issue_offload_task" text="取得貨物（{COUNT}）" />
    <string id="taom_lotr_issue_revenue_title" text="實物什一稅" />
    <string id="taom_lotr_issue_revenue_desc" text="偏遠的農場拖欠了一位地主的什一稅，需要以糧食繳納。" />
    <string id="taom_lotr_issue_revenue_brief" text="農場欠我什一稅，要用糧食交，不是錢幣。當然，得他們肯交纔行。把欠的收上來交給我，你也能分到一份。" />
    <string id="taom_lotr_issue_revenue_accept" text="欠了多少？" />
    <string id="taom_lotr_issue_revenue_expl" text="按照什一稅應收的數額，收來{COUNT}份糧食。我會給你一份公道的報酬。" />
    <string id="taom_lotr_issue_revenue_soln" text="我會爲你收齊什一稅。" />
    <string id="taom_lotr_issue_revenue_task" text="收取糧食什一稅（{COUNT}）" />
    <string id="taom_lotr_issue_arttrade_title" text="一樁貿易生意" />
    <string id="taom_lotr_issue_arttrade_desc" text="一個想做生意的人需要一批貨物來賺取利潤，證明這門生意行得通。" />
    <string id="taom_lotr_issue_arttrade_brief" text="旅人，我想靠做生意發財，可還缺第一批貨。你把貨物帶來，我把它們賣成錢，讓咱們兩個都能賺上一筆。" />
    <string id="taom_lotr_issue_arttrade_accept" text="你需要什麼貨物？" />
    <string id="taom_lotr_issue_arttrade_expl" text="給我帶來{COUNT}批油，讓生意做起來。貨物賣掉後，你也能分到利潤。" />
    <string id="taom_lotr_issue_arttrade_soln" text="我會給你的生意備好貨。" />
    <string id="taom_lotr_issue_arttrade_task" text="交付貿易貨物（{COUNT}）" />
    <string id="taom_lotr_issue_smugglers_title" text="剷除走私團伙" />
    <string id="taom_lotr_issue_smugglers_desc" text="一個走私團伙正靠低價貨衝擊正經商人的生意，一位商人希望有人剷除他們。" />
    <string id="taom_lotr_issue_smugglers_brief" text="一夥走私販把沒交過稅的貨物大量倒進市場，正經商人都快被逼破產了。斷掉他們的運貨路線，生意自然就能恢復正常。" />
    <string id="taom_lotr_issue_smugglers_accept" text="他們從哪裏運貨？" />
    <string id="taom_lotr_issue_smugglers_expl" text="打敗走私販，打散他們的團伙。把他們趕出商路，我會給你報酬。" />
    <string id="taom_lotr_issue_smugglers_soln" text="我會打散他們的團伙。" />
    <string id="taom_lotr_issue_gangweapons_title" text="奪取武器" />
    <string id="taom_lotr_issue_gangweapons_desc" text="一個幫派頭目想用武力奪取對手藏匿的武器。" />
    <string id="taom_lotr_issue_gangweapons_brief" text="對頭藏着一批好武器，我的手下卻只能拿生鏽的刀打架。打敗他們，武器就是我們的了，你也能分到一份。" />
    <string id="taom_lotr_issue_gangweapons_accept" text="這批武器藏在哪裏？" />
    <string id="taom_lotr_issue_gangweapons_expl" text="打敗看守武器的那夥人，武器就歸我了。辦成這件事，我會給你一大筆錢。" />
    <string id="taom_lotr_issue_gangweapons_soln" text="我會奪下他們藏的武器。" />
    <string id="taom_lotr_issue_garrison_title" text="堅守城牆" />
    <string id="taom_lotr_issue_garrison_desc" text="一位領主的駐軍處境艱難，需要有人擊退不斷騷擾他們的敵軍。" />
    <string id="taom_lotr_issue_garrison_brief" text="我的駐軍兵力不足，敵人卻步步緊逼。打垮那些騷擾城防的隊伍，讓我的士兵喘口氣。" />
    <string id="taom_lotr_issue_garrison_accept" text="是誰在進逼？" />
    <string id="taom_lotr_issue_garrison_expl" text="擊敗騷擾駐軍的敵人，城牆就能守住。王國會獎賞你。" />
    <string id="taom_lotr_issue_garrison_soln" text="我會替你的駐軍解圍。" />
    <string id="taom_lotr_issue_conquest_title" text="削弱敵軍實力" />
    <string id="taom_lotr_issue_conquest_desc" text="一位領主準備出兵征服敵土，需要先擊潰敵人的野戰部隊。" />
    <string id="taom_lotr_issue_conquest_brief" text="我打算拿走本該屬於我的東西，可敵軍擋在前面。打垮他們的野戰部隊，目標就更容易到手了。" />
    <string id="taom_lotr_issue_conquest_accept" text="你想讓我做什麼？" />
    <string id="taom_lotr_issue_conquest_expl" text="擊敗敵軍，削弱他們對領地的控制。辦成了，你就能分到這次征戰的戰利品。" />
    <string id="taom_lotr_issue_conquest_soln" text="我會削弱他的兵力。" />
    <string id="taom_lotr_issue_raid_title" text="將戰火燒向敵境" />
    <string id="taom_lotr_issue_raid_desc" text="一位領主希望有人襲擾敵人的領地，並消滅敵軍的劫掠隊。" />
    <string id="taom_lotr_issue_raid_brief" text="是時候讓敵人在自己的土地上嚐嚐戰爭的滋味了。追上他的劫掠隊，把他們消滅，讓恐懼籠罩他的領地。" />
    <string id="taom_lotr_issue_raid_accept" text="我該在哪裏進攻？" />
    <string id="taom_lotr_issue_raid_expl" text="擊敗在他邊境一帶活動的敵軍。讓他的領地流血，你就能得到豐厚的報酬。" />
    <string id="taom_lotr_issue_raid_soln" text="我會把戰火帶到他們那裏。" />
    <string id="taom_lotr_issue_scout_title" text="查明敵情" />
    <string id="taom_lotr_issue_scout_desc" text="一位領主需要有人擊潰敵軍巡邏隊，讓他的斥候能夠查明邊境的情況。" />
    <string id="taom_lotr_issue_scout_brief" text="敵人的巡邏隊在邊境來回活動，讓我沒法掌握他的動向。打垮他們，讓我的斥候看清局勢，我才知道該往哪裏進攻。" />
    <string id="taom_lotr_issue_scout_accept" text="他的巡邏隊在哪裏活動？" />
    <string id="taom_lotr_issue_scout_expl" text="擊敗封鎖邊境的敵軍巡邏隊，讓我的斥候能夠通過。辦成這件事，你會得到報酬。" />
    <string id="taom_lotr_issue_scout_soln" text="我會清除邊境的敵軍。" />
    <string id="taom_lotr_issue_knight_title" text="勇士的信物" />
    <string id="taom_lotr_issue_knight_desc" text="一位女貴族希望有人佩戴她的信物，在比武場上獲勝。" />
    <string id="taom_lotr_issue_knight_brief" text="我希望有位勇士佩戴我的信物參加競技大賽，以我的名義贏得榮耀。只要你在比武場上獲勝，我就會一直記得這份恩情。" />
    <string id="taom_lotr_issue_knight_accept" text="你想讓我替你出戰比武場？" />
    <string id="taom_lotr_issue_knight_expl" text="佩戴我的信物贏得競技大賽，榮耀就屬於我們兩人。你會因爲這場勝利得到獎賞。" />
    <string id="taom_lotr_issue_knight_soln" text="我會爲你贏得勝利。" />
    <string id="taom_lotr_issue_tutor_title" text="繼承人的教育" />
    <string id="taom_lotr_issue_tutor_desc" text="一位領主需要精美布料和其他物品，爲繼承人的求學生活備齊體面的衣裝與用具。" />
    <string id="taom_lotr_issue_tutor_brief" text="我的繼承人得接受符合家族身份的教育，體面的衣服和學習用具一樣都不能少。把需要的東西帶來，那孩子就什麼也不缺了。" />
    <string id="taom_lotr_issue_tutor_accept" text="我需要帶什麼來？" />
    <string id="taom_lotr_issue_tutor_expl" text="給我帶來{COUNT}匹天鵝絨，讓我的繼承人穿得像個領主該有的樣子。我會給你豐厚的報酬。" />
    <string id="taom_lotr_issue_tutor_soln" text="我會爲你的繼承人備齊所需物品。" />
    <string id="taom_lotr_issue_tutor_task" text="交付精美布料（{COUNT}）" />
    <string id="taom_lotr_issue_training_title" text="讓扈從經受戰火" />
    <string id="taom_lotr_issue_training_desc" text="一位地主想讓缺乏經驗的扈從在實戰中接受磨鍊。" />
    <string id="taom_lotr_issue_training_brief" text="我的扈從太嬌弱，也沒打過仗，這樣的人第一次上戰場就會送命。帶他們去對付真正的敵人，把他們練成能打硬仗的士兵。" />
    <string id="taom_lotr_issue_training_accept" text="你想讓他們見識真正的戰鬥？" />
    <string id="taom_lotr_issue_training_expl" text="打贏幾場硬仗，教會我的扈從怎麼作戰。把他們練得堅強些，你就能拿到這份教學的報酬。" />
    <string id="taom_lotr_issue_training_soln" text="我會把他們訓練成士兵。" />
    <string id="taom_lotr_issue_inn_title" text="受騙後的怒火" />
    <string id="taom_lotr_issue_inn_desc" text="一位當地的顯要人物被騙子騙走了財產，希望有人狠狠教訓他們。" />
    <string id="taom_lotr_issue_inn_brief" text="一幫騙子和老千用做過手腳的骰子和假文書騙走了我的財產。替我收拾他們，我或許還能在鎮上抬起頭來做人。" />
    <string id="taom_lotr_issue_inn_accept" text="誰騙了你？" />
    <string id="taom_lotr_issue_inn_expl" text="找到那些騙子，給他們一個忘不了的教訓。我會盡我所能報答你。" />
    <string id="taom_lotr_issue_inn_soln" text="我會替你算這筆賬。" />
    <string id="taom_lotr_issue_feud_title" text="多年的仇怨" />
    <string id="taom_lotr_issue_feud_desc" text="一場積怨已演變成流血衝突，一位領主希望有人擊潰敵對勢力的武裝人員。" />
    <string id="taom_lotr_issue_feud_brief" text="我的家族和另一個家族結怨多年，仇恨很深，如今已經動了刀劍。打敗他們的武裝人員，這場恩怨或許就能了結。" />
    <string id="taom_lotr_issue_feud_accept" text="你和誰有仇？" />
    <string id="taom_lotr_issue_feud_expl" text="擊敗對方的人馬，用武力了結這場仇怨。辦成了，我的家族就欠你一份人情。" />
    <string id="taom_lotr_issue_feud_soln" text="我會了結這場仇怨。" />
    <string id="taom_lotr_issue_daughter_title" text="被綁走的女兒" />
    <string id="taom_lotr_issue_daughter_desc" text="一位當地顯要人物的女兒被幫派綁走，家人希望有人將她救回。" />
    <string id="taom_lotr_issue_daughter_brief" text="我的女兒！旅人，他們抓走了我的女兒，還要我付一筆根本拿不出的贖金。打垮那羣混蛋，把她帶回家吧。" />
    <string id="taom_lotr_issue_daughter_accept" text="她被關在哪裏？" />
    <string id="taom_lotr_issue_daughter_expl" text="找到抓走我女兒的那夥人，把他們打垮。只要把她平安帶回家，我願意拿出所有能拿得出的東西來報答你。" />
    <string id="taom_lotr_issue_daughter_soln" text="我會把她帶回家。" />
    <string id="taom_lotr_issue_betting_title" text="穩贏的賭注" />
    <string id="taom_lotr_issue_betting_desc" text="一個幫派頭目在競技大賽上下了重注，需要一名鬥士幫他贏下賭注。" />
    <string id="taom_lotr_issue_betting_brief" text="我在下一場競技大賽上押了一大筆錢，而我不喜歡輸。替我贏下來，贏來的錢有你一大份。" />
    <string id="taom_lotr_issue_betting_accept" text="你想讓我贏下競技大賽？" />
    <string id="taom_lotr_issue_betting_expl" text="贏下一場競技大賽，讓我的賭注賺到錢。拿下冠軍，我會從贏來的錢裏好好酬謝你。" />
    <string id="taom_lotr_issue_betting_soln" text="我會幫你贏下賭注。" />
    <string id="taom_lotr_issue_special_title" text="鍛爐需要鐵料" />
    <string id="taom_lotr_issue_special_desc" text="一個幫派頭目需要上好的鐵料，來鍛造一批特製刀劍。" />
    <string id="taom_lotr_issue_special_brief" text="我要打一批刀劍，得是真正的好刀劍，不是我手下拿的那些破爛。這就得用好鐵。把鐵料弄來，我會讓鐵匠開工。" />
    <string id="taom_lotr_issue_special_accept" text="需要多少鐵？" />
    <string id="taom_lotr_issue_special_expl" text="給我弄來{COUNT}塊上好的鐵錠用於鍛造，你就有錢拿。至於刀劍，那是我的事。" />
    <string id="taom_lotr_issue_special_soln" text="我會給你弄來鐵料。" />
    <string id="taom_lotr_issue_special_task" text="交付鐵錠（{COUNT}）" />
    <string id="taom_lotr_issue_fallback_title" text="請求援助" />
    <string id="taom_lotr_issue_fallback_desc" text="一位當地居民需要有人送來貨物。" />
    <string id="taom_lotr_issue_fallback_brief" text="旅人，我們需要幫助。" />
    <string id="taom_lotr_issue_fallback_accept" text="我能幫什麼忙？" />
    <string id="taom_lotr_issue_fallback_expl" text="把我們需要的{ITEM}帶來，數量是{COUNT}，我們就有救了。" />
    <string id="taom_lotr_issue_fallback_soln" text="我會帶來你們需要的東西。" />
    <string id="taom_lotr_issue_common_accepted" text="將{ITEM}（{COUNT}）送到{QUEST_SETTLEMENT}。" />
    <string id="taom_lotr_issue_common_ready" text="你已備齊任務所需的物品，返回{QUEST_SETTLEMENT}交付即可。" />
    <string id="taom_lotr_issue_common_cancel" text="約定已取消。" />
    <string id="taom_lotr_issue_common_timeout" text="你未能及時交付貨物。" />
    <string id="taom_lotr_issue_common_offer_accept" text="謝謝你。我不會忘記這份恩情。" />
    <string id="taom_lotr_issue_common_have_you" text="你帶來我們需要的東西了嗎？" />
