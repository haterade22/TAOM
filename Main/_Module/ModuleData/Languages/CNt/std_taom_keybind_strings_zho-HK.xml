<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema"
      type="string">
  <tags>
    <tag language="Traditional Chinese" />
  </tags>
  <strings>
    <string id="taom_key_fast_forward" text="快進（TAOM）" />
    <string id="taom_key_fast_forward_desc" text="套用 TAOM 的快進速度倍率。預設與原版的暫停切換共用同一按鍵，這是刻意設計的。" />
    <string id="taom_key_extra_fast_forward" text="超級快進（TAOM）" />
    <string id="taom_key_extra_fast_forward_desc" text="套用更高的 TAOM 快進倍率。預設為 E 鍵，該鍵同時也是「向右旋轉鏡頭」；請重新綁定其中之一，以避免兩者同時觸發。" />
    <string id="taom_key_turbo" text="渦輪時間，按住 Ctrl（TAOM）" />
    <string id="taom_key_turbo_desc" text="同時按住 Ctrl 與此鍵，可獲得最高的 TAOM 速度倍率。放開任一按鍵即恢復先前的速度。" />
  </strings>
</base>
