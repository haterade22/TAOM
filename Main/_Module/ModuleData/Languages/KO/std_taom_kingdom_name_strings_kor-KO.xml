      xmlns:xsd="http://www.w3.org/2001/XMLSchema"
      type="string">
  <tags>
    <tag language="Korean" />
  </tags>
  <strings>
    <string id="taom_bluecraig_desc" text="머나먼 서쪽, 청색산맥(에레드 루인)에 있는 블루 크레이그의 고블린 굴이다. 린돈의 회색항구와 맞닿아 있으며, 안개산맥의 고블린 마을에 사는 사촌들과는 별개인 헤아릴 수 없는 고블린 무리가 서쪽 암벽을 뒤덮고 서쪽 해안의 요정들을 괴롭힌다." />
    <string id="taom_bluecraig_name" text="블루 크레이그의 고블린" />
    <string id="taom_bluecraig_ruler_title" text="대고블린" />
    <string id="taom_bluecraig_short_name" text="블루 크레이그" />
    <string id="taom_bluecraig_title" text="블루 크레이그 고블린 왕국" />
    <string id="taom_dolguldur_desc" text="그림자와 절망의 요새 돌 굴두르는 강령술사의 어두운 뜻을 알리는 불길한 봉화처럼 서 있다. 그 깊은 곳에 사는 오르크와 흉악한 존재들은 모든 이의 가슴에 두려움을 심는다." />
    <string id="taom_dolguldur_name" text="돌 굴두르" />
    <string id="taom_dolguldur_ruler_title" text="공포의 군주" />
    <string id="taom_dolguldur_short_name" text="돌 굴두르" />
    <string id="taom_dolguldur_title" text="돌 굴두르의 강령술" />
    <string id="taom_erebor_desc" text="외로운산 에레보르는 북방 최대의 난쟁이 왕국이다. 황금과 미스릴이 넘쳐나며 두린 가문의 고향이다. 에레보르의 난쟁이들은 이름난 장인이자 용맹한 전사들로, 그들의 광장에는 조상들의 노래가 울려 퍼진다." />
    <string id="taom_erebor_name" text="에레보르" />
    <string id="taom_erebor_ruler_title" text="왕" />
    <string id="taom_erebor_short_name" text="에레보르" />
    <string id="taom_erebor_title" text="에레보르 왕국" />
    <string id="taom_goblin_desc" text="높은 고개의 고블린들은 안개산맥 아래의 굴을 가득 메우고 있으니, 한때 대(大)고블린이 드워프와 나그네를 가리지 않고 이끌고 나섰던 무리의 후손들이다. 수를 헤아릴 수 없고 잔악한 그들은 고블린 마을에서 쏟아져 나와 산길을 약탈한다." />
    <string id="taom_goblin_name" text="고블린" />
    <string id="taom_goblin_ruler_title" text="대고블린" />
    <string id="taom_goblin_short_name" text="고블린" />
    <string id="taom_goblin_title" text="높은 고개의 고블린 영역" />
    <string id="taom_gundabad_desc" text="군다바드는 오크들의 고대하고 불길한 요새로, 야만과 지배의 보루로 서 있다. 전쟁과 혼돈을 위해 길러진 군다바드의 오크들은 피 묻은 깃발 아래 모여든다." />
    <string id="taom_gundabad_name" text="군다바드" />
    <string id="taom_gundabad_ruler_title" text="전쟁군주" />
    <string id="taom_gundabad_short_name" text="군다바드" />
    <string id="taom_gundabad_title" text="군다바드" />
    <string id="taom_isengard_desc" text="아이센가드는 백색의 마법사 사루만의 요새로, 권력과 야망의 보루로 서 있다. 우루크하이는 하얀 손의 깃발 아래 진군하며, 그 규율과 잔악함은 견줄 자가 없다." />
    <string id="taom_isengard_name" text="아이센가드" />
    <string id="taom_isengard_ruler_title" text="전쟁군주" />
    <string id="taom_isengard_short_name" text="아이센가드" />
    <string id="taom_isengard_title" text="아이센가드 대군주령" />
    <string id="taom_lindon_desc" text="청색산맥 서쪽의 푸른 땅 린돈은 가운데땅의 해안에 남은 높은요정들의 마지막 왕국이다. 미슬론드의 회색항구에서 흰 배들이 서쪽으로 떠나가고, 조선공 키르단은 엘다르의 저물어 가는 빛을 지켜본다." />
    <string id="taom_lindon_name" text="린돈" />
    <string id="taom_lindon_ruler_title" text="항구의 군주" />
    <string id="taom_lindon_short_name" text="린돈" />
    <string id="taom_lindon_title" text="린돈 대왕국" />
    <string id="taom_lothlorien_desc" text="황금숲은 은물길과 대하 안두인 사이에 자리하고 있다. 갈라드리엘과 켈레보른의 의지로 수호되는 이곳은 요정의 우아함과 저항의 보루로서, 시간이 닿지 않아 잎이 떨어지지 않는 땅이다." />
    <string id="taom_lothlorien_name" text="로슬로리엔" />
    <string id="taom_lothlorien_ruler_title" text="귀부인" />
    <string id="taom_lothlorien_short_name" text="로슬로리엔" />
    <string id="taom_lothlorien_title" text="로슬로리엔 왕국" />
    <string id="taom_mirkwood_desc" text="어둠숲의 삼림 왕국은 오랜 세월 많은 고난을 견뎌 왔다. 스란두일의 통치 아래 숲요정들은 은둔하며 이방인을 경계하게 되었다. 그러나 스란두일의 마음속에는 제1시대의 옛날에 불붙은 불길이 아직 남아 있다." />
    <string id="taom_mirkwood_name" text="라스갈렌" />
    <string id="taom_mirkwood_ruler_title" text="아란" />
    <string id="taom_mirkwood_short_name" text="어둠숲" />
    <string id="taom_mirkwood_title" text="어둠숲 왕국" />
    <string id="taom_mistymountainorcs_desc" text="안개산맥의 오크 무리는 그람산에서 모리아의 문에 이르는 고지와 깊은 굴을 차지하고 있다. 차가운 봉우리에서 전쟁을 위해 길러진 그들은 암흑의 부름에 응하며 산맥을 제 것으로 되찾기를 갈망한다." />
    <string id="taom_mistymountainorcs_name" text="안개산맥 오크" />
    <string id="taom_mistymountainorcs_ruler_title" text="전쟁군주" />
    <string id="taom_mistymountainorcs_short_name" text="안개 오크" />
    <string id="taom_mistymountainorcs_title" text="안개산맥의 오크 무리" />
    <string id="taom_rivendell_desc" text="안개산맥의 깊은 협곡에 숨겨진 리븐델은 바다 동쪽 마지막 안식처다. 반요정 엘론드가 세운 이곳은 몰려드는 어둠에 맞선 피난처이며, 치유와 학문, 조용한 힘의 장소이다." />
    <string id="taom_rivendell_name" text="임라드리스" />
    <string id="taom_rivendell_ruler_title" text="군주" />
    <string id="taom_rivendell_short_name" text="임라드리스" />
    <string id="taom_rivendell_title" text="임라드리스의 안식처" />
    <string id="taom_umbar_desc" text="코르세어의 어두운 항구 움바르는 해상 세력과 음험한 야망이 깊이 스며든 나라이다. 코르세어들은 가운데땅의 해안을 습격하며, 빠른 배로 공포를 퍼뜨린다." />
    <string id="taom_umbar_name" text="움바르" />
    <string id="taom_umbar_ruler_title" text="코르세어 왕" />
    <string id="taom_umbar_short_name" text="움바르" />
    <string id="taom_umbar_title" text="움바르의 항구" />
    <string id="taom_arthedain_desc" text="아르노르가 셋으로 갈라져 생긴 세 왕국 중 마지막으로 남은 아르세다인은 아직 무너지지 않았다. 아르베두이의 혈통은 여전히 북구릉 위의 포르노스트를 지키고 있으나, 영주는 적고 도시는 가난하며, 앙마르의 그림자는 언제나 북쪽 언덕에 드리워져 있다." />
    <string id="taom_arthedain_name" text="아르세다인" />
    <string id="taom_arthedain_ruler_title" text="왕" />
    <string id="taom_arthedain_short_name" text="아르세다인" />
    <string id="taom_arthedain_title" text="아르세다인 북왕국" />
    <string id="taom_cardolan_desc" text="아르노르가 갈라져 생긴 세 왕국 중 남쪽의 나라. 그 왕들은 튀른 고르사드의 고분에 잠들어 있고, 기병들은 바란두인과 회색강 사이의 평원을 지킨다. 그러나 성읍은 적고, 영주들은 아르세다인과 루다우르를 상대로 아르노르의 왕관을 두고 다툰다." />
    <string id="taom_cardolan_name" text="카르돌란" />
    <string id="taom_cardolan_ruler_title" text="왕" />
    <string id="taom_cardolan_short_name" text="카르돌란" />
    <string id="taom_cardolan_title" text="카르돌란 왕국" />
    <string id="taom_rhudaur_desc" text="아르노르가 갈라져 생긴 세 왕국 중 동쪽의 나라로, 흰샘강과 큰물소리강 사이의 구릉 왕국이다. 두네다인 영주들은 카메스 브린과 앙글을 지키며 거친 구릉민들을 다스리고, 황야에는 트롤이, 모든 고갯길에는 오크가 있다." />
    <string id="taom_rhudaur_name" text="루다우르" />
    <string id="taom_rhudaur_ruler_title" text="왕" />
    <string id="taom_rhudaur_short_name" text="루다우르" />
    <string id="taom_rhudaur_title" text="루다우르 왕국" />
    <string id="taom_eredluin_desc" text="청색산맥의 난쟁이 왕국. 두린의 일족은 유랑 중에 그곳에 소린의 전당을 세웠고, 이 시대에는 넓은허리족과 불꽃수염족이 다시 벨레고스트와 노그로드를 차지하고 있다. 영주는 적고 그 전당들은 동쪽 친족의 것보다 가난하지만, 그 대장장이들은 서부에서 가장 오래되었고, 그 도끼들은 푸른바위의 고블린들을 린돈으로 가는 길에서 막아낸다." />
    <string id="taom_eredluin_name" text="에레드 루인" />
    <string id="taom_eredluin_ruler_title" text="왕" />
    <string id="taom_eredluin_short_name" text="에레드 루인" />
    <string id="taom_eredluin_title" text="에레드 루인 왕국" />
    <string id="taom_anduinvale_desc" text="베오른족과 계곡의 숲사람들은 안개산맥과 어둠숲 사이의 안두인 상류를 차지하고 있다. 그들은 높은 고개와 옛 여울목을 정직한 나그네들에게 열어 두며, 오르크와 늑대에게 혹독한 대가를 치르게 한다. 그들의 족장들은 베오른의 저택과 카록을 지키며, 왕들의 전쟁에는 끼어들기를 원치 않는다." />
    <string id="taom_anduinvale_name" text="안두인 계곡" />
    <string id="taom_anduinvale_ruler_title" text="족장" />
    <string id="taom_anduinvale_short_name" text="안두인 계곡" />
    <string id="taom_anduinvale_title" text="안두인 계곡" />
    <string id="taom_angaladh_desc" text="어둠숲 서부의 숲사람들은 숲 처마 아래에 터전을 일구고, 숲사람 마을을 둘러싼 무쇠처럼 단단한 나무의 이름을 따 그들의 왕국을 불렀다. 그들은 궁수이자 숲지기이며 수가 적고, 북쪽의 요정들과 평화롭게 지내면서 남쪽의 돌 굴두르를 늘 경계한다." />
    <string id="taom_angaladh_name" text="앙가라드" />
    <string id="taom_angaladh_ruler_title" text="왕" />
    <string id="taom_angaladh_short_name" text="앙가라드" />
    <string id="taom_angaladh_title" text="앙갈라드 왕국" />
    <string id="taom_dorwinion_desc" text="도르위니온의 포도주 장인들은 달리는 강이 룬 내해와 만나는 따뜻한 비탈을 가꾼다. 그들의 포도주는 강을 거슬러 너른골로, 어둠숲의 요정들에게로, 그리고 값을 치를 수 있는 모든 저택으로 올라가며, 그 왕들은 그것으로 부유해진다. 그들은 서부의 전쟁에서 비켜서고, 필요하다면 동부로부터 평화를 사들인다." />
    <string id="taom_dorwinion_name" text="도르위니온" />
    <string id="taom_dorwinion_ruler_title" text="왕" />
    <string id="taom_dorwinion_short_name" text="도르위니온" />
    <string id="taom_dorwinion_title" text="도르위니온 왕국" />
    <string id="taom_southrhovanion_desc" text="남부 로바니온의 북부인들은 어둠숲 남쪽 처마와 룬 내해 사이의 너른 평원을 달린다. 그들은 오래전 북으로 떠난 에오세오드의 친족인 기마 영주들이며, 한때 자신들의 전당을 불태운 마차몰이족을 잊지 않았다. 그 왕들은 비두가르드를 지키며 서부에도 동부에도 복종하지 않는다." />
    <string id="taom_southrhovanion_name" text="남부 로바니온" />
    <string id="taom_southrhovanion_ruler_title" text="왕" />
    <string id="taom_southrhovanion_short_name" text="남부 로바니온" />
    <string id="taom_southrhovanion_title" text="남부 로바니온 왕국" />
  </strings>
</base>
