  <strings>
    <string id="taom_send_messenger" text="전령 보내기" />
    <string id="taom_messenger_target_unavailable" text="이 사람은 현재 전령으로 연락할 수 없습니다." />
    <string id="taom_messenger_disabled" text="전령 시스템이 설정에서 비활성화되어 있습니다." />
    <string id="taom_messenger_not_available" text="전령 시스템을 사용할 수 없습니다." />
    <string id="taom_messenger_invalid_target" text="유효하지 않은 대상입니다." />
    <string id="taom_messenger_cannot_send" text="전령을 보낼 수 없습니다" />
    <string id="taom_messenger_no_gold" text="금화가 부족합니다! {COST} 데나르가 필요합니다." />
    <string id="taom_messenger_already_sent" text="이미 이 사람에게 전령이 파견되었습니다." />
    <string id="taom_messenger_hero_dead" text="{HERO_NAME}은(는) 사망했습니다." />
    <string id="taom_messenger_hero_prisoner" text="{HERO_NAME}은(는) 투옥되어 전령을 받을 수 없습니다." />
    <string id="taom_messenger_hero_fugitive" text="{HERO_NAME}은(는) 도망자이며 찾을 수 없습니다." />
    <string id="taom_messenger_hero_child" text="{HERO_NAME}은(는) 너무 어려서 전령을 받을 수 없습니다." />
    <string id="taom_messenger_confused" text="전령이 혼란스러워 보입니다 — 당신의 부대에 있는 누군가에게 가려고 했던 것 같습니다!" />
    <string id="taom_messenger_sent" text="{HERO_NAME}에게 전령이 파견되었으며 {DAYS}일 이내에 도착할 것입니다." />
    <string id="taom_messenger_sent_title" text="전령 파견됨" />
    <string id="taom_messenger_arrived" text="{HERO_NAME}의 전령이 도착했습니다. 그들과 대화하시겠습니까?" />
    <string id="taom_messenger_arrived_title" text="전령 도착함" />
    <string id="taom_messenger_speak" text="대화하기" />
    <string id="taom_messenger_dismiss" text="돌려보내기" />
    <string id="taom_messenger_lost" text="{HERO_NAME}에게 보낸 전령이 산적의 습격을 받아 도착하지 못했습니다." />
    <string id="taom_messenger_recipient_gone" text="{HERO_NAME}에게 보낸 전령이 전달하지 못하고 돌아왔습니다 — 수신자에게 더 이상 연락할 수 없습니다." />
    <string id="taom_messenger_lost_title" text="전령 손실" />
    <string id="taom_messenger_error" text="전령 오류" />
    <string id="taom_messenger_dialog_init" text="나중에 당신에게 전갈을 보낼 일이 있을 것 같소. 전령을 보내도 되겠소?" />
    <string id="taom_messenger_dialog_npc_accept" text="물론이오. 전령이 도착하면 반드시 접견하도록 하겠소." />
    <string id="taom_messenger_dialog_send" text="전령 보내기 ({COST} 데나르)" />
    <string id="taom_messenger_dialog_decline" text="다시 생각해보니, 괜찮습니다." />
    <string id="taom_messenger_dialog_decline_ack" text="알겠습니다." />
    <string id="taom_messenger_dialog_sent" text="그럼 당신의 전령을 기다리겠습니다." />
