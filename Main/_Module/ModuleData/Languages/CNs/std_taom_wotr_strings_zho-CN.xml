<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema"
      type="string">
  <tags>
    <tag language="Simplified Chinese" />
  </tags>
  <strings>
    <string id="taom_wotr_title" text="魔戒圣战" />
    <string id="taom_wotr_leaders" text="领袖" />
    <string id="taom_wotr_allies" text="盟友" />
    <string id="taom_wotr_breakdown_header" text="势头细分" />
    <string id="taom_wotr_total_stats_header" text="总计统计" />
    <string id="taom_wotr_total" text="总计: {MOMENTUM}" />
    <string id="taom_wotr_battles_won" text="战斗胜利" />
    <string id="taom_wotr_villages_raided" text="村庄掠夺" />
    <string id="taom_wotr_fiefs_captured" text="领地占领" />
    <string id="taom_wotr_army_gathered" text="军队集结" />
    <string id="taom_wotr_relative_strength" text="相对实力" />
    <string id="taom_wotr_enemies_killed" text="敌人击杀" />
    <string id="taom_wotr_settlements_captured" text="定居点占领" />
    <string id="taom_wotr_momentum" text="势头" />
    <string id="taom_wotr_desc_battle" text="{WINNER_FACTION}的军队在{WINNER_LEADER}率领下,摧毁了由{LOSER_LEADER}率领的{LOSER_FACTION}军队,击杀{CASUALTIES}人。" />
    <string id="taom_wotr_desc_siege" text="{FACTION}的军队在{LEADER}率领下,攻占了{SETTLEMENT}。" />
    <string id="taom_wotr_desc_raid" text="{FACTION}的{PARTY}掠夺了{SETTLEMENT}村庄。" />
    <string id="taom_wotr_desc_army" text="由{LEADER}率领的军队已经集结。" />
    <string id="taom_wotr_desc_strength" text="我们比敌人强大{PERCENTAGE}%!" />
    <string id="taom_wotr_desc_kills" text="我军在战斗中斩杀了 {CASUALTIES} 名敌人。" />
    <string id="taom_wotr_victory_title" text="战争结束" />
    <string id="taom_wotr_victory_free" text="战争结束了。自由人民坚持到了最后,为他们的子孙赢得了未来。自由万岁!" />
    <string id="taom_wotr_victory_evil" text="人类和精灵的领地都已被粉碎。索伦万岁!" />
    <string id="taom_wotr_continue" text="继续" />
    <string id="taom_wotr_chronicle_events" text="编年事件" />
    <string id="taom_wc_siege_lost" text="战局尚未分晓，{TARGET} 已易主。" />
    <string id="taom_wc_fellowship_title" text="魔戒远征队启程" />
    <string id="taom_wc_fellowship_occurred" text="九位行者秘密离开幽谷，携至尊魔戒南行。埃尔隆德的家族正聚集力量。" />
    <string id="taom_wc_khazaddum_title" text="凯萨督姆之桥" />
    <string id="taom_wc_khazaddum_occurred" text="在摩瑞亚的深渊中，灰袍朝圣者与炎魔一同坠落。迷雾山脉的奥克蜂拥而出，自由民族为之哀悼。" />
    <string id="taom_wc_breaking_title" text="远征队的离散" />
    <string id="taom_wc_breaking_occurred" text="在帕斯加兰，乌鲁克族扑向了远征队。波罗米尔为保护霍比特人而死，刚铎失去了它的继承人。" />
    <string id="taom_wc_theoden_title" text="希优顿王" />
    <string id="taom_wc_theoden_occurred" text="摆脱了巧言的蛊惑，希优顿重新执起长剑。骑马国正向他们的国王集结。" />
    <string id="taom_wc_hornburg_title" text="号角堡之战" />
    <string id="taom_wc_hornburg_open" text="艾森加德的大军与登兰德的山地人正向 {TARGET} 进发。此战必须在 {DAYS} 天内分出胜负。" />
    <string id="taom_wc_hornburg_lapsed" text="{TARGET} 未遭进攻。艾森加德的集结转向了别处。" />
    <string id="taom_wc_hornburg_held" text="号角堡坚守了整夜，艾森加德的大军在其城墙下溃散。" />
    <string id="taom_wc_hornburg_fell" text="{TARGET} 陷落，白手统治了西伏尔德。" />
    <string id="taom_wc_ents_title" text="树人的最后一战" />
    <string id="taom_wc_ents_occurred" text="范贡森林的树人冲下艾森加德，淹没了萨鲁曼的坑窟。白手的熔炉就此沉寂。" />
    <string id="taom_wc_lorien_title" text="罗斯洛立安遭袭" />
    <string id="taom_wc_lorien_open" text="黑影自多尔古都出击，袭向黄金森林。{TARGET} 必须坚守 {DAYS} 天。" />
    <string id="taom_wc_lorien_lapsed" text="多尔古都的军队始终未能抵达 {TARGET}。" />
    <string id="taom_wc_lorien_held" text="夫人的力量屹立不摇，多尔古都的大军从黄金森林退却。" />
    <string id="taom_wc_lorien_fell" text="{TARGET} 陷入火海，罗斯洛立安的光辉日渐黯淡。" />
    <string id="taom_wc_osgiliath_title" text="奥斯吉利亚斯的陷落" />
    <string id="taom_wc_osgiliath_open" text="魔窟大军渡过安都因河，直扑 {TARGET}。刚铎必须守住这座废墟之城 {DAYS} 天。" />
    <string id="taom_wc_osgiliath_lapsed" text="魔多未曾进攻 {TARGET}，大河依旧平静。" />
    <string id="taom_wc_osgiliath_held" text="法拉米尔守住了安都因河的渡口，魔窟大军退了回去。" />
    <string id="taom_wc_osgiliath_fell" text="{TARGET} 陷落，通往米那斯提力斯的道路已然敞开。" />
    <string id="taom_wc_dale_title" text="河谷邦之战" />
    <string id="taom_wc_dale_open" text="东夷人与多尔古都的爪牙进军河谷邦王国。{TARGET} 必须坚守 {DAYS} 天。" />
    <string id="taom_wc_dale_lapsed" text="东方人转道而去，{TARGET}得以幸免。" />
    <string id="taom_wc_dale_held" text="河谷邦的人类与孤山的矮人并肩而战，东方人的大军被击退。" />
    <string id="taom_wc_dale_fell" text="{TARGET}陷落于东方人之手，孤山的矮人出兵驰援他们的友邦。" />
    <string id="taom_wc_corsairs_title" text="乌姆巴尔的海盗" />
    <string id="taom_wc_corsairs_open" text="乌姆巴尔的黑帆沿安都因河逆流而上，直逼{TARGET}。刚铎必须守住此港{DAYS}天。" />
    <string id="taom_wc_corsairs_lapsed" text="海盗们逗留海上，{TARGET}安然无事。" />
    <string id="taom_wc_corsairs_held" text="乌姆巴尔的舰队被逐出{TARGET}，刚铎南方诸封邑士气大振。" />
    <string id="taom_wc_corsairs_fell" text="海盗夺取了{TARGET}，他们的船只控制了大河。" />
    <string id="taom_wc_north_title" text="北方之战" />
    <string id="taom_wc_north_open" text="刚达巴德的半兽人与登兰德的山民南下侵袭北方。{TARGET}必须坚守{DAYS}天。" />
    <string id="taom_wc_north_lapsed" text="北方的战火绕过了{TARGET}。" />
    <string id="taom_wc_north_held" text="游侠与阿塞丹的人类守住了{TARGET}，北方依旧自由。" />
    <string id="taom_wc_north_fell" text="{TARGET}陷落，阴影蔓延至整个伊利雅德。" />
    <string id="taom_wc_gondor_title" text="刚铎之围" />
    <string id="taom_wc_gondor_open" text="戒灵之王率魔多大军进攻{TARGET}。此城必须坚守{DAYS}天。" />
    <string id="taom_wc_gondor_lapsed" text="魔多的大军按兵不动，{TARGET}在昏暗的天穹下等待着。" />
    <string id="taom_wc_gondor_held" text="洛汗骑兵黎明时分赶到，{TARGET}之围在佩兰诺平原上被击破。" />
    <string id="taom_wc_gondor_fell" text="{TARGET}的城门被攻破，白城落入魔多之手。" />
    <string id="taom_wc_blackgate_title" text="黑门开启" />
    <string id="taom_wc_blackgate_occurred" text="西方的众将领进军莫拉农，欲将那只眼睛的注意力从持戒人身上引开。战争的命运如今系于魔戒。" />
  </strings>
</base>
