  <strings>
    <string id="taom_wotr_title" text="魔戒大战" />
    <string id="taom_wotr_leaders" text="领袖" />
    <string id="taom_wotr_allies" text="盟友" />
    <string id="taom_wotr_breakdown_header" text="战局优势明细" />
    <string id="taom_wotr_total_stats_header" text="战果总计" />
    <string id="taom_wotr_total" text="总计：{MOMENTUM}" />
    <string id="taom_wotr_battles_won" text="获胜场次" />
    <string id="taom_wotr_villages_raided" text="劫掠村庄数" />
    <string id="taom_wotr_fiefs_captured" text="攻占封地数" />
    <string id="taom_wotr_army_gathered" text="集结军团数" />
    <string id="taom_wotr_relative_strength" text="相对实力" />
    <string id="taom_wotr_enemies_killed" text="杀敌数" />
    <string id="taom_wotr_settlements_captured" text="攻占聚落数" />
    <string id="taom_wotr_momentum" text="战局优势" />
    <string id="taom_wotr_desc_battle" text="{WINNER_LEADER}率领的{WINNER_FACTION}军团击溃了{LOSER_LEADER}率领的{LOSER_FACTION}军团，杀敌{CASUALTIES}人。" />
    <string id="taom_wotr_desc_siege" text="{LEADER}率领的{FACTION}军团攻占了{SETTLEMENT}。" />
    <string id="taom_wotr_desc_raid" text="{FACTION}的{PARTY}劫掠了{SETTLEMENT}村。" />
    <string id="taom_wotr_desc_army" text="{LEADER}率领的军团已经集结。" />
    <string id="taom_wotr_desc_strength" text="我方实力比敌人高出{PERCENTAGE}%！" />
    <string id="taom_wotr_desc_kills" text="我军在战斗中击杀了{CASUALTIES}名敌人。" />
    <string id="taom_wotr_victory_title" text="战争结束" />
    <string id="taom_wotr_victory_free" text="战争结束了。自由人民坚持到底，为子孙赢得了未来。自由万岁！" />
    <string id="taom_wotr_victory_evil" text="人类与精灵的国度都已覆灭。索隆万岁！" />
    <string id="taom_wotr_continue" text="继续" />
    <string id="taom_wotr_chronicle_events" text="战事纪要" />
    <string id="taom_wc_siege_lost" text="战斗尚未分出胜负，{TARGET}便已易手。" />
    <string id="taom_wc_fellowship_title" text="远征队启程" />
    <string id="taom_wc_fellowship_occurred" text="九位行者秘密离开幽谷，携至尊魔戒南下。埃尔隆德家族正在集结力量。" />
    <string id="taom_wc_khazaddum_title" text="卡扎督姆之桥" />
    <string id="taom_wc_khazaddum_occurred" text="在摩瑞亚的深处，灰袍朝圣者与炎魔一同坠落。迷雾山脉的奥克蜂拥而出，自由人民为之哀悼。" />
    <string id="taom_wc_breaking_title" text="远征队的分裂" />
    <string id="taom_wc_breaking_occurred" text="在帕斯嘉伦，乌鲁克扑向远征队。波洛米尔为保护霍比特人而死，刚铎失去了它的继承人。" />
    <string id="taom_wc_theoden_title" text="希奥顿国王" />
    <string id="taom_wc_theoden_occurred" text="摆脱了巧言的谗言，希奥顿重新握起他的剑。里德马克向国王集结。" />
    <string id="taom_wc_hornburg_title" text="号角堡之战" />
    <string id="taom_wc_hornburg_open" text="艾森加德的大军与黑蛮地的山地人正向{TARGET}进军。这场战斗必须在{DAYS}天内决出胜负。" />
    <string id="taom_wc_hornburg_lapsed" text="没有攻势降临{TARGET}。艾森加德的集结转向了别处。" />
    <string id="taom_wc_hornburg_held" text="号角堡坚守了整整一夜，艾森加德的大军在城墙前溃散。" />
    <string id="taom_wc_hornburg_fell" text="{TARGET}陷落，白手统治了西伏尔德。" />
    <string id="taom_wc_ents_title" text="树人的最后进军" />
    <string id="taom_wc_ents_occurred" text="范贡森林的树人冲下艾森加德，淹没了萨茹曼的深坑。白手的熔炉归于沉寂。" />
    <string id="taom_wc_lorien_title" text="洛丝罗瑞恩遇袭" />
    <string id="taom_wc_lorien_open" text="黑影自多古尔都而出，进攻金色森林。{TARGET}必须坚守{DAYS}天。" />
    <string id="taom_wc_lorien_lapsed" text="多古尔都的军队始终未能抵达{TARGET}。" />
    <string id="taom_wc_lorien_held" text="夫人的力量支撑住了，多古尔都的大军自金色森林退却。" />
    <string id="taom_wc_lorien_fell" text="{TARGET}陷入火海，洛丝罗瑞恩的光芒逐渐黯淡。" />
    <string id="taom_wc_osgiliath_title" text="欧斯吉利亚斯的陷落" />
    <string id="taom_wc_osgiliath_open" text="魔窟大军渡过安都因河，直取{TARGET}。刚铎必须守住这座废城{DAYS}天。" />
    <string id="taom_wc_osgiliath_lapsed" text="魔多没有进犯{TARGET}，河上依旧平静。" />
    <string id="taom_wc_osgiliath_held" text="法拉米尔守住了安都因河的渡口，魔窟大军退了回去。" />
    <string id="taom_wc_osgiliath_fell" text="{TARGET}陷落，通往米那斯提力斯的道路敞开了。" />
    <string id="taom_wc_dale_title" text="河谷邦之战" />
    <string id="taom_wc_dale_open" text="东夷与多古尔都仆从进军河谷邦王国。{TARGET}必须坚守{DAYS}天。" />
    <string id="taom_wc_dale_lapsed" text="东夷转道而去，{TARGET}得以幸免。" />
    <string id="taom_wc_dale_held" text="河谷邦的人类与孤山矮人并肩而战，东夷大军被击退。" />
    <string id="taom_wc_dale_fell" text="{TARGET}落入东夷之手，孤山矮人出兵驰援他们的朋友。" />
    <string id="taom_wc_corsairs_title" text="乌姆巴尔的海盗" />
    <string id="taom_wc_corsairs_open" text="乌姆巴尔的黑帆逆安都因河而上，直逼{TARGET}。刚铎必须守住这座港口{DAYS}天。" />
    <string id="taom_wc_corsairs_lapsed" text="海盗在海上徘徊不前，{TARGET}得享安宁。" />
    <string id="taom_wc_corsairs_held" text="乌姆巴尔的舰队被逐出{TARGET}，刚铎南方的封邑士气大振。" />
    <string id="taom_wc_corsairs_fell" text="海盗夺取了{TARGET}，他们的船只控制了河道。" />
    <string id="taom_wc_north_title" text="北方的战争" />
    <string id="taom_wc_north_open" text="贡达巴德的奥克与黑蛮地的山地人南下进犯北方。{TARGET}必须坚守{DAYS}天。" />
    <string id="taom_wc_north_lapsed" text="北方的战火绕过了{TARGET}。" />
    <string id="taom_wc_north_held" text="游民与阿塞丹的人类守住了{TARGET}，北方依然自由。" />
    <string id="taom_wc_north_fell" text="{TARGET}陷落了，阴影蔓延至整个埃利阿多。" />
    <string id="taom_wc_gondor_title" text="刚铎之围" />
    <string id="taom_wc_gondor_open" text="纳兹古尔之王率领魔多的大军进攻{TARGET}。此城必须坚守{DAYS}天。" />
    <string id="taom_wc_gondor_lapsed" text="魔多的大军按兵不动，{TARGET}在昏暗的天穹下静候。" />
    <string id="taom_wc_gondor_held" text="洛希尔人于拂晓驰援，{TARGET}之围在佩兰诺平野上被击破。" />
    <string id="taom_wc_gondor_fell" text="{TARGET}的城门被攻破，白城落入魔多之手。" />
    <string id="taom_wc_blackgate_title" text="黑门开启" />
    <string id="taom_wc_blackgate_occurred" text="西方众将向莫拉农进军，要将那只眼从持戒人身上引开。战争的命运如今系于魔戒。" />
    <string id="taom_wc_hornburg_fate" text="艾森加德的大军彻夜强攻{TARGET}，黎明时分，号角堡仍然屹立。" />
    <string id="taom_event_category_chronicle" text="战争纪事" />
    <string id="taom_event_category_coronation" text="加冕" />
    <string id="taom_event_effects" text="效果" />
    <string id="taom_event_effect_days" text="持续{DAYS}天" />
    <string id="taom_event_side_free" text="自由人民" />
    <string id="taom_event_side_evil" text="阴影一方" />
    <string id="taom_event_effect_volunteers" text="志愿兵征募率" />
    <string id="taom_event_effect_escape" text="额外逃脱判定" />
    <string id="taom_event_effect_momentum" text="魔戒大战态势" />
    <string id="taom_event_effect_note" text="所示数值为本事件在上限之前的贡献量，且上限对单一效果同样适用。你自己氏族的领地和领主永不受影响。" />
    <string id="taom_event_effect_escape_note" text="额外逃脱判定的概率为领主通常逃脱概率的所示百分比。" />
  </strings>
</base>
