    <string id="taom_enlist_duty_recruitment_errand_failure" text="这村子该出的儿郎，已经都出了。" />
    <string id="taom_enlist_duty_trusted_dispatch_success" text="急件送到了该到的手里，再无旁人。" />
    <string id="taom_enlist_duty_trusted_dispatch_failure" text="急件迟到了，你也不敢断言它未被拆看。" />
    <string id="taom_enlist_duty_relief_dispatch_success" text="消息及时传到了。" />
    <string id="taom_enlist_duty_relief_dispatch_failure" text="你到了。消息比你更早到。" />
    <string id="taom_enlist_duty_supply_delivery_success" text="车轻了，仓满了。" />
