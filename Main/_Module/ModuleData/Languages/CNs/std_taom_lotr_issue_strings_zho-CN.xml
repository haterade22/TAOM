<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xsd="http://www.w3.org/2001/XMLSchema"
      type="string">
  <tags>
    <tag language="Simplified Chinese" />
  </tags>
  <strings>
    <string id="taom_lotr_issue_grain_title" text="{ISSUE_SETTLEMENT}需要粮种" />
    <string id="taom_lotr_issue_grain_desc" text="{ISSUE_SETTLEMENT}的居民失去了粮种。如果不能及时播种，他们就要挨饿了。" />
    <string id="taom_lotr_issue_grain_brief" text="旅人，黑暗笼罩下的日子可不好过。鼠患和严冬毁掉了我们的粮种。没有粮食播种，我们就撑不过这一年。" />
    <string id="taom_lotr_issue_grain_accept" text="难道没有办法了吗？" />
    <string id="taom_lotr_issue_grain_expl" text="如果你能带来{COUNT}份粮食，我们就能赶在换季前播种。我们自己实在买不起这么多。" />
    <string id="taom_lotr_issue_grain_soln" text="我会为你们找来粮食。" />
    <string id="taom_lotr_issue_grain_task" text="收集谷物（{COUNT}）" />
    <string id="taom_lotr_issue_supplies_title" text="急需粮草的大军" />
    <string id="taom_lotr_issue_supplies_desc" text="一位领主正在集结军队准备出征，需要粮食供养集结的士兵。" />
    <string id="taom_lotr_issue_supplies_brief" text="我的士兵正在集结，但光有剑可填不饱肚子。没有粮食，这支大军还没上战场就会散了。" />
    <string id="taom_lotr_issue_supplies_accept" text="你需要多少粮食？" />
    <string id="taom_lotr_issue_supplies_expl" text="给我带来{COUNT}份粮食，我的部下就能吃饱了出征。办成这件事，整个王国都会记住你的功劳。" />
    <string id="taom_lotr_issue_supplies_soln" text="我会给你的军队送来粮食。" />
    <string id="taom_lotr_issue_supplies_task" text="为军队运送谷物（{COUNT}）" />
    <string id="taom_lotr_issue_draught_title" text="{ISSUE_SETTLEMENT}需要役畜" />
    <string id="taom_lotr_issue_draught_desc" text="{ISSUE_SETTLEMENT}村失去了耕牛，已经无法耕种田地。" />
    <string id="taom_lotr_issue_draught_brief" text="我们的耕牛没了，有些被劫掠者抢走，有些活活饿死。没有牲畜拉犁，硬土翻不开，田地也没法播种。" />
    <string id="taom_lotr_issue_draught_accept" text="怎样才能帮到你们？" />
    <string id="taom_lotr_issue_draught_expl" text="如果你能给我们赶来{COUNT}头牛，我们就能在换季前重新翻耕土地。" />
    <string id="taom_lotr_issue_draught_soln" text="我会给你们带来牛。" />
    <string id="taom_lotr_issue_draught_task" text="交付牛（{COUNT}）" />
    <string id="taom_lotr_issue_crafting_title" text="{ISSUE_SETTLEMENT}需要铁料" />
    <string id="taom_lotr_issue_crafting_desc" text="{ISSUE_SETTLEMENT}的铁匠耗尽了铁料，没法修理工具和刀剑。" />
    <string id="taom_lotr_issue_crafting_brief" text="旅人，锻炉的火已经熄了。没有铁料，铁匠既不能给马钉蹄铁，也不能修补犁铧，整个村子都受到了影响。" />
    <string id="taom_lotr_issue_crafting_accept" text="哪里能弄到铁？" />
    <string id="taom_lotr_issue_crafting_expl" text="给我们带来{COUNT}块铁锭，锻炉旁就能重新响起锤声。我们自己实在买不起这么多铁料。" />
    <string id="taom_lotr_issue_crafting_soln" text="我会为你们找来铁料。" />
    <string id="taom_lotr_issue_crafting_task" text="交付铁锭（{COUNT}）" />
    <string id="taom_lotr_issue_tools_title" text="{ISSUE_SETTLEMENT}需要工具" />
    <string id="taom_lotr_issue_tools_desc" text="{ISSUE_SETTLEMENT}的居民缺少耕种和制作货物所需的工具。" />
    <string id="taom_lotr_issue_tools_brief" text="我们的镰刀已经锈穿了，锤子也坏了。再勤快的人，没有趁手的工具也干不快。" />
    <string id="taom_lotr_issue_tools_accept" text="你需要什么？" />
    <string id="taom_lotr_issue_tools_expl" text="如果你能带来{COUNT}套工具，村子就能恢复正常，再次兴旺起来。" />
    <string id="taom_lotr_issue_tools_soln" text="我会给你们带来工具。" />
    <string id="taom_lotr_issue_tools_task" text="交付工具（{COUNT}）" />
    <string id="taom_lotr_issue_horses_title" text="缺少战马的领主" />
    <string id="taom_lotr_issue_horses_desc" text="一位领主的坐骑因战斗和日常损耗而减少，需要为骑兵补充马匹。" />
    <string id="taom_lotr_issue_horses_brief" text="旅人，战争可不会怜惜马匹。我的马在艰难的长途行军中接连累垮，骑手没了坐骑，也不过是个行动迟缓的矛兵。" />
    <string id="taom_lotr_issue_horses_accept" text="你需要多少匹马？" />
    <string id="taom_lotr_issue_horses_expl" text="给我带来{COUNT}匹健壮的马，我的骑手就能重新出征。你会得到丰厚的报酬。" />
    <string id="taom_lotr_issue_horses_soln" text="我会给你带来马匹。" />
    <string id="taom_lotr_issue_horses_task" text="交付马匹（{COUNT}）" />
    <string id="taom_lotr_issue_recruits_title" text="帮派需要新血" />
    <string id="taom_lotr_issue_recruits_desc" text="一个帮派头目想强迫俘虏为他效力。" />
    <string id="taom_lotr_issue_recruits_brief" text="帮派人多才有力量，可我这里缺人。不管是什么人，只要是俘虏就给我带来，我自有用处。" />
    <string id="taom_lotr_issue_recruits_accept" text="你要什么样的俘虏？" />
    <string id="taom_lotr_issue_recruits_expl" text="给我带来{COUNT}名俘虏，我会安排他们干活。你拿钱，我也不问他们的来路。" />
    <string id="taom_lotr_issue_recruits_soln" text="我会给你带来俘虏。" />
    <string id="taom_lotr_issue_recruits_task" text="交付俘虏（{COUNT}）" />
    <string id="taom_lotr_issue_laborers_title" text="矿场缺人手" />
    <string id="taom_lotr_issue_laborers_desc" text="一位地主需要强壮的人手干重活，愿意接收你抓到的任何俘虏。" />
    <string id="taom_lotr_issue_laborers_brief" text="矿坑里缺工人，可自由民都不肯下去。给我带些戴着镣铐的俘虏，他们得靠挥镐干活换口饭吃。" />
    <string id="taom_lotr_issue_laborers_accept" text="你要俘虏？" />
    <string id="taom_lotr_issue_laborers_expl" text="给我带来{COUNT}名俘虏补充劳工队，我会付你抓人的辛苦钱。" />
    <string id="taom_lotr_issue_laborers_soln" text="我会给你带来俘虏。" />
    <string id="taom_lotr_issue_laborers_task" text="交付俘虏（{COUNT}）" />
    <string id="taom_lotr_issue_banditbase_title" text="{ISSUE_SETTLEMENT}附近的巢穴" />
    <string id="taom_lotr_issue_banditbase_desc" text="一伙劫掠者盘踞在{ISSUE_SETTLEMENT}附近，袭击道路上的行人。" />
    <string id="taom_lotr_issue_banditbase_brief" text="旅人，山里有一处贼窝。他们抢走我们的货物，还抓走我们的人。守卫人手太少，没法把他们一网打尽。" />
    <string id="taom_lotr_issue_banditbase_accept" text="这处巢穴在哪里？" />
    <string id="taom_lotr_issue_banditbase_expl" text="除掉那些在道路上作恶的劫掠者，我们会给你报酬。这里的日子也能安稳些。" />
    <string id="taom_lotr_issue_banditbase_soln" text="我会把他们一网打尽。" />
    <string id="taom_lotr_issue_outlaws_title" text="商路上的亡命徒" />
    <string id="taom_lotr_issue_outlaws_desc" text="劫掠团伙正在阻断一位商人的生意，需要有人将他们击溃。" />
    <string id="taom_lotr_issue_outlaws_brief" text="路上的劫掠者让我的商队寸步难行。多打垮几支劫掠队，生意才有机会恢复。" />
    <string id="taom_lotr_issue_outlaws_accept" text="要对付多少伙人？" />
    <string id="taom_lotr_issue_outlaws_expl" text="击败那些在路上作恶的团伙，打几场漂亮的胜仗，其余的人自然就散了。我会给你丰厚的报酬。" />
    <string id="taom_lotr_issue_outlaws_soln" text="我会清除商路上的匪患。" />
    <string id="taom_lotr_issue_poachers_title" text="一伙偷猎者" />
    <string id="taom_lotr_issue_poachers_desc" text="一大群偷猎者正在毁掉一位商人的狩猎生意。" />
    <string id="taom_lotr_issue_poachers_brief" text="偷猎者越来越多，也越来越猖狂。他们把林子里的猎物捕杀一空，还赶走正经猎人。必须有人收拾他们。" />
    <string id="taom_lotr_issue_poachers_accept" text="他们在哪里活动？" />
    <string id="taom_lotr_issue_poachers_expl" text="打败那群偷猎者，林子就又是我们的了。你会得到报酬。" />
    <string id="taom_lotr_issue_poachers_soln" text="我会对付他们。" />
    <string id="taom_lotr_issue_captured_title" text="被俘的手下" />
    <string id="taom_lotr_issue_captured_desc" text="一个帮派头目的手下被赏金猎人抓走了，他想把他们救出来。" />
    <string id="taom_lotr_issue_captured_brief" text="赏金猎人抓走了我的几个手下，还打算把他们卖掉。打垮看押他们的那群混蛋，我会私下给你报酬，绝不声张。" />
    <string id="taom_lotr_issue_captured_accept" text="谁看押着他们？" />
    <string id="taom_lotr_issue_captured_expl" text="找到抓走我手下的那伙人，把他们打垮。办成了就有钱拿，我不会多问。" />
    <string id="taom_lotr_issue_captured_soln" text="我会救出你的人。" />
    <string id="taom_lotr_issue_deserters_title" text="逃兵劫掠{ISSUE_SETTLEMENT}" />
    <string id="taom_lotr_issue_deserters_desc" text="一伙逃兵正在勒索{ISSUE_SETTLEMENT}的居民，还杀害了拒绝交钱的人。" />
    <string id="taom_lotr_issue_deserters_brief" text="一群拿着剑的溃兵来抢我们的粮食和钱财，已经闹出了人命。光靠我们自己对付不了他们。" />
    <string id="taom_lotr_issue_deserters_accept" text="我会帮忙。他们在哪里？" />
    <string id="taom_lotr_issue_deserters_expl" text="先埋伏起来，等那些逃兵来了就打垮他们。替我们除掉这群人，我们会感谢你，也会给你报酬。" />
    <string id="taom_lotr_issue_deserters_soln" text="我会让他们再也没法劫掠。" />
    <string id="taom_lotr_issue_commons_title" text="公用牧地之争" />
    <string id="taom_lotr_issue_commons_desc" text="一伙武装人员正用武力抢占村庄的公用牧地。" />
    <string id="taom_lotr_issue_commons_brief" text="一群凶徒占了我们的牧地，谁靠近就赶走谁。他们一天不走，我们的牲畜就得挨一天饿。" />
    <string id="taom_lotr_issue_commons_accept" text="他们是什么人？" />
    <string id="taom_lotr_issue_commons_expl" text="用武力把他们赶出公用牧地，牧场就又是我们的了。我们会尽力凑出报酬。" />
    <string id="taom_lotr_issue_commons_soln" text="我会把他们赶走。" />
    <string id="taom_lotr_issue_rivalgang_title" text="敌对帮派抢地盘" />
    <string id="taom_lotr_issue_rivalgang_desc" text="一个敌对帮派正在抢占帮派头目的地盘，需要有人将他们击败。" />
    <string id="taom_lotr_issue_rivalgang_brief" text="另一伙人以为能抢走我的地盘。去巷子里打垮他们，街上就又能安静下来了，你也能拿到钱。" />
    <string id="taom_lotr_issue_rivalgang_accept" text="他们在哪里聚集？" />
    <string id="taom_lotr_issue_rivalgang_expl" text="打败敌对帮派，让其他人看看和我作对的下场。办成了，就有大笔金币等着你。" />
    <string id="taom_lotr_issue_rivalgang_soln" text="包在我身上。" />
    <string id="taom_lotr_issue_spy_title" text="敌方密探" />
    <string id="taom_lotr_issue_spy_desc" text="一位领主怀疑敌方密探正图谋对付他，希望有人追踪并消灭密探的队伍。" />
    <string id="taom_lotr_issue_spy_brief" text="暗处藏着一条毒蛇，是敌人派来的密探，身边还带着一群亡命徒。趁他们还没动手，找到他们，除掉他们。" />
    <string id="taom_lotr_issue_spy_accept" text="我怎么认出他们？" />
    <string id="taom_lotr_issue_spy_expl" text="追上并消灭密探的队伍。替我除掉这个威胁，你会得到丰厚的奖赏。" />
    <string id="taom_lotr_issue_spy_soln" text="我会追上他们，把他们除掉。" />
    <string id="taom_lotr_issue_revolt_title" text="叛乱的贵族" />
    <string id="taom_lotr_issue_revolt_desc" text="一个小贵族煽动农民起义，需要有人将其镇压。" />
    <string id="taom_lotr_issue_revolt_brief" text="一个小领主煽动农民反抗贵族，还召集了一批武装人员。趁叛乱还没蔓延，把他的势力打垮。" />
    <string id="taom_lotr_issue_revolt_accept" text="他在哪里集结？" />
    <string id="taom_lotr_issue_revolt_expl" text="打败这个叛徒和他那群乌合之众，秩序就能恢复。你会因为这次效劳得到奖赏。" />
    <string id="taom_lotr_issue_revolt_soln" text="我会镇压这场叛乱。" />
    <string id="taom_lotr_issue_company_title" text="惹是生非的佣兵团" />
    <string id="taom_lotr_issue_company_desc" text="一群雇佣兵受雇骚扰一位领主，需要有人将他们赶走。" />
    <string id="taom_lotr_issue_company_brief" text="我的敌人派了一支佣兵团到我的领地上。他们拿着别人的钱，到处烧杀抢掠。替我打垮他们。" />
    <string id="taom_lotr_issue_company_accept" text="他们在哪里劫掠？" />
    <string id="taom_lotr_issue_company_expl" text="打败这支佣兵团，我的领地就能重新安宁下来。我会给你丰厚的报酬。" />
    <string id="taom_lotr_issue_company_soln" text="我会打垮他们。" />
    <string id="taom_lotr_issue_prodigal_title" text="欠债的亲人" />
    <string id="taom_lotr_issue_prodigal_desc" text="一位领主的年轻亲戚和帮派混在一起，欠了债，如今被他们扣押。" />
    <string id="taom_lotr_issue_prodigal_brief" text="我有个不成器的年轻亲戚，跟一群盗贼混在一起，如今那伙人因为他欠债把他扣住了。打垮他们，把人救出来。" />
    <string id="taom_lotr_issue_prodigal_accept" text="他被关在哪里？" />
    <string id="taom_lotr_issue_prodigal_expl" text="打败扣押我亲人的帮派，把他救出来。我愿意拿出那笔债务几倍的钱来酬谢你。" />
    <string id="taom_lotr_issue_prodigal_soln" text="我会救出你的亲人。" />
    <string id="taom_lotr_issue_rival_title" text="可恨的对手" />
    <string id="taom_lotr_issue_rival_desc" text="一位领主想让人在战斗中活捉他的敌对领主。" />
    <string id="taom_lotr_issue_rival_brief" text="有个领主，我很想看他被活捉，再狠狠受一番羞辱。只要你能在战斗中俘虏一名敌方领主，就算帮了我一个大忙。" />
    <string id="taom_lotr_issue_rival_accept" text="你要活捉他？" />
    <string id="taom_lotr_issue_rival_expl" text="在战斗中俘虏一名敌方领主，任务就算完成。你会得到丰厚的奖赏。" />
    <string id="taom_lotr_issue_rival_soln" text="我会给你带来一名被俘的领主。" />
    <string id="taom_lotr_issue_caravanambush_title" text="商路伏击" />
    <string id="taom_lotr_issue_caravanambush_desc" text="劫掠者为一位商人的商队设下了埋伏，需要先击败他们。" />
    <string id="taom_lotr_issue_caravanambush_brief" text="我得到消息，前面的路上有强盗正埋伏着，等我的商队经过。将计就计，趁他们还没把我抢个精光，打垮他们。" />
    <string id="taom_lotr_issue_caravanambush_accept" text="他们埋伏在哪里？" />
    <string id="taom_lotr_issue_caravanambush_expl" text="找到那些埋伏的劫掠者，把他们消灭。道路畅通了，我的货物和你的报酬才能送过来。" />
    <string id="taom_lotr_issue_caravanambush_soln" text="我会粉碎他们的伏击。" />
    <string id="taom_lotr_issue_escortcaravan_title" text="肃清商路" />
    <string id="taom_lotr_issue_escortcaravan_desc" text="只有击败商路上的劫掠团伙，一位商人的商队才能通行。" />
    <string id="taom_lotr_issue_escortcaravan_brief" text="路上到处都是劫掠者，我的货车根本不敢动身。多打垮几支劫掠队，正经商人才能重新做生意。" />
    <string id="taom_lotr_issue_escortcaravan_accept" text="有多少人挡道？" />
    <string id="taom_lotr_issue_escortcaravan_expl" text="打败那些威胁商路的团伙，我的商队就能重新上路。只要能安全通行，我会给你丰厚的报酬。" />
    <string id="taom_lotr_issue_escortcaravan_soln" text="我会扫清路上的障碍。" />
    <string id="taom_lotr_issue_herd_title" text="为{ISSUE_SETTLEMENT}运送牲畜" />
    <string id="taom_lotr_issue_herd_desc" text="{ISSUE_SETTLEMENT}的居民需要有人运来牲畜，让畜群重新繁衍。" />
    <string id="taom_lotr_issue_herd_brief" text="旅人，狼和更可怕的东西几乎害光了我们的牲畜。没有种畜繁育，村子以后就别想过上粮食充足的冬天了。" />
    <string id="taom_lotr_issue_herd_accept" text="你想让我带什么来？" />
    <string id="taom_lotr_issue_herd_expl" text="给我们赶来{COUNT}只羊，畜群才有机会重新繁衍。我们会尽村子所能凑出报酬。" />
    <string id="taom_lotr_issue_herd_soln" text="我会给你们带来牲畜。" />
    <string id="taom_lotr_issue_herd_task" text="交付牲畜（{COUNT}）" />
    <string id="taom_lotr_issue_snare_title" text="给贪婪者的陷阱" />
    <string id="taom_lotr_issue_snare_desc" text="一个帮派头目想将一伙贪婪的对手诱入陷阱，再消灭他们。" />
    <string id="taom_lotr_issue_snare_brief" text="有一伙贪得无厌的家伙，连自己亲娘都敢抢。把他们引过来干掉，我们再悄悄分掉他们带的东西。" />
    <string id="taom_lotr_issue_snare_accept" text="这些对手是什么人？" />
    <string id="taom_lotr_issue_snare_expl" text="等那群贪婪的家伙落入圈套，就把他们解决掉。办得干净利落，你就能拿到一大笔钱。" />
    <string id="taom_lotr_issue_snare_soln" text="我会办好的。" />
    <string id="taom_lotr_issue_cantsell_title" text="无人问津的货物" />
    <string id="taom_lotr_issue_cantsell_desc" text="一位工匠的货物积压卖不出去，需要运到有销路的市场。" />
    <string id="taom_lotr_issue_cantsell_brief" text="旅人，我的货架快被压垮了，可这里没人肯买。只要把这些货送到需要它们的城镇，我就不用守着手艺挨饿了。" />
    <string id="taom_lotr_issue_cantsell_accept" text="你做的是什么货物？" />
    <string id="taom_lotr_issue_cantsell_expl" text="给我带来{COUNT}批陶器，好送到销路更好的市场去。我会分给你一部分卖货的收入。" />
    <string id="taom_lotr_issue_cantsell_soln" text="我会帮你的货物打开销路。" />
    <string id="taom_lotr_issue_cantsell_task" text="收集陶器用于交易（{COUNT}）" />
    <string id="taom_lotr_issue_overpriced_title" text="昂贵的材料" />
    <string id="taom_lotr_issue_overpriced_desc" text="一位工匠买不起制作货物所需的原料，需要有人便宜些卖给他。" />
    <string id="taom_lotr_issue_overpriced_brief" text="好皮革的价格涨得太离谱了，再弄不到，我的生意就要做不下去了。按公道的价钱给我带一些来，我会记住你的帮助。" />
    <string id="taom_lotr_issue_overpriced_accept" text="你需要什么？" />
    <string id="taom_lotr_issue_overpriced_expl" text="给我带来{COUNT}批皮革，我的作坊就能重新开工。我会给你公道的报酬。" />
    <string id="taom_lotr_issue_overpriced_soln" text="我会为你找来皮革。" />
    <string id="taom_lotr_issue_overpriced_task" text="交付皮革（{COUNT}）" />
    <string id="taom_lotr_issue_offload_title" text="转移赃物" />
    <string id="taom_lotr_issue_offload_desc" text="一个帮派头目需要转移一批赃物，正在找能悄悄运走它们的人。" />
    <string id="taom_lotr_issue_offload_brief" text="我有一批货，可不能让不该看见的人看见。替我运走它们，就有一笔干净的钱等着你。不问来路，也不留姓名。" />
    <string id="taom_lotr_issue_offload_accept" text="我要运什么？" />
    <string id="taom_lotr_issue_offload_expl" text="给我弄来{COUNT}批这种货物，再悄悄转移。办好了，下一单生意也交给你。" />
    <string id="taom_lotr_issue_offload_soln" text="我会运走你的货物。" />
    <string id="taom_lotr_issue_offload_task" text="取得货物（{COUNT}）" />
    <string id="taom_lotr_issue_revenue_title" text="实物什一税" />
    <string id="taom_lotr_issue_revenue_desc" text="偏远的农场拖欠了一位地主的什一税，需要以粮食缴纳。" />
    <string id="taom_lotr_issue_revenue_brief" text="农场欠我什一税，要用粮食交，不是钱币。当然，得他们肯交才行。把欠的收上来交给我，你也能分到一份。" />
    <string id="taom_lotr_issue_revenue_accept" text="欠了多少？" />
    <string id="taom_lotr_issue_revenue_expl" text="按照什一税应收的数额，收来{COUNT}份粮食。我会给你一份公道的报酬。" />
    <string id="taom_lotr_issue_revenue_soln" text="我会为你收齐什一税。" />
    <string id="taom_lotr_issue_revenue_task" text="收取粮食什一税（{COUNT}）" />
    <string id="taom_lotr_issue_arttrade_title" text="一桩贸易生意" />
    <string id="taom_lotr_issue_arttrade_desc" text="一个想做生意的人需要一批货物来赚取利润，证明这门生意行得通。" />
    <string id="taom_lotr_issue_arttrade_brief" text="旅人，我想靠做生意发财，可还缺第一批货。你把货物带来，我把它们卖成钱，让咱们两个都能赚上一笔。" />
    <string id="taom_lotr_issue_arttrade_accept" text="你需要什么货物？" />
    <string id="taom_lotr_issue_arttrade_expl" text="给我带来{COUNT}批油，让生意做起来。货物卖掉后，你也能分到利润。" />
    <string id="taom_lotr_issue_arttrade_soln" text="我会给你的生意备好货。" />
    <string id="taom_lotr_issue_arttrade_task" text="交付贸易货物（{COUNT}）" />
    <string id="taom_lotr_issue_smugglers_title" text="铲除走私团伙" />
    <string id="taom_lotr_issue_smugglers_desc" text="一个走私团伙正靠低价货冲击正经商人的生意，一位商人希望有人铲除他们。" />
    <string id="taom_lotr_issue_smugglers_brief" text="一伙走私贩把没交过税的货物大量倒进市场，正经商人都快被逼破产了。断掉他们的运货路线，生意自然就能恢复正常。" />
    <string id="taom_lotr_issue_smugglers_accept" text="他们从哪里运货？" />
    <string id="taom_lotr_issue_smugglers_expl" text="打败走私贩，打散他们的团伙。把他们赶出商路，我会给你报酬。" />
    <string id="taom_lotr_issue_smugglers_soln" text="我会打散他们的团伙。" />
    <string id="taom_lotr_issue_gangweapons_title" text="夺取武器" />
    <string id="taom_lotr_issue_gangweapons_desc" text="一个帮派头目想用武力夺取对手藏匿的武器。" />
    <string id="taom_lotr_issue_gangweapons_brief" text="对头藏着一批好武器，我的手下却只能拿生锈的刀打架。打败他们，武器就是我们的了，你也能分到一份。" />
    <string id="taom_lotr_issue_gangweapons_accept" text="这批武器藏在哪里？" />
    <string id="taom_lotr_issue_gangweapons_expl" text="打败看守武器的那伙人，武器就归我了。办成这件事，我会给你一大笔钱。" />
    <string id="taom_lotr_issue_gangweapons_soln" text="我会夺下他们藏的武器。" />
    <string id="taom_lotr_issue_garrison_title" text="坚守城墙" />
    <string id="taom_lotr_issue_garrison_desc" text="一位领主的驻军处境艰难，需要有人击退不断骚扰他们的敌军。" />
    <string id="taom_lotr_issue_garrison_brief" text="我的驻军兵力不足，敌人却步步紧逼。打垮那些骚扰城防的队伍，让我的士兵喘口气。" />
    <string id="taom_lotr_issue_garrison_accept" text="是谁在进逼？" />
    <string id="taom_lotr_issue_garrison_expl" text="击败骚扰驻军的敌人，城墙就能守住。王国会奖赏你。" />
    <string id="taom_lotr_issue_garrison_soln" text="我会替你的驻军解围。" />
    <string id="taom_lotr_issue_conquest_title" text="削弱敌军实力" />
    <string id="taom_lotr_issue_conquest_desc" text="一位领主准备出兵征服敌土，需要先击溃敌人的野战部队。" />
    <string id="taom_lotr_issue_conquest_brief" text="我打算拿走本该属于我的东西，可敌军挡在前面。打垮他们的野战部队，目标就更容易到手了。" />
    <string id="taom_lotr_issue_conquest_accept" text="你想让我做什么？" />
    <string id="taom_lotr_issue_conquest_expl" text="击败敌军，削弱他们对领地的控制。办成了，你就能分到这次征战的战利品。" />
    <string id="taom_lotr_issue_conquest_soln" text="我会削弱他的兵力。" />
    <string id="taom_lotr_issue_raid_title" text="将战火烧向敌境" />
    <string id="taom_lotr_issue_raid_desc" text="一位领主希望有人袭扰敌人的领地，并消灭敌军的劫掠队。" />
    <string id="taom_lotr_issue_raid_brief" text="是时候让敌人在自己的土地上尝尝战争的滋味了。追上他的劫掠队，把他们消灭，让恐惧笼罩他的领地。" />
    <string id="taom_lotr_issue_raid_accept" text="我该在哪里进攻？" />
    <string id="taom_lotr_issue_raid_expl" text="击败在他边境一带活动的敌军。让他的领地流血，你就能得到丰厚的报酬。" />
    <string id="taom_lotr_issue_raid_soln" text="我会把战火带到他们那里。" />
    <string id="taom_lotr_issue_scout_title" text="查明敌情" />
    <string id="taom_lotr_issue_scout_desc" text="一位领主需要有人击溃敌军巡逻队，让他的斥候能够查明边境的情况。" />
    <string id="taom_lotr_issue_scout_brief" text="敌人的巡逻队在边境来回活动，让我没法掌握他的动向。打垮他们，让我的斥候看清局势，我才知道该往哪里进攻。" />
    <string id="taom_lotr_issue_scout_accept" text="他的巡逻队在哪里活动？" />
    <string id="taom_lotr_issue_scout_expl" text="击败封锁边境的敌军巡逻队，让我的斥候能够通过。办成这件事，你会得到报酬。" />
    <string id="taom_lotr_issue_scout_soln" text="我会清除边境的敌军。" />
    <string id="taom_lotr_issue_knight_title" text="勇士的信物" />
    <string id="taom_lotr_issue_knight_desc" text="一位女贵族希望有人佩戴她的信物，在比武场上获胜。" />
    <string id="taom_lotr_issue_knight_brief" text="我希望有位勇士佩戴我的信物参加竞技大赛，以我的名义赢得荣耀。只要你在比武场上获胜，我就会一直记得这份恩情。" />
    <string id="taom_lotr_issue_knight_accept" text="你想让我替你出战比武场？" />
    <string id="taom_lotr_issue_knight_expl" text="佩戴我的信物赢得竞技大赛，荣耀就属于我们两人。你会因为这场胜利得到奖赏。" />
    <string id="taom_lotr_issue_knight_soln" text="我会为你赢得胜利。" />
    <string id="taom_lotr_issue_tutor_title" text="继承人的教育" />
    <string id="taom_lotr_issue_tutor_desc" text="一位领主需要精美布料和其他物品，为继承人的求学生活备齐体面的衣装与用具。" />
    <string id="taom_lotr_issue_tutor_brief" text="我的继承人得接受符合家族身份的教育，体面的衣服和学习用具一样都不能少。把需要的东西带来，那孩子就什么也不缺了。" />
    <string id="taom_lotr_issue_tutor_accept" text="我需要带什么来？" />
    <string id="taom_lotr_issue_tutor_expl" text="给我带来{COUNT}匹天鹅绒，让我的继承人穿得像个领主该有的样子。我会给你丰厚的报酬。" />
    <string id="taom_lotr_issue_tutor_soln" text="我会为你的继承人备齐所需物品。" />
    <string id="taom_lotr_issue_tutor_task" text="交付精美布料（{COUNT}）" />
    <string id="taom_lotr_issue_training_title" text="让扈从经受战火" />
    <string id="taom_lotr_issue_training_desc" text="一位地主想让缺乏经验的扈从在实战中接受磨炼。" />
    <string id="taom_lotr_issue_training_brief" text="我的扈从太娇弱，也没打过仗，这样的人第一次上战场就会送命。带他们去对付真正的敌人，把他们练成能打硬仗的士兵。" />
    <string id="taom_lotr_issue_training_accept" text="你想让他们见识真正的战斗？" />
    <string id="taom_lotr_issue_training_expl" text="打赢几场硬仗，教会我的扈从怎么作战。把他们练得坚强些，你就能拿到这份教学的报酬。" />
    <string id="taom_lotr_issue_training_soln" text="我会把他们训练成士兵。" />
    <string id="taom_lotr_issue_inn_title" text="受骗后的怒火" />
    <string id="taom_lotr_issue_inn_desc" text="一位当地的显要人物被骗子骗走了财产，希望有人狠狠教训他们。" />
    <string id="taom_lotr_issue_inn_brief" text="一帮骗子和老千用做过手脚的骰子和假文书骗走了我的财产。替我收拾他们，我或许还能在镇上抬起头来做人。" />
    <string id="taom_lotr_issue_inn_accept" text="谁骗了你？" />
    <string id="taom_lotr_issue_inn_expl" text="找到那些骗子，给他们一个忘不了的教训。我会尽我所能报答你。" />
    <string id="taom_lotr_issue_inn_soln" text="我会替你算这笔账。" />
    <string id="taom_lotr_issue_feud_title" text="多年的仇怨" />
    <string id="taom_lotr_issue_feud_desc" text="一场积怨已演变成流血冲突，一位领主希望有人击溃敌对势力的武装人员。" />
    <string id="taom_lotr_issue_feud_brief" text="我的家族和另一个家族结怨多年，仇恨很深，如今已经动了刀剑。打败他们的武装人员，这场恩怨或许就能了结。" />
    <string id="taom_lotr_issue_feud_accept" text="你和谁有仇？" />
    <string id="taom_lotr_issue_feud_expl" text="击败对方的人马，用武力了结这场仇怨。办成了，我的家族就欠你一份人情。" />
    <string id="taom_lotr_issue_feud_soln" text="我会了结这场仇怨。" />
    <string id="taom_lotr_issue_daughter_title" text="被绑走的女儿" />
    <string id="taom_lotr_issue_daughter_desc" text="一位当地显要人物的女儿被帮派绑走，家人希望有人将她救回。" />
    <string id="taom_lotr_issue_daughter_brief" text="我的女儿！旅人，他们抓走了我的女儿，还要我付一笔根本拿不出的赎金。打垮那群混蛋，把她带回家吧。" />
    <string id="taom_lotr_issue_daughter_accept" text="她被关在哪里？" />
    <string id="taom_lotr_issue_daughter_expl" text="找到抓走我女儿的那伙人，把他们打垮。只要把她平安带回家，我愿意拿出所有能拿得出的东西来报答你。" />
    <string id="taom_lotr_issue_daughter_soln" text="我会把她带回家。" />
    <string id="taom_lotr_issue_betting_title" text="稳赢的赌注" />
    <string id="taom_lotr_issue_betting_desc" text="一个帮派头目在竞技大赛上下了重注，需要一名斗士帮他赢下赌注。" />
    <string id="taom_lotr_issue_betting_brief" text="我在下一场竞技大赛上押了一大笔钱，而我不喜欢输。替我赢下来，赢来的钱有你一大份。" />
    <string id="taom_lotr_issue_betting_accept" text="你想让我赢下竞技大赛？" />
    <string id="taom_lotr_issue_betting_expl" text="赢下一场竞技大赛，让我的赌注赚到钱。拿下冠军，我会从赢来的钱里好好酬谢你。" />
    <string id="taom_lotr_issue_betting_soln" text="我会帮你赢下赌注。" />
    <string id="taom_lotr_issue_special_title" text="锻炉需要铁料" />
    <string id="taom_lotr_issue_special_desc" text="一个帮派头目需要上好的铁料，来锻造一批特制刀剑。" />
    <string id="taom_lotr_issue_special_brief" text="我要打一批刀剑，得是真正的好刀剑，不是我手下拿的那些破烂。这就得用好铁。把铁料弄来，我会让铁匠开工。" />
    <string id="taom_lotr_issue_special_accept" text="需要多少铁？" />
    <string id="taom_lotr_issue_special_expl" text="给我弄来{COUNT}块上好的铁锭用于锻造，你就有钱拿。至于刀剑，那是我的事。" />
    <string id="taom_lotr_issue_special_soln" text="我会给你弄来铁料。" />
    <string id="taom_lotr_issue_special_task" text="交付铁锭（{COUNT}）" />
    <string id="taom_lotr_issue_fallback_title" text="请求援助" />
    <string id="taom_lotr_issue_fallback_desc" text="一位当地居民需要有人送来货物。" />
    <string id="taom_lotr_issue_fallback_brief" text="旅人，我们需要帮助。" />
    <string id="taom_lotr_issue_fallback_accept" text="我能帮什么忙？" />
    <string id="taom_lotr_issue_fallback_expl" text="把我们需要的{ITEM}带来，数量是{COUNT}，我们就有救了。" />
    <string id="taom_lotr_issue_fallback_soln" text="我会带来你们需要的东西。" />
    <string id="taom_lotr_issue_common_accepted" text="将{ITEM}（{COUNT}）送到{QUEST_SETTLEMENT}。" />
    <string id="taom_lotr_issue_common_ready" text="你已备齐任务所需的物品，返回{QUEST_SETTLEMENT}交付即可。" />
    <string id="taom_lotr_issue_common_cancel" text="约定已取消。" />
    <string id="taom_lotr_issue_common_timeout" text="你未能及时交付货物。" />
    <string id="taom_lotr_issue_common_offer_accept" text="谢谢你。我不会忘记这份恩情。" />
    <string id="taom_lotr_issue_common_have_you" text="你带来我们需要的东西了吗？" />
    <string id="taom_lotr_issue_common_thanks" text="祝福你，旅人。你救了我们。" />
    <string id="taom_lotr_issue_common_await" text="我们等你回来。" />
    <string id="taom_lotr_issue_common_turnin" text="带来了，都在这里。" />
    <string id="taom_lotr_issue_common_working" text="还没有，我正在办。" />
    <string id="taom_lotr_issue_common_not_enough" text="你带的还不够。" />
    <string id="taom_lotr_issue_common_task" text="收集物品" />
    <string id="taom_lotr_issue_pers_expl" text="给我带来{COUNT}名俘虏，我会给你丰厚的报酬。" />
    <string id="taom_lotr_issue_pers_soln" text="我会给你带来俘虏。" />
    <string id="taom_lotr_issue_pers_accepted" text="将{COUNT}名俘虏送到{QUEST_SETTLEMENT}。" />
    <string id="taom_lotr_issue_pers_ready" text="你的俘虏数量已经足够，返回{QUEST_SETTLEMENT}交付即可。" />
    <string id="taom_lotr_issue_pers_timeout" text="你未能及时交付俘虏。" />
    <string id="taom_lotr_issue_pers_have" text="你带来俘虏了吗？" />
    <string id="taom_lotr_issue_pers_thanks" text="这些人正合适。多谢了。" />
    <string id="taom_lotr_issue_pers_turnin" text="带来了，人都在这里。" />
    <string id="taom_lotr_issue_pers_not_enough" text="你的俘虏数量还不够。" />
    <string id="taom_lotr_issue_pers_task" text="抓捕俘虏" />
