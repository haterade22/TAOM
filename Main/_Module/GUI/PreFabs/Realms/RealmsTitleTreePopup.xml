<Prefab>
	<!--
		TAOM.Realms: the title tree popup (#1255). Bound to TitleTreePopupVM (Client/Features/Realms/Popups), loaded by
		RealmsPopupLayer at layer order 320. A fixed 1500 by 880 encyclopedia stone modal, centred over the dimmed screen, with
		the ec_header title plate across its top, the close button in the plate and the Done button just below the stone.
		Left, the tree, top-down: the realm at the top centre, its great titles as pennants in a row below, each title's text
		under its pennant, and the vassals further down (a chain runs straight down, leaf vassals stack as compact rows).
		TitleTreeCanvasLayout places every card and connector line on one canvas of CanvasWidth by CanvasHeight; the flat
		Cards and Lines lists draw it at those positions. The canvas is never smaller than the 1048 by 790 clip rect
		(TitleTreeCanvasLayout.ViewportWidth and ViewportHeight), so a narrow tree sits centred in it and a large one scrolls:
		the wheel scrolls down, Shift and the wheel sideways, and the mouse pans. RealmsTitleTreeScrollablePanel brings the
		selected title into view when the tree opens and whenever SelectionVersion changes. The native troop panel's drag
		code writes both scrollbars without a null check, so both are declared even though one may hide itself.
		Right of a thin gold divider, the details of the selected title: its pennant, its name (a link to its encyclopedia
		page), its holder and folded lordships, its liege (none for the realm or for lands) and its vassals, each a button
		that selects that title. The details column scrolls on its own; the tree beside it does not move with it.
		Tree cards carry no box: clicking one selects it. The selected card's pennant rim brightens, its title turns gold
		through UpdateChildrenStates, and every connector on the path from the realm down to it lights (IsLit).
		Banners are TAOM's encyclopedia pennant (the hero and clan pages' stack: HeroClanMask at 1.35 zoom, drape, rim, 408:664
		aspect), sized and placed by TitleTreeCanvasLayout.PennantOf. They bind BannerId, BannerArgs and BannerProvider on the
		card itself: a nested DataSource="{ImageIdentifier}" would rescope @ContentAlpha away.
		IsLands: a title drawn under a vacant titular realm without being its vassal yet: its pennant and text fade to
		@ContentAlpha through Brush.GlobalAlphaFactor (AlphaFactor reaches only a widget's own sprite).
		Text stacks top to bottom (title, holder, folded lordships). The engine measures a text at its float width but draws it
		wrapped at that width truncated to whole pixels, so a line within a pixel of the edge measured one line short and the
		next text covered it. Each wrapping text therefore holds a transparent twin 2 pixels narrower (Brush.GlobalAlphaFactor
		0): a text's measured height is the larger of its own and its children's, so it reserves every line it draws, and
		Brush.TextVerticalAlignment="Top" keeps any spare line below. TitleTreeTextFit estimates the text's lines so a card
		is tall enough for them (the fonts, widths and tops here must match it); nothing clips a card's text.
	-->
	<Window>
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
			<Children>

				<!--Dim: covers and holds the mouse for the whole screen-->
				<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000CC"/>

				<Widget Id="TitleTreeModal" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1500" SuggestedHeight="880" HorizontalAlignment="Center" VerticalAlignment="Center">
					<Children>

						<EncyclopediaStonePanelWidget Id="ModalStone" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="ec_panel_9" DoNotAcceptEvents="true"/>

						<!--Tree: the scroll viewport and its two scrollbars, outside the clip rect so they never cover a card-->
						<Widget Id="TreeArea" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1060" SuggestedHeight="802" MarginLeft="20" MarginTop="64">
							<Children>

								<RealmsTitleTreeScrollablePanel Id="TreeScrollablePanel" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1048" SuggestedHeight="790" InnerPanel="TreeRect\InnerPanel" ClipRect="TreeRect" HorizontalScrollbar="..\TreeHorizontalScrollbar" VerticalScrollbar="..\TreeVerticalScrollbar" PanWithMouseEnabled="true" AutoHideScrollBars="true" SelectionVersion="@SelectionVersion">
									<Children>
										<Widget Id="TreeRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" ClipContents="true">
											<Children>
												<Widget Id="InnerPanel" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@CanvasWidth" SuggestedHeight="@CanvasHeight">
													<Children>

														<!--Connector lines, behind the cards, in two layers over the same list: every base first, then every lit
															segment. Sibling bars share a Y and overlap, so a lit bar drawn inside its own item would be covered by
															a later sibling's unlit bar.-->
														<Widget DataSource="{Lines}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
															<ItemTemplate>
																<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@Width" SuggestedHeight="@Height" PositionXOffset="@X" PositionYOffset="@Y" Sprite="BlankWhiteSquare_9" Color="#9C7A40D9" DoNotAcceptEvents="true"/>
															</ItemTemplate>
														</Widget>
														<Widget DataSource="{Lines}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
															<ItemTemplate>
																<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@Width" SuggestedHeight="@Height" PositionXOffset="@X" PositionYOffset="@Y" Sprite="BlankWhiteSquare_9" Color="#F4CF72FF" IsVisible="@IsLit" DoNotAcceptEvents="true"/>
															</ItemTemplate>
														</Widget>

														<!--Cards-->
														<Widget DataSource="{Cards}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
															<ItemTemplate>
																<ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@Width" SuggestedHeight="@Height" PositionXOffset="@X" PositionYOffset="@Y" Brush="TAOM.Encyclopedia.TextButton" IsSelected="@IsSelected" Command.Click="ExecuteSelect" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
																	<Children>

																		<!--Pennant; a second, brightened rim marks the selected title-->
																		<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@PennantWidth" SuggestedHeight="@PennantHeight" PositionXOffset="@PennantX" PositionYOffset="@PennantY" DoNotAcceptEvents="true">
																			<Children>
																				<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" ClipContents="true">
																					<Children>
																						<EncyclopediaMaskedImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@BannerId" AdditionalArgs="@BannerArgs" TextureProviderName="@BannerProvider" DoNotAcceptEvents="true" Brush="TAOM.Encyclopedia.HeroClanMask" Brush.GlobalAlphaFactor="@ContentAlpha" Zoom="1.35"/>
																					</Children>
																				</Widget>
																				<ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="ec_hero_clan_drape" Brush.GlobalAlphaFactor="@ContentAlpha" DoNotAcceptEvents="true"/>
																				<ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="ec_hero_clan_rim" Brush.GlobalAlphaFactor="@ContentAlpha" DoNotAcceptEvents="true"/>
																				<ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="ec_hero_clan_rim" Brush.ColorFactor="1.9" Brush.GlobalAlphaFactor="@ContentAlpha" IsVisible="@IsSelected" DoNotAcceptEvents="true"/>
																			</Children>
																		</Widget>

																		<!--Realm: name, holder and count centred under the pennant-->
																		<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="104" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@IsRoot" UpdateChildrenStates="true" DoNotAcceptEvents="true">
																			<Children>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.Encyclopedia.ListText" Brush.FontSize="24" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Top" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@TitleText" DoNotAcceptEvents="true">
																					<Children>
																						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="1" MarginRight="1" Brush="TAOM.Encyclopedia.ListText" Brush.FontSize="24" Brush.GlobalAlphaFactor="0" Text="@TitleText" DoNotAcceptEvents="true"/>
																					</Children>
																				</TextWidget>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="2" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="17" Brush.TextVerticalAlignment="Top" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@HolderText" DoNotAcceptEvents="true">
																					<Children>
																						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="1" MarginRight="1" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="17" Brush.GlobalAlphaFactor="0" Text="@HolderText" DoNotAcceptEvents="true"/>
																					</Children>
																				</TextWidget>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="15" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@FoldedText" IsVisible="@HasFolded" DoNotAcceptEvents="true"/>
																			</Children>
																		</ListPanel>

																		<!--Pennant node: name, holder and count centred under the pennant-->
																		<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="94" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@IsNode" UpdateChildrenStates="true" DoNotAcceptEvents="true">
																			<Children>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.Encyclopedia.ListText" Brush.FontSize="20" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Top" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@TitleText" DoNotAcceptEvents="true">
																					<Children>
																						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="1" MarginRight="1" Brush="TAOM.Encyclopedia.ListText" Brush.FontSize="20" Brush.GlobalAlphaFactor="0" Text="@TitleText" DoNotAcceptEvents="true"/>
																					</Children>
																				</TextWidget>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="15" Brush.TextVerticalAlignment="Top" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@HolderText" DoNotAcceptEvents="true">
																					<Children>
																						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="1" MarginRight="1" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="15" Brush.GlobalAlphaFactor="0" Text="@HolderText" DoNotAcceptEvents="true"/>
																					</Children>
																				</TextWidget>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="15" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@FoldedText" IsVisible="@HasFolded" DoNotAcceptEvents="true"/>
																			</Children>
																		</ListPanel>

																		<!--Compact row: text right of the pennant-->
																		<ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="194" PositionXOffset="52" VerticalAlignment="Center" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@IsRow" UpdateChildrenStates="true" DoNotAcceptEvents="true">
																			<Children>
																				<TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="194" Brush="TAOM.Encyclopedia.ListText" Brush.FontSize="18" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@TitleText" DoNotAcceptEvents="true">
																					<Children>
																						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="1" MarginRight="1" Brush="TAOM.Encyclopedia.ListText" Brush.FontSize="18" Brush.GlobalAlphaFactor="0" Text="@TitleText" DoNotAcceptEvents="true"/>
																					</Children>
																				</TextWidget>
																				<TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="194" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="15" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@HolderText" DoNotAcceptEvents="true">
																					<Children>
																						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="1" MarginRight="1" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="15" Brush.GlobalAlphaFactor="0" Text="@HolderText" DoNotAcceptEvents="true"/>
																					</Children>
																				</TextWidget>
																				<TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="194" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="15" Brush.TextHorizontalAlignment="Left" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@FoldedText" IsVisible="@HasFolded" DoNotAcceptEvents="true"/>
																			</Children>
																		</ListPanel>

																		<HintWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint"/>
																	</Children>
																</ButtonWidget>
															</ItemTemplate>
														</Widget>

													</Children>
												</Widget>
											</Children>
										</Widget>
									</Children>
								</RealmsTitleTreeScrollablePanel>

								<ScrollbarWidget Id="TreeVerticalScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="12" SuggestedHeight="790" HorizontalAlignment="Right" AlignmentAxis="Vertical" Handle="TreeVerticalScrollbarHandle" MinValue="0" MaxValue="100">
									<Children>
										<BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Bed"/>
										<BrushWidget Id="TreeVerticalScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="50" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Handle"/>
									</Children>
								</ScrollbarWidget>

								<ScrollbarWidget Id="TreeHorizontalScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1048" SuggestedHeight="12" VerticalAlignment="Bottom" AlignmentAxis="Horizontal" Handle="TreeHorizontalScrollbarHandle" MinValue="0" MaxValue="100">
									<Children>
										<BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Bed"/>
										<BrushWidget Id="TreeHorizontalScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="50" SuggestedHeight="8" VerticalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Handle"/>
									</Children>
								</ScrollbarWidget>

							</Children>
						</Widget>

						<!--Divider between the tree and the details-->
						<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1" SuggestedHeight="780" MarginLeft="1094" MarginTop="78" Sprite="BlankWhiteSquare_9" Color="#AD8849B3" DoNotAcceptEvents="true"/>

						<!--Details of the selected title-->
						<Widget Id="DetailsArea" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="370" SuggestedHeight="800" MarginLeft="1110" MarginTop="66">
							<Children>

								<ScrollablePanel Id="DetailsScrollablePanel" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="356" SuggestedHeight="800" InnerPanel="DetailsRect\DetailsList" ClipRect="DetailsRect" VerticalScrollbar="..\DetailsScrollbar" AutoHideScrollBars="true">
									<Children>
										<Widget Id="DetailsRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" ClipContents="true">
											<Children>
												<ListPanel Id="DetailsList" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
													<Children>

														<!--Heading: the label between two thin gold rules, each ending in a diamond, as the title plate's ornaments-->
														<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="340" SuggestedHeight="30" HorizontalAlignment="Center" MarginTop="10" DoNotAcceptEvents="true">
															<Children>
																<ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="2" PositionXOffset="8" VerticalAlignment="Center" Sprite="fs_divider_thin" DoNotAcceptEvents="true"/>
																<ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="12" SuggestedHeight="12" PositionXOffset="54" VerticalAlignment="Center" Sprite="fs_diamond" DoNotAcceptEvents="true"/>
																<TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="196" HorizontalAlignment="Center" Brush="TAOM.Encyclopedia.Title" Brush.FontSize="15" Brush.FontColor="#CBA45CFF" Text="@SelectedLabel" DoNotAcceptEvents="true"/>
																<ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="12" SuggestedHeight="12" PositionXOffset="274" VerticalAlignment="Center" Sprite="fs_diamond" DoNotAcceptEvents="true"/>
																<ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="2" PositionXOffset="292" VerticalAlignment="Center" Sprite="fs_divider_thin" DoNotAcceptEvents="true"/>
															</Children>
														</Widget>

														<!--Selected title: pennant and name; the name opens the title's page-->
														<Widget DataSource="{Selected}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
															<Children>
																<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
																	<Children>
																		<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="84" SuggestedHeight="137" HorizontalAlignment="Center" MarginTop="16" DoNotAcceptEvents="true">
																			<Children>
																				<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" ClipContents="true">
																					<Children>
																						<EncyclopediaMaskedImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@BannerId" AdditionalArgs="@BannerArgs" TextureProviderName="@BannerProvider" DoNotAcceptEvents="true" Brush="TAOM.Encyclopedia.HeroClanMask" Brush.GlobalAlphaFactor="@ContentAlpha" Zoom="1.35"/>
																					</Children>
																				</Widget>
																				<ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="ec_hero_clan_drape" Brush.GlobalAlphaFactor="@ContentAlpha" DoNotAcceptEvents="true"/>
																				<ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="ec_hero_clan_rim" Brush.GlobalAlphaFactor="@ContentAlpha" DoNotAcceptEvents="true"/>
																			</Children>
																		</Widget>
																		<ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="10" MarginLeft="6" MarginRight="6" Brush="TAOM.Encyclopedia.TextButton" Command.Click="ExecuteLink" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
																			<Children>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.Encyclopedia.ListText" Brush.FontSize="25" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Top" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@TitleText" DoNotAcceptEvents="true">
																					<Children>
																						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="1" MarginRight="1" Brush="TAOM.Encyclopedia.ListText" Brush.FontSize="25" Brush.GlobalAlphaFactor="0" Text="@TitleText" DoNotAcceptEvents="true"/>
																					</Children>
																				</TextWidget>
																			</Children>
																		</ButtonWidget>
																	</Children>
																</ListPanel>
															</Children>
														</Widget>

														<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" Brush="TAOM.Encyclopedia.Title" Brush.FontSize="13" Brush.FontColor="#CBA45CFF" Text="@HolderLabel" DoNotAcceptEvents="true"/>

														<!--Selected title: holder and folded lordships-->
														<Widget DataSource="{Selected}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
															<Children>
																<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="6" MarginRight="6" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
																	<Children>
																		<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="18" Brush.TextVerticalAlignment="Top" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@HolderText" DoNotAcceptEvents="true">
																			<Children>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="1" MarginRight="1" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="18" Brush.GlobalAlphaFactor="0" Text="@HolderText" DoNotAcceptEvents="true"/>
																			</Children>
																		</TextWidget>
																		<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="2" Brush="TAOM.Encyclopedia.ListMutedCentered" Brush.FontSize="16" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@FoldedText" IsVisible="@HasFolded" DoNotAcceptEvents="true"/>
																	</Children>
																</ListPanel>
															</Children>
														</Widget>

														<!--Liege: none for the realm or for lands-->
														<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@HasLiege">
															<Children>
																<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="12" HorizontalAlignment="Center" MarginTop="18" DoNotAcceptEvents="true">
																	<Children>
																		<ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Center" Sprite="fs_divider_thin" DoNotAcceptEvents="true"/>
																		<ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="12" SuggestedHeight="12" HorizontalAlignment="Center" Sprite="fs_diamond" DoNotAcceptEvents="true"/>
																	</Children>
																</Widget>
																<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="12" MarginLeft="10" Brush="TAOM.Encyclopedia.Title" Brush.FontSize="14" Brush.FontColor="#CBA45CFF" Brush.TextHorizontalAlignment="Left" Text="@LiegeLabel" DoNotAcceptEvents="true"/>
																<ListPanel DataSource="{Liege}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
																	<ItemTemplate>
																		<ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="74" MarginTop="4" Brush="TAOM.Encyclopedia.TextButton" Command.Click="ExecuteSelect" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
																			<Children>
																				<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="65" MarginLeft="14" VerticalAlignment="Center" DoNotAcceptEvents="true">
																					<Children>
																						<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" ClipContents="true">
																							<Children>
																								<EncyclopediaMaskedImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@BannerId" AdditionalArgs="@BannerArgs" TextureProviderName="@BannerProvider" DoNotAcceptEvents="true" Brush="TAOM.Encyclopedia.HeroClanMask" Brush.GlobalAlphaFactor="@ContentAlpha" Zoom="1.35"/>
																							</Children>
																						</Widget>
																						<ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="ec_hero_clan_drape" Brush.GlobalAlphaFactor="@ContentAlpha" DoNotAcceptEvents="true"/>
																						<ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="ec_hero_clan_rim" Brush.GlobalAlphaFactor="@ContentAlpha" DoNotAcceptEvents="true"/>
																					</Children>
																				</Widget>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="70" MarginRight="8" VerticalAlignment="Center" Brush="TAOM.Encyclopedia.ListText" Brush.FontSize="18" Brush.TextHorizontalAlignment="Left" Brush.GlobalAlphaFactor="@ContentAlpha" Text="@TitleText" DoNotAcceptEvents="true"/>
																			</Children>
																		</ButtonWidget>
																	</ItemTemplate>
																</ListPanel>
															</Children>
														</ListPanel>

														<!--Subordinate titles: none for a title without vassals-->
														<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="12" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@HasSubordinates">
															<Children>
																<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="12" HorizontalAlignment="Center" MarginTop="18" DoNotAcceptEvents="true">
																	<Children>
																		<ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Center" Sprite="fs_divider_thin" DoNotAcceptEvents="true"/>
																		<ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="12" SuggestedHeight="12" HorizontalAlignment="Center" Sprite="fs_diamond" DoNotAcceptEvents="true"/>
																	</Children>
																</Widget>
																<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="12" MarginLeft="10" Brush="TAOM.Encyclopedia.Title" Brush.FontSize="14" Brush.FontColor="#CBA45CFF" Brush.TextHorizontalAlignment="Left" Text="@SubordinatesLabel" DoNotAcceptEvents="true"/>
																<ListPanel DataSource="{Subordinates}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
																	<ItemTemplate>
																		<ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="74" MarginTop="4" Brush="TAOM.Encyclopedia.TextButton" Command.Click="ExecuteSelect" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
																			<Children>
																				<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="65" MarginLeft="14" VerticalAlignment="Center" DoNotAcceptEvents="true">
