<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
      <Children>
        <!-- Top, offset southwest of center; clears the gold-cost text under the character tableau and the filter icons -->
        <ButtonWidget
            Id="PresetsButton"
            WidthSizePolicy="Fixed"
            HeightSizePolicy="Fixed"
            SuggestedWidth="90"
            SuggestedHeight="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            MarginTop="250"
            PositionXOffset="-350"
            Brush="ButtonBrush1"
            Command.Click="ExecuteOpenPresets"
            IsEnabled="true"
            DoNotPassEventsToChildren="true"
            AcceptEvents="true">
          <Children>
            <TextWidget
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                Brush="ButtonBrush1.Text"
                Text="@ButtonText"
                DoNotAcceptEvents="true"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
          </Children>
        </ButtonWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>
