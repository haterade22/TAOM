<Prefab>
  <Window>
    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
            SuggestedWidth="220" SuggestedHeight="132"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            MarginLeft="75" MarginBottom="650"
            IsVisible="@IsVisible">
      <Children>
        <!-- Background -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                Sprite="BlankWhiteSquare_9" Color="#000000AA" />

        <!-- Ability icon (top, prominent) -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="64" SuggestedHeight="64"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                MarginTop="6"
                Sprite="@AbilitySprite" />

        <!-- Ability name (below icon) -->
        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                    Text="@AbilityName" HorizontalAlignment="Center"
                    VerticalAlignment="Top" MarginTop="74"
                    Brush="ButtonBrush1.Text" Brush.FontSize="16" />

        <!-- Ready indicator (below ability name when ready) -->
        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                    Text="Press V" HorizontalAlignment="Center"
                    VerticalAlignment="Top" MarginTop="96"
                    IsVisible="@IsReady"
                    Brush="ButtonBrush1.Text" />

        <!-- Charge fill bar (very bottom) -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                SuggestedHeight="6" VerticalAlignment="Bottom"
                MarginBottom="4" MarginLeft="6" MarginRight="6">
          <Children>
            <FillBarWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                           CurrentAmount="@ChargePercent" MaxAmount="100"
                           Sprite="BlankWhiteSquare_9" />
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
