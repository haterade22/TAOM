<Prefab>
  <Constants>
  </Constants>
  <VisualDefinitions>
    <VisualDefinition Name="CareerFooterSlide" TransitionDuration="0.35">
      <VisualState PositionYOffset="8" State="Default" />
    </VisualDefinition>
    <VisualDefinition Name="CareerHeaderSlide" TransitionDuration="0.35">
      <VisualState PositionYOffset="-8" State="Default" />
    </VisualDefinition>
  </VisualDefinitions>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <Standard.Background />

        <!--Top Panel - Title-->
        <Widget VisualDefinition="CareerHeaderSlide" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="755" SuggestedHeight="182" HorizontalAlignment="Center" PositionYOffset="-182" Sprite="StdAssets\tabbar_standart" ValueFactor="-30">
          <Children>
            <RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="18" Brush="Quest.CenterPanel.Title.Text" Brush.FontSize="45" Text="@ScreenTitle" />
          </Children>
        </Widget>

        <!--Middle Area (Normal mode: perk tree)-->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsNormalMode">
          <Children>
            <!-- FIXED WIDTH, CENTRED (#388 ultrawide fix). StretchToParent made the whole
                 screen as wide as the monitor: on a 32:9 the header bar ran off into dead
                 space, its ability text drifted past centre and clipped, and the Active
                 Effects column sat far from the grid. 1720 holds the body exactly
                 (1330 tiers + 20 + 340 column + padding) and centres on any aspect ratio. -->
            <ListPanel WidthSizePolicy="Fixed" SuggestedWidth="1720" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="150" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>

                <!-- HEADER BAR: career name + description | portrait | ability -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="185" Sprite="StdAssets\Popup\canvas">
                  <Children>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>

                        <Widget WidthSizePolicy="Fixed" SuggestedWidth="700" HeightSizePolicy="StretchToParent">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginLeft="24" MarginRight="16" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="@CareerName" Brush="CareerSystem.Effects.Title" Brush.FontSize="26" Brush.TextHorizontalAlignment="Left" />
                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" Text="@CareerDescription" Brush="CareerSystem.Effects.Passive" Brush.FontSize="17" />
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>

                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="290" SuggestedHeight="150" VerticalAlignment="Center" Sprite="@CareerPortraitSprite" IsVisible="@HasCareer">
                          <Children>
                            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" IsEnabled="false" />
                          </Children>
                        </Widget>

                        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginLeft="24" StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="92" SuggestedHeight="92" VerticalAlignment="Center" Sprite="@AbilitySpriteName" IsVisible="@HasAbilitySprite">
                              <Children>
                                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" IsEnabled="false" />
                              </Children>
                            </Widget>
                            <Widget WidthSizePolicy="Fixed" SuggestedWidth="560" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginLeft="16">
                              <Children>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="@AbilityName" Brush="CareerSystem.Effects.Title" Brush.FontSize="24" Brush.TextHorizontalAlignment="Left" />
                                    <ListPanel DataSource="{AbilityEffects}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="6" StackLayout.LayoutMethod="VerticalTopToBottom">
                                      <ItemTemplate>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="@LineText" Brush="CareerSystem.Effects.Passive" Brush.FontSize="17" />
                                      </ItemTemplate>
                                    </ListPanel>
                                  </Children>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </ListPanel>

                      </Children>
                    </ListPanel>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" IsEnabled="false" />
                  </Children>
                </Widget>

                <!-- BODY: tier rows (left) + Free Points / Active Effects (right)

                     DIAMOND RIMS ARE PER-TIER METALS, so the tree reads as a progression:
                     tier 1 bronze -> tier 2 silver -> tier 3 gold. Each tier's three border
                     colours are (dim = locked, mid = available, bright = taken glow):
                       tier 1  #5A4A38 / #B08D57 / #E8B87A
                       tier 2  #565B61 / #AEB6BE / #EAF2FA
                       tier 3  #6E5C22 / #C9A227 / #FFD98C
                     The taken glow is shown by TaomCareerDiamondWidget, not by a binding, so
                     changing a tier's metal means editing all three of ITS values; they are
                     deliberately not shared between tiers. -->

                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="14" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>

                    <ListPanel WidthSizePolicy="Fixed" SuggestedWidth="1330" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="12">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>

                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" MarginLeft="8" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" Text="@Tier3Label" Brush="CareerSystem.Effects.Title" Brush.FontSize="22" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginLeft="14" Text="@Tier3RequirementText" IsVisible="@Tier3Locked" Brush="CareerSystem.Effects.Passive" Brush.FontSize="16" />
                      </Children>
                    </ListPanel>

                    <ListPanel DataSource="{ChoiceGroupsTier3}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <ItemTemplate>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="640" Command.HoverBegin="ExecuteBeginHover" Command.HoverEnd="ExecuteEndHover">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" Text="@GroupName" Brush="CareerSystem.Effects.Passive" Brush.FontSize="17" />
                                <ListPanel DataSource="{Choices}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="4" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                  <ItemTemplate>
                                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="78" SuggestedHeight="78" MarginLeft="4" MarginRight="4" DoNotPassEventsToChildren="true" Command.Click="ExecuteToggleChoice">
                                      <Children>
                                        <TaomCareerDiamondWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="70" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_mask" Color="#3A3630FF" IsTakenState="@IsTaken" IsKeystoneState="@IsKeystone">
                                          <Children>
                                            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="76" SuggestedHeight="76" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_border" Color="#6E5C22FF" IsVisible="@IsUnavailable" />
                                            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="76" SuggestedHeight="76" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_border" Color="#C9A227FF" IsVisible="@IsFreeToTake" />
                                            <Widget Id="DiamondGlow" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="80" SuggestedHeight="80" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_border" Color="#FFD98CFF" IsVisible="false" />
                                            <Widget Id="IconLocked" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@IconSprite" Color="#FFFFFF33" IsVisible="@IsUnavailable" />
                                            <Widget Id="IconFree" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@IconSprite" Color="#F2EBDCF0" IsVisible="@IsFreeToTake" />
                                            <Widget Id="IconTaken" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@IconSprite" Color="#FFD24AFF" IsVisible="@IsTaken" />
                                            <Widget Id="DiamondTooltip" DoNotAcceptEvents="true" RenderLate="true" IsVisible="false" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="360" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="-86" Sprite="StdAssets\Popup\canvas">
                                              <Children>
                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" MarginBottom="8" MarginLeft="12" MarginRight="12" StackLayout.LayoutMethod="VerticalTopToBottom">
                                                  <Children>
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="@Description" Brush="CareerSystem.Effects.Passive" Brush.FontSize="17" />
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="3" Text="@EffectScopeBadge" Brush="CareerSystem.Effects.Keystone" Brush.FontSize="14" IsVisible="@IsKeystone" />
                                                  </Children>
                                                </ListPanel>
                                                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" IsEnabled="false" />
                                              </Children>
                                            </Widget>
                                          </Children>
                                        </TaomCareerDiamondWidget>
                                      </Children>
                                    </ButtonWidget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </ItemTemplate>
                    </ListPanel>

                  </Children>
                </ListPanel>
              </Children>
            </Widget>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="12">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>

                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" MarginLeft="8" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" Text="@Tier2Label" Brush="CareerSystem.Effects.Title" Brush.FontSize="22" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginLeft="14" Text="@Tier2RequirementText" IsVisible="@Tier2Locked" Brush="CareerSystem.Effects.Passive" Brush.FontSize="16" />
                      </Children>
                    </ListPanel>

                    <ListPanel DataSource="{ChoiceGroupsTier2}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <ItemTemplate>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="640" Command.HoverBegin="ExecuteBeginHover" Command.HoverEnd="ExecuteEndHover">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" Text="@GroupName" Brush="CareerSystem.Effects.Passive" Brush.FontSize="17" />
                                <ListPanel DataSource="{Choices}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="4" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                  <ItemTemplate>
                                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="78" SuggestedHeight="78" MarginLeft="4" MarginRight="4" DoNotPassEventsToChildren="true" Command.Click="ExecuteToggleChoice">
                                      <Children>
                                        <TaomCareerDiamondWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="70" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_mask" Color="#3A3630FF" IsTakenState="@IsTaken" IsKeystoneState="@IsKeystone">
                                          <Children>
                                            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="76" SuggestedHeight="76" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_border" Color="#565B61FF" IsVisible="@IsUnavailable" />
                                            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="76" SuggestedHeight="76" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_border" Color="#AEB6BEFF" IsVisible="@IsFreeToTake" />
                                            <Widget Id="DiamondGlow" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="80" SuggestedHeight="80" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_border" Color="#EAF2FAFF" IsVisible="false" />
                                            <Widget Id="IconLocked" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@IconSprite" Color="#FFFFFF33" IsVisible="@IsUnavailable" />
                                            <Widget Id="IconFree" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@IconSprite" Color="#F2EBDCF0" IsVisible="@IsFreeToTake" />
                                            <Widget Id="IconTaken" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@IconSprite" Color="#FFD24AFF" IsVisible="@IsTaken" />
                                            <Widget Id="DiamondTooltip" DoNotAcceptEvents="true" RenderLate="true" IsVisible="false" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="360" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="-86" Sprite="StdAssets\Popup\canvas">
                                              <Children>
                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" MarginBottom="8" MarginLeft="12" MarginRight="12" StackLayout.LayoutMethod="VerticalTopToBottom">
                                                  <Children>
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="@Description" Brush="CareerSystem.Effects.Passive" Brush.FontSize="17" />
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="3" Text="@EffectScopeBadge" Brush="CareerSystem.Effects.Keystone" Brush.FontSize="14" IsVisible="@IsKeystone" />
                                                  </Children>
                                                </ListPanel>
                                                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" IsEnabled="false" />
                                              </Children>
                                            </Widget>
                                          </Children>
                                        </TaomCareerDiamondWidget>
                                      </Children>
                                    </ButtonWidget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </ItemTemplate>
                    </ListPanel>

                  </Children>
                </ListPanel>
              </Children>
            </Widget>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="12">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>

                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" MarginLeft="8" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" Text="@Tier1Label" Brush="CareerSystem.Effects.Title" Brush.FontSize="22" />
                      </Children>
                    </ListPanel>

                    <ListPanel DataSource="{ChoiceGroupsTier1}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <ItemTemplate>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="640" Command.HoverBegin="ExecuteBeginHover" Command.HoverEnd="ExecuteEndHover">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" Text="@GroupName" Brush="CareerSystem.Effects.Passive" Brush.FontSize="17" />
                                <ListPanel DataSource="{Choices}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="4" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                  <ItemTemplate>
                                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="78" SuggestedHeight="78" MarginLeft="4" MarginRight="4" DoNotPassEventsToChildren="true" Command.Click="ExecuteToggleChoice">
                                      <Children>
                                        <TaomCareerDiamondWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="70" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_mask" Color="#3A3630FF" IsTakenState="@IsTaken" IsKeystoneState="@IsKeystone">
                                          <Children>
                                            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="76" SuggestedHeight="76" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_border" Color="#5A4A38FF" IsVisible="@IsUnavailable" />
                                            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="76" SuggestedHeight="76" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_border" Color="#B08D57FF" IsVisible="@IsFreeToTake" />
                                            <Widget Id="DiamondGlow" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="80" SuggestedHeight="80" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="TAOM\Encyclopedia\clan_diamond_border" Color="#E8B87AFF" IsVisible="false" />
                                            <Widget Id="IconLocked" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@IconSprite" Color="#FFFFFF33" IsVisible="@IsUnavailable" />
                                            <Widget Id="IconFree" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@IconSprite" Color="#F2EBDCF0" IsVisible="@IsFreeToTake" />
                                            <Widget Id="IconTaken" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@IconSprite" Color="#FFD24AFF" IsVisible="@IsTaken" />
                                            <Widget Id="DiamondTooltip" DoNotAcceptEvents="true" RenderLate="true" IsVisible="false" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="360" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="-86" Sprite="StdAssets\Popup\canvas">
                                              <Children>
                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" MarginBottom="8" MarginLeft="12" MarginRight="12" StackLayout.LayoutMethod="VerticalTopToBottom">
                                                  <Children>
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="@Description" Brush="CareerSystem.Effects.Passive" Brush.FontSize="17" />
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="3" Text="@EffectScopeBadge" Brush="CareerSystem.Effects.Keystone" Brush.FontSize="14" IsVisible="@IsKeystone" />
                                                  </Children>
                                                </ListPanel>
                                                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" IsEnabled="false" />
                                              </Children>
                                            </Widget>
                                          </Children>
                                        </TaomCareerDiamondWidget>
                                      </Children>
                                    </ButtonWidget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </ItemTemplate>
                    </ListPanel>

                  </Children>
                </ListPanel>
              </Children>
            </Widget>
                      </Children>
                    </ListPanel>

                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="340" HeightSizePolicy="CoverChildren" MarginLeft="20" MarginTop="12">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="@FreeCareerPointsText" Brush="CareerSystem.Effects.Title" Brush.FontSize="22" />
                            <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="4" MarginTop="10" Sprite="Clan\divider_mid" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="10" Text="@ActiveEffectsLabel" Brush="CareerSystem.Effects.Title" Brush.FontSize="22" />
                            <ListPanel DataSource="{KeystoneEffectLines}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="3" Text="@LineText" Brush="CareerSystem.Effects.Keystone" Brush.FontSize="17" />
                              </ItemTemplate>
                            </ListPanel>
                            <ListPanel DataSource="{PassiveEffectLines}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="2" Text="@LineText" Brush="CareerSystem.Effects.Passive" Brush.FontSize="17" />
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>

                  </Children>
                </ListPanel>

              </Children>
            </ListPanel>
          </Children>
        </Widget>

        <!--Middle Area (Switch mode: career picker invoked from "I wish to discuss my career path" dialogue)-->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="920" HorizontalAlignment="Center" VerticalAlignment="Center" MarginTop="60" IsVisible="@IsSwitchMode">
          <Children>
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="1400" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" Sprite="StdAssets\Popup\canvas">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="VerticalTopToBottom" MarginTop="30" MarginLeft="40" MarginRight="40">
                  <Children>
                    <!-- Picker header -->
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" Text="@SwitchModeSubtitle" Brush="CharacterDeveloper.DescriptionText" Brush.FontSize="20" />
                    <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="4" MarginTop="15" Sprite="Clan\divider_mid" />

                    <!-- Empty-state message: shown when switch mode is active but the eligible-targets list is empty -->
                    <!-- (forced static-entry-point, stale eligibility, or _heroAdapter == null) -->
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="60" Text="@NoTargetsMessage" Brush="CharacterDeveloper.DescriptionText" Brush.FontSize="20" IsVisible="@HasNoSwitchTargets" />

                    <!-- Eligible target list (scrollable). Hidden when EligibleSwitchTargets is empty -->
                    <!-- so the prior render doesn't leave a 760px tall blank scroll canvas (Codex Review #32). -->
                    <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="760" MarginTop="20" ClipRect="SwitchPickerClip" InnerPanel="SwitchPickerInner" AutoHideScrollBars="true" IsVisible="@IsBrowsingTargets">
                      <Children>
                        <Widget Id="SwitchPickerClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <Widget Id="SwitchPickerInner" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                              <Children>
                                <ListPanel DataSource="{EligibleSwitchTargets}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <!-- Per-target card: portrait | name + description + ability | Choose button -->
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="180" MarginTop="10" MarginBottom="10" Sprite="StdAssets\Popup\canvas">
                                      <Children>
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginLeft="20" MarginRight="20" MarginTop="10" MarginBottom="10">
                                          <Children>
                                            <!-- Portrait -->
                                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="220" SuggestedHeight="150" VerticalAlignment="Center" Sprite="@PortraitSprite">
                                              <Children>
                                                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" IsEnabled="false" />
                                              </Children>
                                            </Widget>

                                            <!-- Name + description + ability label -->
                                            <Widget WidthSizePolicy="Fixed" SuggestedWidth="780" HeightSizePolicy="StretchToParent" MarginLeft="20">
                                              <Children>
