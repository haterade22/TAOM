<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <!-- The themed Long Defeat panel, loaded in place of LongDefeatPanel by FrontEndMovieService and bound to LongDefeatHudVM. A focus layer
         (LongDefeatPanelHost): the shop, small on the left (580x724 at 64,132 on the 1920x1080 canvas) with its Reinforcements and
         Fortifications tabs; the boon pick beside it (440x600 at 664,240) while one is on offer; the end summary in the centre. The root
         takes events so a click beside the panels never reaches the mission, but draws nothing, so the battle stays in view. Every purchase,
         pick and reroll is the run's own command; only the key letter is literal. The movie root carries no DataSource. -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- SHOP -->
        <EncyclopediaStonePanelWidget Id="ShopPanel" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="580" SuggestedHeight="724"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="64" MarginTop="132" Sprite="ec_panel_9" IsVisible="@IsShopVisible">
          <Children>
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="46" MarginLeft="34" MarginTop="20" Brush="TAOM.LD.Title" Text="@ShopTitle" DoNotAcceptEvents="true" />
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="46" HorizontalAlignment="Right" MarginRight="34" MarginTop="20"
                       StackLayout.LayoutMethod="HorizontalLeftToRight" DoNotAcceptEvents="true">
              <Children>
                <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="46" SuggestedHeight="46" VerticalAlignment="Center" MarginRight="14" Brush="TAOM.LD.GoldIcon" DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" Brush="TAOM.LD.Purse" Text="@GoldValue" DoNotAcceptEvents="true" />
              </Children>
            </ListPanel>
            <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" MarginLeft="22" MarginRight="22" MarginTop="78" Brush="TAOM.LD.Rule" DoNotAcceptEvents="true" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginLeft="34" MarginRight="34" MarginTop="90" Brush="TAOM.LD.Timer" Text="@ShopTimerText" DoNotAcceptEvents="true" />

            <!-- Tabs: Reinforcements first and default; Fortifications only while the build sells one. Every width here is fixed
                 (528 = 240 + 48 + 240 inside the 580 shop), so no button measures from a child that stretches to it. -->
            <Widget Id="LdShopTabs" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="528" SuggestedHeight="46" MarginLeft="26" MarginTop="130">
              <Children>
                <ButtonWidget Id="LdTabReinforcements" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="240" SuggestedHeight="46" HorizontalAlignment="Left"
                              Brush="TAOM.LD.Tab" Command.Click="ExecuteShowReinforcements" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginBottom="4" Brush="TAOM.LD.TabText" Text="@ReinforcementsText" IsHidden="@IsReinforcementsTab" DoNotAcceptEvents="true" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginBottom="4" Brush="TAOM.LD.TabTextSelected" Text="@ReinforcementsText" IsVisible="@IsReinforcementsTab" DoNotAcceptEvents="true" />
                    <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Brush="TAOM.LD.Accent" IsVisible="@IsReinforcementsTab" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
                <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1" SuggestedHeight="24" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="TAOM.LD.Rule" IsVisible="@HasFortTab" DoNotAcceptEvents="true" />
                <ButtonWidget Id="LdTabFortifications" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="240" SuggestedHeight="46" HorizontalAlignment="Right"
                              Brush="TAOM.LD.Tab" Command.Click="ExecuteShowFortifications" IsVisible="@HasFortTab" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginBottom="4" Brush="TAOM.LD.TabText" Text="@FortificationsText" IsHidden="@IsFortificationsTab" DoNotAcceptEvents="true" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginBottom="4" Brush="TAOM.LD.TabTextSelected" Text="@FortificationsText" IsVisible="@IsFortificationsTab" DoNotAcceptEvents="true" />
                    <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Brush="TAOM.LD.Accent" IsVisible="@IsFortificationsTab" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
            <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" MarginLeft="22" MarginRight="22" MarginTop="182" Brush="TAOM.LD.Rule" DoNotAcceptEvents="true" />

            <!-- Reinforcements: the run's packs for this faction and map, in a bounded scroll. -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="404" MarginLeft="8" MarginRight="14" MarginTop="190" IsVisible="@IsReinforcementsTab">
              <Children>
                <ScrollablePanel Id="OfferScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="14" InnerPanel="OfferClip\Offers" ClipRect="OfferClip"
                                 VerticalScrollbar="..\OfferScrollbar" MouseScrollAxis="Vertical" AutoHideScrollBars="true" AutoHideScrollBarHandle="true">
                  <Children>
                    <Widget Id="OfferClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="Offers" DataSource="{Offers}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="76" Brush="TAOM.LD.Row" IsEnabled="@CanAfford" Command.Click="ExecuteBuy"
                                          DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                              <Children>
                                <ScrollingTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" MarginLeft="22" MarginRight="150" MarginTop="8" Brush="TAOM.LD.RowName" Text="@Name" DoNotAcceptEvents="true" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" MarginLeft="22" MarginRight="150" MarginTop="40" Brush="TAOM.LD.RowDetail" Text="@PackText" DoNotAcceptEvents="true" />
                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="140" HorizontalAlignment="Right" MarginRight="18" Brush="TAOM.LD.RowPrice" Text="@PriceText" DoNotAcceptEvents="true" />
                                <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" VerticalAlignment="Bottom" MarginLeft="18" MarginRight="10" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="OfferScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="12" HorizontalAlignment="Right" MarginTop="6" MarginBottom="6"
                                 AlignmentAxis="Vertical" MinValue="0" MaxValue="100" Handle="Handle">
                  <Children>
                    <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1" HorizontalAlignment="Center" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                    <ImageWidget Id="Handle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="9" SuggestedHeight="90" HorizontalAlignment="Center" Brush="TAOM.LD.ScrollHandle" />
                  </Children>
                </ScrollbarWidget>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="80" MarginLeft="22" MarginRight="22" MarginTop="40" Brush="TAOM.LD.Hint" Text="@NoOffersText" IsVisible="@IsOffersEmpty" DoNotAcceptEvents="true" />
              </Children>
            </Widget>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" MarginLeft="34" MarginRight="34" MarginTop="604" Brush="TAOM.LD.Hint" Text="@ShopHintText" IsVisible="@IsReinforcementsTab" DoNotAcceptEvents="true" />

            <!-- Fortifications: the build's fortification rows; each row is the run's own buy, spent or topped rows stay listed and greyed. -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="460" MarginLeft="8" MarginRight="14" MarginTop="190" IsVisible="@IsFortificationsTab">
              <Children>
                <ScrollablePanel Id="FortScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="14" InnerPanel="FortClip\FortRows" ClipRect="FortClip"
                                 VerticalScrollbar="..\FortScrollbar" MouseScrollAxis="Vertical" AutoHideScrollBars="true" AutoHideScrollBarHandle="true">
                  <Children>
                    <Widget Id="FortClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="FortRows" DataSource="{Fort}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <Children>
                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.Row" IsVisible="@IsCareVisible" IsEnabled="@CanBuyCare" Command.Click="ExecuteBuyCare" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                              <Children>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="22" MarginRight="160" MarginTop="10" MarginBottom="12" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" Brush="TAOM.LD.RowName" Text="@CareName" DoNotAcceptEvents="true" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.RowDetail" Text="@CareDetail" DoNotAcceptEvents="true" />
                                  </Children>
                                </ListPanel>
                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="32" HorizontalAlignment="Right" MarginRight="18" MarginTop="10" Brush="TAOM.LD.RowPrice" Text="@CarePrice" DoNotAcceptEvents="true" />
                                <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" VerticalAlignment="Bottom" MarginLeft="18" MarginRight="10" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                              </Children>
                            </ButtonWidget>
                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.Row" IsVisible="@IsGateVisible" IsEnabled="@CanBuyGate" Command.Click="ExecuteBuyGate" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                              <Children>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="22" MarginRight="160" MarginTop="10" MarginBottom="12" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" Brush="TAOM.LD.RowName" Text="@GateName" DoNotAcceptEvents="true" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.RowDetail" Text="@GateDetail" DoNotAcceptEvents="true" />
                                  </Children>
                                </ListPanel>
                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="32" HorizontalAlignment="Right" MarginRight="18" MarginTop="10" Brush="TAOM.LD.RowPrice" Text="@GatePrice" DoNotAcceptEvents="true" />
                                <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" VerticalAlignment="Bottom" MarginLeft="18" MarginRight="10" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                              </Children>
                            </ButtonWidget>
                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.Row" IsVisible="@IsRepairVisible" IsEnabled="@CanRepair" Command.Click="ExecuteRepair" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                              <Children>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="22" MarginRight="160" MarginTop="10" MarginBottom="12" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" Brush="TAOM.LD.RowName" Text="@RepairName" DoNotAcceptEvents="true" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.RowDetail" Text="@RepairDetail" DoNotAcceptEvents="true" />
                                  </Children>
                                </ListPanel>
                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="32" HorizontalAlignment="Right" MarginRight="18" MarginTop="10" Brush="TAOM.LD.RowPrice" Text="@RepairPrice" DoNotAcceptEvents="true" />
                                <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" VerticalAlignment="Bottom" MarginLeft="18" MarginRight="10" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                              </Children>
                            </ButtonWidget>
                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.Row" IsVisible="@IsTowersVisible" IsEnabled="@CanBuyTowers" Command.Click="ExecuteBuyTowers" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                              <Children>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="22" MarginRight="160" MarginTop="10" MarginBottom="12" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" Brush="TAOM.LD.RowName" Text="@TowersName" DoNotAcceptEvents="true" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.RowDetail" Text="@TowersDetail" DoNotAcceptEvents="true" />
                                  </Children>
                                </ListPanel>
                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="32" HorizontalAlignment="Right" MarginRight="18" MarginTop="10" Brush="TAOM.LD.RowPrice" Text="@TowersPrice" DoNotAcceptEvents="true" />
                                <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" VerticalAlignment="Bottom" MarginLeft="18" MarginRight="10" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                              </Children>
                            </ButtonWidget>
                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.Row" IsVisible="@IsVolleyVisible" IsEnabled="@CanBuyVolley" Command.Click="ExecuteBuyVolley" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                              <Children>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="22" MarginRight="160" MarginTop="10" MarginBottom="12" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" Brush="TAOM.LD.RowName" Text="@VolleyName" DoNotAcceptEvents="true" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.RowDetail" Text="@VolleyDetail" DoNotAcceptEvents="true" />
                                  </Children>
                                </ListPanel>
                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="32" HorizontalAlignment="Right" MarginRight="18" MarginTop="10" Brush="TAOM.LD.RowPrice" Text="@VolleyPrice" DoNotAcceptEvents="true" />
                                <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" VerticalAlignment="Bottom" MarginLeft="18" MarginRight="10" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                              </Children>
                            </ButtonWidget>
                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="FortScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="12" HorizontalAlignment="Right" MarginTop="6" MarginBottom="6"
                                 AlignmentAxis="Vertical" MinValue="0" MaxValue="100" Handle="Handle">
                  <Children>
                    <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1" HorizontalAlignment="Center" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                    <ImageWidget Id="Handle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="9" SuggestedHeight="90" HorizontalAlignment="Center" Brush="TAOM.LD.ScrollHandle" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <!-- Fixed footer: the close, which B (LongDefeatPanelHost.ReadKeys) and Esc (LongDefeatPanelHost.Sync) also do. No speed selector and no horn here. -->
            <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" MarginLeft="22" MarginRight="22" MarginTop="656" Brush="TAOM.LD.Rule" DoNotAcceptEvents="true" />
            <ButtonWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="40" MarginLeft="26" MarginTop="668" Brush="TAOM.LD.TextButton" Command.Click="ExecuteClose"
                          DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
              <Children>
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="8" MarginRight="8" StackLayout.LayoutMethod="HorizontalLeftToRight" DoNotAcceptEvents="true">
                  <Children>
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginRight="14" Brush="TAOM.LD.FooterText" Text="B" DoNotAcceptEvents="true" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" Brush="TAOM.LD.FooterText" Text="@CloseText" DoNotAcceptEvents="true" />
                  </Children>
                </ListPanel>
              </Children>
            </ButtonWidget>
          </Children>
        </EncyclopediaStonePanelWidget>

        <!-- BOONS: detached, text only, shown while the open shop has a pick on offer. Its close hides the panel until the shop is next opened; the pick stays on offer. -->
        <EncyclopediaStonePanelWidget Id="BoonPanel" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="480" SuggestedHeight="700"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="664" MarginTop="170" Sprite="ec_panel_9" IsVisible="@IsBoonPanelVisible">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" MarginLeft="30" MarginRight="70" MarginTop="18" Brush="TAOM.LD.Title" Text="@PickTitle" DoNotAcceptEvents="true" />
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30" HorizontalAlignment="Right" MarginRight="30" MarginTop="24"
                          Brush="TAOM.Encyclopedia.Close" Command.Click="ExecuteHideBoons" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" MarginLeft="30" MarginRight="30" MarginTop="60" Brush="TAOM.LD.Subtitle" Text="@PickSubtitle" DoNotAcceptEvents="true" />
            <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" MarginLeft="24" MarginRight="24" MarginTop="98" Brush="TAOM.LD.Rule" DoNotAcceptEvents="true" />

            <!-- 510 high: three English cards fit at once; the scroll is only for unusually long translations. -->
            <Widget Id="LdBoonBody" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="510" MarginLeft="14" MarginRight="14" MarginTop="106">
              <Children>
                <ScrollablePanel Id="BoonScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="14" InnerPanel="BoonClip\Boons" ClipRect="BoonClip"
                                 VerticalScrollbar="..\BoonScrollbar" MouseScrollAxis="Vertical" AutoHideScrollBars="true" AutoHideScrollBarHandle="true">
                  <Children>
                    <Widget Id="BoonClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="Boons" DataSource="{Boons}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <!-- Height comes from the text column only; the hover accent has a fixed size, so nothing stretches to the card. -->
                            <ButtonWidget Id="LdBoonCard" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.Row" Command.Click="ExecutePick" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                              <Children>
                                <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="3" SuggestedHeight="44" MarginLeft="4" MarginTop="10" Brush="TAOM.LD.BoonHover" DoNotAcceptEvents="true" />
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="20" MarginRight="8" MarginTop="8" MarginBottom="10" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.BoonName" Text="@Name" DoNotAcceptEvents="true" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.BoonCategory" Text="@CategoryText" DoNotAcceptEvents="true" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="1" Brush="TAOM.LD.BoonText" Text="@Text" DoNotAcceptEvents="true" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="2" Brush="TAOM.LD.BoonDrawback" Text="@DrawbackText" IsVisible="@HasDrawback" DoNotAcceptEvents="true" />
                                  </Children>
                                </ListPanel>
                                <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" VerticalAlignment="Bottom" MarginLeft="22" MarginRight="6" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="BoonScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="12" HorizontalAlignment="Right" MarginTop="6" MarginBottom="6"
                                 AlignmentAxis="Vertical" MinValue="0" MaxValue="100" Handle="Handle">
                  <Children>
                    <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1" HorizontalAlignment="Center" Brush="TAOM.LD.RowRule" DoNotAcceptEvents="true" />
                    <ImageWidget Id="Handle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="9" SuggestedHeight="90" HorizontalAlignment="Center" Brush="TAOM.LD.ScrollHandle" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="320" SuggestedHeight="44" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="28"
                          Brush="TAOM.LD.Button" IsEnabled="@CanReroll" Command.Click="ExecuteReroll" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="40" MarginRight="40" PositionYOffset="-2" Brush="TAOM.LD.ButtonText" Text="@RerollText" DoNotAcceptEvents="true" />
              </Children>
            </ButtonWidget>
          </Children>
        </EncyclopediaStonePanelWidget>

        <!-- END OF RUN: the result, the run's lines, the best run, the report file and the way back. Esc dismisses it, as before. -->
        <EncyclopediaStonePanelWidget Id="EndPanel" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Sprite="ec_panel_9" IsVisible="@IsEndVisible">
          <Children>
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="40" MarginRight="40" MarginTop="34" MarginBottom="34" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.EndTitle" Text="@EndTitle" DoNotAcceptEvents="true" />
                <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" MarginTop="14" MarginBottom="14" Brush="TAOM.LD.Rule" DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="TAOM.LD.EndText" Text="@EndLines" DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="12" Brush="TAOM.LD.EndMuted" Text="@BestText" DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="10" Brush="TAOM.LD.EndMuted" Text="@ReportText" DoNotAcceptEvents="true" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="364" SuggestedHeight="50" HorizontalAlignment="Center" MarginTop="22"
                              Brush="TAOM.LD.Button" Command.Click="ExecuteLeave" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="40" MarginRight="40" PositionYOffset="-2" Brush="TAOM.LD.ButtonText" Text="@LeaveText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>
          </Children>
        </EncyclopediaStonePanelWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
