<Window>
  <!-- Reskinned copy of the native Modules\Native\GUI\Prefabs\CharacterCreation\CharacterCreationGainedProperties.xml
       (2026-09-24). Deliberately renamed (tag/file "TAOMGainedProperties" instead of the native
       "CharacterCreationGainedProperties") so deploying it can NEVER silently override the native file across
       the whole game - Gauntlet prefabs resolve by filename across all loaded modules, "later module wins", the
       same mechanism already used deliberately for LoadingWindow.xml in this project; overriding the native
       name would also affect the Finalizer's safe-fallback-to-native path in MainMenuPatch.cs if our narrative
       screen ever failed to load, defeating that safety net. Structure/bindings are otherwise IDENTICAL to
       native - this renders real skill/attribute/trait icons via native widgets (SkillIconVisualWidget etc,
       stubbed for preview only in src\StubWidgets.cs), which is out of scope to rebuild; only the divider
       colour is retinted to this project's own gold (#C9AB69 instead of native's #CDA970) for palette cohesion. -->
  <!-- FIX 2026-09-24 (round 2, chrome pass): the whole ledger used to float directly on the scene with no
       panel/header of its own - fine when everything else was equally native/unstyled, but it stood out badly
       once its skill icons got the new hand-made gold artwork. Sprite= goes directly on this CoverChildren
       container (originally fs_tile_9, swapped to the stone-textured fs_tile_stone_9 in a later round - see
       below), not a separate StretchToParent overlay child - this project has a documented
       circular-sizing bug where a StretchToParent child inside a CoverChildren parent makes the parent balloon
       (see TAOMNarrativeStage.xml's option-row accent-bar fix) - painting the background sprite on the
       container that already computes its own size from real children sidesteps that entirely. Padding is
       created by giving the new inner content ListPanel its own margins, not by the (nonexistent) padding
       concept - the outer tile just paints flush to whatever bounds the inner margins produce. -->
  <!-- BUG FIX (2026-09-25): VerticalAlignment="Center" on the full 1080-tall screen made this card's real
       height (6 attribute groups' worth of content, larger than an earlier rough estimate) reach down far
       enough to overlap the Back button, confirmed by an in-game screenshot. Switched to Top-anchored with a
       fixed MarginTop (matching RightPanel's own Title MarginTop for visual symmetry) - this is the more
       robust fix versus re-guessing a height for centering, since top-anchored content only grows downward
       from a known point instead of expanding in both directions from a computed center. Combined with a
       modest internal size trim below (icon frame 70->60, icon 61->52, pip frame 63x25->58x22, tighter
       row/group margins) to keep the real total height safely clear of the Back button's zone. -->
  <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Top" MarginTop="70" MarginLeft="20" DoNotUseCustomScaleAndChildren="true" Sprite="fs_tile_stone_9" AlphaFactor="0.96">
    <Children>
    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="22" MarginRight="22" MarginTop="16" MarginBottom="16" DoNotUseCustomScaleAndChildren="true" StackLayout.LayoutMethod="VerticalTopToBottom">
      <Children>

      <FrontEndTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginBottom="4" Brush="CC.SecTitle" LocalizedText="{=taom_fui_base_attributes}Base Attributes" />
      <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="290" SuggestedHeight="10" MarginBottom="5" Sprite="fs_divider_thin" DoNotAcceptEvents="true" />

      <NavigationScopeTargeter ScopeID="GainedPropertiesScope" ScopeParent="..\GainedProperties" ScopeMovements="Horizontal" AlternateScopeMovements="Vertical" AlternateMovementStepSize="3" />
      <NavigatableListPanel Id="GainedProperties" DataSource="{GainGroups}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" StepSize="100">
        <ItemTemplate>
          <ListPanel Id="GainGroupParent" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" MarginTop="3" MarginBottom="3" DoNotUseCustomScaleAndChildren="true">
            <Children>
              <SiblingIndexVisibilityWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="290" SuggestedHeight="2" Sprite="GradientDivider_9" Color="#C9AB69FF" IndexToBeVisible="0" WatchType="BiggerThan" WidgetToWatch="..\." MarginBottom="5" />

              <Widget DataSource="{Attribute}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" DoNotPassEventsToChildren="true">
                <Children>
                  <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" IsHidden="@HasIncreasedInCurrentStage" Text="@NameText" ClipContents="false" Brush="CC.RowLabel" />
                  <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" IsVisible="@HasIncreasedInCurrentStage" DoNotPassEventsToChildren="true">
                    <Children>
                      <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="CC.RowLabel" Brush.FontColor="#E3E172FF" Text="@NameText" ClipContents="false">
                        <Children>
                          <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="9" SuggestedHeight="13" PositionXOffset="15" VerticalAlignment="Center" HorizontalAlignment="Right" Sprite="General\CharacterCreation\increasing_icon" Color="#ACAC48FF" />
                        </Children>
                      </TextWidget>
                    </Children>
                  </ListPanel>
                  <HintWidget DataSource="{Hint}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint"/>
                </Children>
              </Widget>

              <NavigationTargetSwitcher FromTarget="..\." ToTarget="..\Skills" />
              <NavigatableListPanel Id="Skills" DataSource="{Skills}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="8" UseSelfIndexForMinimum="true">
                <ItemTemplate>
                  <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="13" MarginRight="13" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotUseCustomScaleAndChildren="true">
                    <Children>
                      <!-- FIX 2026-09-24: SkillIconVisualWidget just sets its own Sprite property directly in
                           native code (SPGeneral\Skills\gui_skills_icon_<id>_small) - it draws no frame of its
                           own, so the icon's own tile-mosaic art was floating loose on the frameless scene with
                           no containing edge, reading as messy/broken rather than intentional. Wrapped in the
                           same cc_card_9 dark-rounded-card sprite already used for Gender/Race selection cards
                           elsewhere in this project, so every icon now sits in a proper "slot" instead of
                           floating free - this is a framing fix, not a change to the icon art itself (that's
                           TAOM's own established skill icon set, used the same way on TAOM's other UI screens,
                           left untouched). -->
                      <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="60" SuggestedHeight="60" HorizontalAlignment="Center">
                        <Children>
                          <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="cc_card_9" DoNotAcceptEvents="true" />
                          <SkillIconVisualWidget DataSource="{Skill}" WidthSizePolicy = "Fixed" HeightSizePolicy = "Fixed" SuggestedWidth="52" SuggestedHeight="52" HorizontalAlignment="Center" VerticalAlignment="Center" SkillId="@SkillId" UseSmallVariation="true">
                            <Children>
                              <HintWidget DataSource="{Hint}" HeightSizePolicy ="StretchToParent" WidthSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint"/>
                            </Children>
                          </SkillIconVisualWidget>
                        </Children>
                      </Widget>

                      <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="58" SuggestedHeight="22" MarginTop="4">
                        <Children>
                          <ListPanel DataSource="{FocusPointGainList}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="58" SuggestedHeight="22" Sprite="General\CharacterCreation\focus_amount_frame" Color="#6E5324FF" ForcePixelPerfectPlacement="true">
                            <ItemTemplate>
                              <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="6" SuggestedHeight="16" MarginLeft="5" MarginRight="1" VerticalAlignment="Center" DoNotUseCustomScaleAndChildren="true">
                                <Children>
                                  <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare" Color="#99DC30FF" IsVisible="@IsActive" />
                                  <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare" Color="#99DC30FF" ColorFactor="0.5" IsHidden="@IsActive" />
                                </Children>
                              </Widget>
                            </ItemTemplate>
                          </ListPanel>
                          <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="9" SuggestedHeight="13" Sprite="General\CharacterCreation\increasing_icon" Color="#99DC30FF" MarginLeft="5" IsVisible="@HasIncreasedInCurrentStage" VerticalAlignment="Center" />
                        </Children>
                      </ListPanel>
                    </Children>
                  </ListPanel>
                </ItemTemplate>
              </NavigatableListPanel>

            </Children>
          </ListPanel>
        </ItemTemplate>
      </NavigatableListPanel>

      <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="290" SuggestedHeight="2" Sprite="GradientDivider_9" Color="#C9AB69FF" MarginTop="5" MarginBottom="5" />
      <NavigationScopeTargeter ScopeID="OtherSkillsScope" ScopeParent="..\OtherSkills" ScopeMovements="Horizontal" />
      <NavigatableListPanel Id="OtherSkills" DataSource="{OtherSkills}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="10" MarginBottom="5" UseSelfIndexForMinimum="true">
        <ItemTemplate>
          <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="13" MarginRight="13" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotUseCustomScaleAndChildren="true">
            <Children>
              <!-- same card-frame fix as the Skills item template above -->
              <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="70" HorizontalAlignment="Center">
                <Children>
                  <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="cc_card_9" DoNotAcceptEvents="true" />
                  <SkillIconVisualWidget DataSource="{Skill}" WidthSizePolicy = "Fixed" HeightSizePolicy = "Fixed" SuggestedWidth="61" SuggestedHeight="61" HorizontalAlignment="Center" VerticalAlignment="Center" SkillId="@SkillId" UseSmallVariation="true">
                    <Children>
                      <HintWidget DataSource="{Hint}" HeightSizePolicy ="StretchToParent" WidthSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint"/>
                    </Children>
                  </SkillIconVisualWidget>
                </Children>
              </Widget>

              <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="63" SuggestedHeight="25" MarginTop="5">
                <Children>
                  <ListPanel DataSource="{FocusPointGainList}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="63" SuggestedHeight="25" Sprite="General\CharacterCreation\focus_amount_frame" Color="#6E5324FF" ForcePixelPerfectPlacement="true">
                    <ItemTemplate>
                      <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="6" SuggestedHeight="16" MarginLeft="5" MarginRight="1" VerticalAlignment="Center" DoNotUseCustomScaleAndChildren="true">
                        <Children>
                          <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare" Color="#99DC30FF" IsVisible="@IsActive" />
                          <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare" Color="#99DC30FF" ColorFactor="0.5" IsHidden="@IsActive" />
                        </Children>
                      </Widget>
                    </ItemTemplate>
                  </ListPanel>
                  <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="9" SuggestedHeight="13" Sprite="General\CharacterCreation\increasing_icon" Color="#99DC30FF" MarginLeft="5" IsVisible="@HasIncreasedInCurrentStage" VerticalAlignment="Center" />
                </Children>
              </ListPanel>
            </Children>
          </ListPanel>
        </ItemTemplate>
      </NavigatableListPanel>

      </Children>
    </ListPanel>
    </Children>
  </ListPanel>
</Window>
