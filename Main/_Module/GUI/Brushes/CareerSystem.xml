<Brushes>

  <!-- Issue #378 — Gauntlet derives pressed/hovered visuals ONLY from a Brush; a bare
       Sprite= on a ButtonWidget has no press state at all (BrushWidget.Sprite writes only
       the Default style's Default layer). These brushes reuse the existing baked sprites
       with per-style ColorFactor variants, so no new art / sprite-bake pass is needed. -->

  <Brush Name="CareerSystem.CareerButton">
    <Layers>
      <BrushLayer Name="Default" Sprite="CareerSystem\career_button_placeholder" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1.0" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.25" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.75" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.5" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="CareerSystem.PlusButton">
    <Layers>
      <BrushLayer Name="Default" Sprite="CareerSystem\plus_sign_icon" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1.0" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.25" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.75" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.5" />
      </Style>
    </Styles>
  </Brush>

  <!-- Issue #379 badge count. Deep-review 2026-08-05: the previously-referenced
       "ButtonBrush1.Text" does not exist in any brush file (BrushFactory returns null
       silently for unregistered names) — the badge needs a REAL registered text brush. -->
  <Brush Name="CareerSystem.Badge.Text" Font="minionpro" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#FFFFFFFF" TextOutlineColor="#000000FF" TextOutlineAmount="0.15" FontSize="24" />
    </Styles>
  </Brush>

  <!-- #388 Active Effects panel. Keystone lines gold (they change the ability), passive
       totals parchment-cream (they are always on). -->
  <Brush Name="CareerSystem.Effects.Keystone" Font="minionpro">
    <Styles>
      <Style Name="Default" FontColor="#F2C14EFF" TextOutlineColor="#000000FF" TextOutlineAmount="0.1" FontSize="18" />
    </Styles>
  </Brush>

  <Brush Name="CareerSystem.Effects.Passive" Font="minionpro">
    <Styles>
      <Style Name="Default" FontColor="#FDF3DEFF" TextOutlineColor="#000000FF" TextOutlineAmount="0.1" FontSize="18" />
    </Styles>
  </Brush>

  <Brush Name="CareerSystem.Effects.Title" Font="minionpro" TextHorizontalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#C6AC8DFF" TextOutlineColor="#000000FF" TextOutlineAmount="0.1" FontSize="22" />
    </Styles>
  </Brush>

  <Brush Name="CareerSystem.MinusButton">
    <Layers>
      <BrushLayer Name="Default" Sprite="CareerSystem\minus_sign_icon" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1.0" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.25" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.75" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.5" />
      </Style>
    </Styles>
  </Brush>

  <!-- Career modal, mockup A (2026-11-13). The Character page's palette: ivory #E8DCC0, gold #CFAE6B,
       dim #A39882, muted #7F766A. -->

  <!-- A choice row: no fill at rest, a faint gold fill on hover. The left rule lights with it. -->
  <Brush Name="CareerSystem.ChoiceRow" TransitionDuration="0.1">
    <Layers><BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#CFAE6BFF" /></Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Default" AlphaFactor="0" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Default" AlphaFactor="0.08" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Default" AlphaFactor="0.14" /></Style>
    </Styles>
  </Brush>
  <Brush Name="CareerSystem.ChoiceAccent" TransitionDuration="0.1">
    <Layers><BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#CFAE6BFF" /></Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Default" AlphaFactor="0" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Default" AlphaFactor="1" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Default" AlphaFactor="1" /></Style>
    </Styles>
  </Brush>

  <Brush Name="CareerSystem.ChoiceText" Font="FS_Garamond" FontSize="19" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#E8DCC0FF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.ChoiceTextDim" Font="FS_Garamond" FontSize="19" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#7F766AFF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.ChoiceBadge" Font="FS_CinzelWide" FontSize="11" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#CFAE6BFF" /></Styles>
  </Brush>

  <Brush Name="CareerSystem.GroupName" Font="FS_CinzelWide" FontSize="15" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#CFAE6BFF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.RuleText" Font="FS_CinzelWide" FontSize="11" TextHorizontalAlignment="Right" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#A39882FF" /></Styles>
  </Brush>

  <Brush Name="CareerSystem.TierWord" Font="FS_CinzelWide" FontSize="11" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#A39882FF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.TierNumeral" Font="FS_CinzelWide" FontSize="24" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#CFAE6BFF" TextAlphaFactor="0.9" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.TierRequirement" Font="FS_Garamond" FontSize="13" TextHorizontalAlignment="Center" TextVerticalAlignment="Top">
    <Styles><Style Name="Default" FontColor="#7F766AFF" /></Styles>
  </Brush>

  <Brush Name="CareerSystem.SidebarName" Font="FS_CinzelWide" FontSize="16" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#CFAE6BFF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.SidebarHeading" Font="FS_CinzelWide" FontSize="12" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#CFAE6BFF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.SidebarText" Font="FS_Garamond" FontSize="19" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#E8DCC0FF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.SidebarNote" Font="FS_Garamond" FontSize="17" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#A39882FF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.SidebarKeystone" Font="FS_Garamond" FontSize="17" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#E0C27AFF" /></Styles>
  </Brush>

  <Brush Name="CareerSystem.FooterLabel" Font="FS_CinzelWide" FontSize="18" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#CFAE6BFF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.FooterNote" Font="FS_Garamond" FontSize="17" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#A39882FF" /></Styles>
  </Brush>

  <!-- Why a choice is locked, under its description. -->
  <Brush Name="CareerSystem.ChoiceLockReason" Font="FS_Garamond" FontSize="16" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#A39882FF" /></Styles>
  </Brush>

  <!-- Switch-mode picker cards. -->
  <Brush Name="CareerSystem.PickerName" Font="FS_CinzelWide" FontSize="22" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#CFAE6BFF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.PickerText" Font="FS_Garamond" FontSize="18" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#E8DCC0FF" /></Styles>
  </Brush>
  <Brush Name="CareerSystem.PickerAbility" Font="FS_CinzelWide" FontSize="14" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#A39882FF" /></Styles>
  </Brush>

</Brushes>
