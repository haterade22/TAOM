<Brushes>
  <!-- The army panel (#1532) in the campaign bar theme: the stone plate, its text, and a cohesion bar whose
       states match vanilla's ArmyOverlay.Cohesion.Fill, which ArmyOverlayCohesionFillBarWidget switches. -->
  <Brush Name="TAOM.Army.Plate"><Layers><BrushLayer Name="Default" Sprite="cb_army_plate" ColorFactor="0.88" /></Layers></Brush>
  <Brush Name="TAOM.Army.Value" Font="FS_Garamond" FontSize="17" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles><Style Name="Default" FontColor="#E6DDC2FF" /></Styles>
  </Brush>
  <Brush Name="TAOM.Army.Cohesion.Track"><Layers><BrushLayer Name="Default" Sprite="cc_slider_track_9" /></Layers></Brush>
  <Brush Name="TAOM.Army.Cohesion.Fill">
    <Layers>
      <BrushLayer Name="Default" Sprite="cc_slider_fill" IsHidden="true" />
      <BrushLayer Name="Warning" Sprite="cc_slider_fill" Color="#E0563EFF" IsHidden="true" />
    </Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Default" IsHidden="false" /></Style>
      <Style Name="WarningLeader" AnimationToPlayOnBegin="WarningAnimation"><BrushLayer Name="Warning" IsHidden="false" /></Style>
      <Style Name="WarningNormal"><BrushLayer Name="Warning" IsHidden="false" /></Style>
    </Styles>
    <Animations>
      <Animation Name="WarningAnimation" Duration="0.75" Loop="true">
        <AnimationProperty LayerName="Warning" PropertyName="ColorFactor">
          <KeyFrame Time="0.0" Value="1.0" />
          <KeyFrame Time="0.2" Value="1.7" />
          <KeyFrame Time="0.55" Value="1.7" />
          <KeyFrame Time="0.75" Value="1.0" />
        </AnimationProperty>
      </Animation>
    </Animations>
  </Brush>
  <!-- ArmyOverlayWidget flips this brush's layers while the panel is open, so the chevron points the way it moves. -->
  <Brush Name="TAOM.Army.Expand" TransitionDuration="0.12">
    <Layers><BrushLayer Name="Default" Sprite="cb_stats_expand" ImageFit.Type="Contain" /></Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Default" ColorFactor="0.85" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Default" ColorFactor="1.3" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Default" ColorFactor="0.65" /></Style>
    </Styles>
  </Brush>
  <Brush Name="TAOM.Army.Portrait.Frame"><Layers><BrushLayer Name="Default" Sprite="fs_hero_frame_9" Color="#9C8048FF" /></Layers></Brush>
  <Brush Name="TAOM.Army.Portrait.Leader"><Layers><BrushLayer Name="Default" Sprite="fs_hero_frame_9" Color="#F4D27AFF" ColorFactor="1.2" /></Layers></Brush>
</Brushes>
