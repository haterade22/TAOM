<Brushes>
  <Brush Name="TAOM.Escape.Dimmer">
    <Layers><BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.55" /></Layers>
  </Brush>
  <Brush Name="TAOM.Escape.Panel">
    <Layers><BrushLayer Name="Default" Sprite="mm_panel" /></Layers>
  </Brush>
  <Brush Name="TAOM.Escape.Divider">
    <Layers><BrushLayer Name="Default" Sprite="mm_divider" /></Layers>
  </Brush>
  <Brush Name="TAOM.Escape.Logo">
    <Layers><BrushLayer Name="Default" Sprite="mm_title" /></Layers>
  </Brush>
  <Brush Name="TAOM.Escape.LogoShine">
    <Layers><BrushLayer Name="Default" Sprite="mm_title_shine" AlphaFactor="0.30" /></Layers>
  </Brush>
  <Brush Name="TAOM.Escape.ScrollTrack">
    <Layers><BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#C9AB69FF" AlphaFactor="0.18" /></Layers>
  </Brush>

  <Brush Name="TAOM.Escape.Title" Font="FS_CinzelWide" FontSize="24" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#EFE7D2FF" TextGlowColor="#000000B0" TextGlowRadius="0.15" TextBlur="0.1" />
    </Styles>
  </Brush>

  <Brush Name="TAOM.Escape.Button">
    <Layers>
      <BrushLayer Name="Plate" Sprite="fs_confirm" />
    </Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Plate" AlphaFactor="0.9" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Plate" AlphaFactor="1" ColorFactor="1.2" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Plate" AlphaFactor="1" ColorFactor="0.85" /></Style>
      <Style Name="Disabled"><BrushLayer Name="Plate" AlphaFactor="0.35" /></Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="checkbox" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <Brush Name="TAOM.Escape.Button.Positive">
    <Layers>
      <BrushLayer Name="Plate" Sprite="fs_confirm" />
    </Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Plate" AlphaFactor="1" ColorFactor="1.05" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Plate" AlphaFactor="1" ColorFactor="1.25" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Plate" AlphaFactor="1" ColorFactor="0.85" /></Style>
      <Style Name="Disabled"><BrushLayer Name="Plate" AlphaFactor="0.35" /></Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="checkbox" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <Brush Name="TAOM.Escape.ButtonText" Font="FS_Garamond" FontSize="18" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#E9E1CCFF" TextGlowColor="#000000A0" TextGlowRadius="0.12" TextBlur="0.05" />
      <Style Name="Hovered" FontColor="#F6E7B4FF" TextGlowColor="#E2BE7855" TextGlowRadius="0.28" TextBlur="0.2" />
      <Style Name="Pressed" FontColor="#D8BC78FF" TextGlowColor="#E2BE7855" TextGlowRadius="0.22" TextBlur="0.16" />
      <Style Name="Disabled" FontColor="#E1D9C4FF" TextAlphaFactor="0.35" />
    </Styles>
  </Brush>

  <Brush Name="TAOM.Escape.ScrollHandle">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#C9AB69FF" />
    </Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Default" AlphaFactor="0.7" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Default" AlphaFactor="1" ColorFactor="1.2" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Default" AlphaFactor="1" ColorFactor="0.8" /></Style>
    </Styles>
  </Brush>
</Brushes>
