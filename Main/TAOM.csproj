<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>2.0.0</Version>
		<Deterministic>true</Deterministic>
		<PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
		<ModuleId>$(MSBuildProjectName)</ModuleId>
		<ModuleName>$(MSBuildProjectName)</ModuleName>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Override BuildResources default: deploy Assets, AssetSources, and GUI/SpriteParts to game folder -->
		<ExcludeSourceFilesFromModule>false</ExcludeSourceFilesFromModule>
	</PropertyGroup>

	<ItemGroup>
		<!-- System.Management hosts the WMI API surface used by
		     Features/CrashReport/Collectors/GpuDisplayCollector for GPU vendor/driver/VRAM
		     reporting. MUST HintPath to the TaleWorlds-shipped copy (4.0.1.0) — referencing the
		     .NET 4.7.2 BCL reference assembly resolves to 4.0.0.0 and produces MSB3277 conflict
		     warnings on every build because every TaleWorlds.* DLL depends on 4.0.1.0 via
		     System.Management.dll v4.700.19.56404 at <game>\bin\Win64_Shipping_Client\. At
		     runtime the game has already loaded the 4.0.1.0 copy, so compile-time matching is
		     required for predictable behavior. -->
		<Reference Include="$(TaomSystemManagementDll)">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- System.IO.Compression hosts ZipArchive used by Features/CrashReport/Rendering/CrashBundleWriter
		     to bundle the crash report + log files + RGL log into a single ZIP for upload. The .NET
		     4.7.2 BCL reference here is fine — TaleWorlds doesn't ship its own copy and there's
		     no version skew. -->
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.IO.Compression.FileSystem" />
		<Reference Include="$(TaomSystemNumericsVectorsDll)">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
			<Aliases>SNV</Aliases>
		</Reference>
		<Reference Include="$(TaomGameBin)\TaleWorlds.*.dll" Exclude="$(TaomGameBin)\TaleWorlds.Native.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(TaomNativeModuleBin)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(TaomSandBoxModuleBin)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(TaomCustomBattleModuleBin)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- UIExtenderEx + HarmonyLib are provided by TAOM.Dependencies.dll (ILRepacked /
		     source-included into the dependency assembly). See ProjectReference below.
		     Removed external Bannerlord.UIExtenderEx HintPath in DR1 of dep-internalization
		     migration (2026-05-22) — TAOM.Dependencies module is the single source. -->
	</ItemGroup>

	<!-- BehaviorTrees + BehaviorTreeWrapper were rebuilt in-tree on 2026-05-24 and now
	     live at Main/BehaviorTrees/ + Main/BehaviorTreeWrapper/. Both compile into TAOM.dll.
	     The standalone BehaviorTrees.dll and BehaviorTreeWrapper.dll vendored binaries
	     are gone — single-DLL ship surface, full source ownership. RCA:
	     docs/reviews/rca-looter-battle-nre-2026-05-24.md. -->

	<ItemGroup>
		<Compile Remove="_Module\bin\**" />
		<EmbeddedResource Remove="_Module\bin\**" />
		<None Remove="_Module\bin\**" />
		<!-- Sibling parallel-ports restored 2026-05-07: SmartCavalryAI, CompanionTactics. -->
	</ItemGroup>

	<ItemGroup>
		<None Include="_Module\ModuleData\project.mbproj" />
	</ItemGroup>

	<!-- DR1 (2026-05-22): TAOM.Dependencies provides HarmonyLib + Bannerlord.UIExtenderEx
	     at runtime (source-included in the Dependencies project). Compile-time refs come
	     via this ProjectReference, NOT via Lib.Harmony / Bannerlord.UIExtenderEx package or
	     external module HintPath. Private=False keeps Dependencies.dll out of TAOM/bin/ —
	     it ships separately as TAOM.Dependencies module per SubModule.xml dep. -->
	<ItemGroup>
		<ProjectReference Include="..\Dependencies\TAOM.Dependencies.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Bannerlord.BuildResources" Version="1.1.0.129">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Bannerlord.MCM" Version="5.12.3" IncludeAssets="compile" />
		<PackageReference Include="DryIoc.dll" Version="4.8.8" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<!-- DR3 (2026-05-22): Lib.Harmony + Bannerlord.UIExtenderEx PackageReferences are
		     here so TAOM source compiles against HarmonyLib + Bannerlord.UIExtenderEx types.
		     IncludeAssets="compile" deploys NO runtime DLL from TAOM/bin/ — at runtime, the
		     types come from TAOM.Dependencies.dll (which has Lib.Harmony + Bannerlord.UIExtenderEx
		     ILRepack-merged into it).
		     DR1's earlier setup (TAOM.Dependencies source-merged Harmony) was replaced after the
		     decompile-source approach hit unresolvable cascading errors. See
		     docs/migration/dr3-execution-handoff.md. -->
		<PackageReference Include="Lib.Harmony" Version="2.4.2" IncludeAssets="compile" />
		<PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.3" IncludeAssets="compile" />
		<PackageReference Include="BUTR.Harmony.Analyzer" Version="1.0.1.50" PrivateAssets="all" />
		<PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<!-- InternalsVisibleTo for unit testing and TAOM_Online multiplayer module -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TAOM.Tests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TAOM_Online</_Parameter1>
		</AssemblyAttribute>
		<!-- NSubstitute (Castle DynamicProxy) can only fake an internal interface when its generated assembly sees internals;
		     the Fords of War adapters are internal because their signatures carry the internal domain types. -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
		</AssemblyAttribute>
		<!-- ADR-013: TAOM.Client is core's friend, not a dependency; core never references it
		     (ClientIsolationGateTests). The moved screen extensions use several core internals. -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TAOM.Client</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<!-- Nothing under _Module may be Visual Studio workspace state. ExcludeSourceFilesFromModule
	     is false above, which switches off Bannerlord.BuildResources' built-in exclusion list, so
	     CopyModule recurses _Module verbatim and deploys whatever it finds. A .vs folder there
	     therefore reaches the player's game install, and DocumentLayout.json holds absolute paths
	     naming this machine's drive layout and whichever module folder the GUI was authored in.
	     Fail loudly rather than delete: an unexpected file under _Module is the author's to look at.
	     The release-zip path is closed independently by tools/package_release.py (VS_IDE_STATE). -->
	<!-- Conditioned on what CopyModule itself checks, not on DisableModuleCopy (which does
	     NOT gate CopyModule). MSBuild runs a BeforeTargets dependency before evaluating the
	     host target's own Condition, so without this the guard would fail the agent-standard
	     `-p:DisableModuleCopy=true -p:ModuleId=` build over a deployment that cannot happen. -->
	<Target Name="FailOnIdeStateInModule" BeforeTargets="PostBuildCopyToModules"
	        Condition="'$(ModuleId)' != '' AND Exists('$(GameFolder)')">
		<ItemGroup>
			<_TaomIdeState Include="$(ProjectDir)_Module\**\.vs\**\*" />
		</ItemGroup>
		<Error Condition="'@(_TaomIdeState)' != ''"
		       Text="IDE workspace state under _Module would be deployed to the game install: @(_TaomIdeState, '%3B '). Delete the .vs folder under Main/_Module/ (and from &lt;game&gt;\Modules\$(ModuleId)\, deployment is additive)." />
	</Target>

	<!-- Game Pass is not supported (2026-10-22), but Bannerlord.BuildResources' CopyModule deploys everything
	     under _Module verbatim, so a Gaming.Desktop.x64_Shipping_Client folder left in this project's
	     staging by an older checkout would reach the game install with an old TAOM.dll. Fail loudly rather
	     than delete. Same condition as CopyModule's, not DisableModuleCopy (see FailOnIdeStateInModule). -->
	<Target Name="FailOnGamePassStagingInModule" BeforeTargets="PostBuildCopyToModules"
	        Condition="'$(ModuleId)' != '' AND Exists('$(GameFolder)')">
		<Error Condition="Exists('$(ProjectDir)_Module\bin\Gaming.Desktop.x64_Shipping_Client\')"
		       Text="Game Pass is not supported, but $(ProjectDir)_Module\bin\Gaming.Desktop.x64_Shipping_Client\ exists and CopyModule would deploy it. Delete that folder (and from &lt;game&gt;\Modules\$(ModuleId)\bin\, deployment is additive), then build again." />
	</Target>

	<Target Name="CopyBinariesToModuleFolder" BeforeTargets="PostBuildCopyToModules">
		<!-- Create directories if they don't exist -->
		<MakeDir Directories="$(ProjectDir)_Module\bin\Win64_Shipping_Client\" Condition="!Exists('$(ProjectDir)_Module\bin\Win64_Shipping_Client\')" />

		<!-- Copy to Win64_Shipping_Client -->
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ProjectDir)_Module\bin\Win64_Shipping_Client\" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(ProjectDir)_Module\bin\Win64_Shipping_Client\" />
	</Target>

	<!-- Mirror the deployed Win64_Shipping_Client folder to Win64_Shipping_wEditor in the game install
	     so the modding kit (Win64_Shipping_wEditor) loads the same TAOM.dll + companions as the runtime.
	     Runs AFTER Bannerlord.BuildResources's PostBuildCopyToModules — the source folder must already be
	     populated by CopyBinariesWindows + CopyModule. Without this mirror, the modding kit launches
	     stale DLLs and code changes are invisible until manually copied with `cp -v Client/* wEditor/`.
	     See docs/features/scene-scripts.md "Editor compatibility" section.

	     TAOM.Client (ADR-013) is not part of this build: a deploying build of Main alone cleans it from
	     Win64_Shipping_Client, but the additive mirror would keep the editor bin's old copy, built
	     against an older core (old code runs against the new core, or the game aborts if core changed a
	     type the client binds at load). It is deleted here, and
	     Client/TAOM.Client.csproj (DeployTaomClientToTaomModule) redeploys a fresh one into both
	     client bins after Main. Game Pass is not supported: nothing here stages or deploys its bin.
	     The Delete uses TreatErrorsAsWarnings because the Modding Kit holds TAOM.Client.dll open: a locked
	     file means the Kit has a matched pair loaded, so the build must not fail over it. The Copy after it
	     still fails loudly if TAOM.dll changed while the Kit holds it. -->
	<Target Name="MirrorWin64ShippingClientToEditor"
	        AfterTargets="PostBuildCopyToModules"
	        Condition="$(ModuleId) != '' AND Exists($(GameFolder)) AND $(DisableModuleCopy) != 'true' AND Exists('$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_Client\')">
		<ItemGroup>
			<_TaomEditorMirrorFiles Include="$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_Client\*.*" />
			<_TaomEditorClientFiles Include="$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_wEditor\TAOM.Client.*" />
		</ItemGroup>
		<MakeDir Directories="$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_wEditor\" Condition="!Exists('$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_wEditor\')" />
		<Delete Files="@(_TaomEditorClientFiles)" TreatErrorsAsWarnings="true" />
		<Copy SourceFiles="@(_TaomEditorMirrorFiles)" DestinationFolder="$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_wEditor\" SkipUnchangedFiles="true" />
		<Message Importance="high" Text="TAOM: mirrored @(_TaomEditorMirrorFiles->Count()) files Win64_Shipping_Client -&gt; Win64_Shipping_wEditor in $(GameFolder)\Modules\$(ModuleId)\bin\" />
	</Target>

	<!-- Same mirror again for Win64_Shipping_Server, so a Bannerlord DEDICATED SERVER loads TAOM.
	     Without this folder the server boots the TAOM world with none of our code — it logs
	     "Cannot find: ...\TAOM\bin\Win64_Shipping_Server\TAOM.dll" and then runs a vanilla
	     simulation over TAOM's map: no race capture, no War of the Ring, no campaign systems at all.
	     Reported from co-op field testing 2026-08-03 §3, where operators had to hand-copy the DLLs.

	     Mirroring the assembled CLIENT folder (rather than copying build output) is deliberate: it
	     picks up the vendored natives and NuGet companions that are only present after
	     PostBuildCopyToModules, which is exactly the file set the field recipe listed by hand.

	     TAOM.Client (ADR-013) is client-only and never reaches this folder: it is excluded here and a
	     stale copy is deleted, because the server staging promotes a stray DLL into its app bin. -->
	<Target Name="MirrorWin64ShippingClientToServer"
	        AfterTargets="PostBuildCopyToModules"
	        Condition="$(ModuleId) != '' AND Exists($(GameFolder)) AND $(DisableModuleCopy) != 'true' AND Exists('$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_Client\')">
		<ItemGroup>
			<_TaomServerMirrorFiles Include="$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_Client\*.*"
			                        Exclude="$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_Client\TAOM.Client.*" />
			<_TaomServerClientFiles Include="$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_Server\TAOM.Client.*" />
		</ItemGroup>
		<MakeDir Directories="$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_Server\" Condition="!Exists('$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_Server\')" />
		<Delete Files="@(_TaomServerClientFiles)" />
		<Copy SourceFiles="@(_TaomServerMirrorFiles)" DestinationFolder="$(GameFolder)\Modules\$(ModuleId)\bin\Win64_Shipping_Server\" SkipUnchangedFiles="true" />
		<Message Importance="high" Text="TAOM: mirrored @(_TaomServerMirrorFiles->Count()) files Win64_Shipping_Client -&gt; Win64_Shipping_Server in $(GameFolder)\Modules\$(ModuleId)\bin\" />
	</Target>

	<Import Project="..\GameReferences.targets" />
</Project>
