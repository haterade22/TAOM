      "commandLineArgs": "/singleplayer _MODULES_*TAOM.Dependencies*Native*SandBoxCore*CustomBattle*Sandbox*StoryMode*BirthAndDeath*FastMode*Alliance.Wargs*LOTRLOME_Armory*TAOM_Map*$(ModuleId)*_MODULES_",
      "workingDirectory": "$(GameFolder)\\bin\\$(GameBinariesFolder)",
