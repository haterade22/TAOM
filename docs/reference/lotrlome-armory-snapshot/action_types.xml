<?xml version="1.0" encoding="utf-8"?>
<action_types>
	<!-- ==================== SPIDER ==================== -->
	<!-- Action types for the giant spider creature. Bound to animations in
	     action_sets_spider.xml under the 'as_spider' action_set. -->
	<!-- Idles -->
	<action name="act_spider_idle" />
	<!-- actt_idle dedicated row action (parity audit 2026-06-12): the warg's upper-body
	     pace-1/front row uses act_warg_idle_1 TYPED actt_idle; this is the spider mirror.
	     Kept separate from the untyped act_spider_idle (which feeds verb slots). -->
	<action name="act_spider_idle_1" type="actt_idle" />
	<action name="act_spider_idle_2" />
	<action name="act_spider_idle_dg" />
	<!-- Movement -->
	<action name="act_spider_walk_forward" />
	<action name="act_spider_walk_left" />
	<action name="act_spider_walk_right" />
	<action name="act_spider_run_forward" />
	<!-- actt_dash (NOT actt_jump) 2026-06-12: warg (act_warg_jump_start) AND elephant
	     (act_elephant_jump_start) both type their usage-set jump_start_action as actt_dash.
	     A jump-TYPED action that is absent from the monster_usage_jump rows misses the engine's
	     jump_actions_map_ - tolerated on 1.4.5, AV on 1.4.6 (monster_usage.cpp sentinel deref,
	     ~34s into battle at first spider jump). Backup: .bak-jumptype-146. -->
	<action name="act_spider_jump" type="actt_dash" />
	<action name="act_spider_turn_left" />
	<action name="act_spider_turn_right" />
	<!-- Attacks -->
	<action name="act_spider_attack_front" />
	<action name="act_spider_attack_back" />
	<action name="act_spider_attack_left" />
	<action name="act_spider_attack_right" />
	<action name="act_spider_attack_top" />
	<action name="act_spider_attack_bottom" />
	<action name="act_spider_attack_charge" />
	<!-- Hit reactions -->
	<action name="act_spider_hit_front" />
	<action name="act_spider_hit_back" />
	<action name="act_spider_hit_left" />
	<action name="act_spider_hit_right" />
	<!-- Death -->
	<action name="act_spider_death" />
	<action name="act_spider_death_2" />
	<!-- Mount knockdown/fall surface (2026-06-11): every Mountable monster needs TYPED
	     actt_fall codes + _continue siblings (warg/elephant parity); the blow handler
	     chains <fall>_continue on downed mounts; missing/untyped = native AV (HandleBlowAux). -->
	<action name="act_spider_fall_right" type="actt_fall" />
	<action name="act_spider_fall_right_continue" type="actt_fall" />
	<action name="act_spider_fall_left" type="actt_fall" />
	<action name="act_spider_fall_left_continue" type="actt_fall" />
	<action name="act_spider_fall_roll" type="actt_fall" />
	<action name="act_spider_fall_roll_continue" type="actt_fall" />
	<action name="act_spider_fall_backwards" type="actt_fall" />
	<action name="act_spider_fall_backwards_continue" type="actt_fall" />
	<action name="act_spider_fall_slow_right" type="actt_fall" />
	<action name="act_spider_fall_slow_right_continue" type="actt_fall" />
	<action name="act_spider_fall_slow_left" type="actt_fall" />
	<action name="act_spider_fall_slow_left_continue" type="actt_fall" />
	<!-- Mount verb surface, TYPED (elephant parity): the native dispatch is type-driven
	     (actt_rear fires on damaged mounts, actt_mount_strike on tramples, etc.); untyped
	     verb actions feed the wrong native handler. 2026-06-11 blow-AV fix, round 2. -->
	<action name="act_spider_rear" type="actt_rear" />
	<action name="act_spider_rear_damaged" type="actt_rear" />
	<action name="act_spider_dash" type="actt_dash" />
	<action name="act_spider_kick" type="actt_kick" />
	<action name="act_spider_quick_stop" type="actt_mount_quick_stop" />
	<action name="act_spider_quick_stop_when_fast" type="actt_mount_quick_stop" />
	<action name="act_spider_hit_object" type="actt_hit_object" />
	<action name="act_spider_hit_object_while_falling" type="actt_hit_object" />
	<action name="act_spider_strike_front" type="actt_mount_strike" />
	<action name="act_spider_strike_back" type="actt_mount_strike" />
	<!-- UNTYPED while-moving light strikes (parity audit 2026-06-12): warg's is_heavy=False
	     strike rows use dedicated untyped *_while_moving actions; same shape here. -->
	<action name="act_spider_strike_front_while_moving" />
	<action name="act_spider_strike_back_while_moving" />
	<!-- Misc -->
	<action name="act_spider_taunt" />

