<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for the engine-binding gate (TestCategory=BindingVerification) only. The
     verify-bindings skill and CI pass this file to dotnet test explicitly. In the gate an
     Assert.Inconclusive means nothing was checked, so it fails the run here, and a filter that
     matches no test (a renamed category, a typo) is an error, not a green run of nothing. The
     default suite does not use this file on purpose: there a test skips when the game or the
     Armory is absent (see the GameAssemblies doc comment). BindingGateRunSettingsTests pins
     all three settings.

     TAOM_RUN_BENCHMARKS=1 opts the gate in to the checks that are opt-in in the default suite
     and tagged BindingVerification (today XmlMergeLiveEquivalenceTests, about 45 s). Without it
     each would be Inconclusive here, so the gate would fail it. -->
<RunSettings>
  <RunConfiguration>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
    <EnvironmentVariables>
      <TAOM_RUN_BENCHMARKS>1</TAOM_RUN_BENCHMARKS>
    </EnvironmentVariables>
  </RunConfiguration>
  <MSTest>
    <MapInconclusiveToFailed>true</MapInconclusiveToFailed>
  </MSTest>
</RunSettings>
