// Version information shown in the file's properties. Keep the numbers in step with KEEPER_VERSION in keeper.c.
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ShaderCacheKeeper for Mount & Blade II Bannerlord (forwards XInput to Windows)"
            VALUE "ProductName", "ShaderCacheKeeper (TAOM build)"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductVersion", "1.1.0"
            VALUE "OriginalFilename", "xinput9_1_0.dll"
            VALUE "Comments", "Keeps the game's compiled shaders when the mod list changes. Source: keeper.c. MIT, (c) 2026 yotthani; TAOM changes in keeper.c."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
