.serena/cache/
.serena/project.local.yml

# graphify output. `graphify extract --out` defaults to the SCANNED directory, so
# omitting it drops a graphify-out/ tree (graph.json runs to tens of MB, plus a
# per-file cache) wherever the command was aimed. That already happened once:
# Main/graphify-out/cache/stat-index.json, 684 KB, is tracked on bannerlord-1.5.x
# via 8318e346. graphify is a personal analysis aid, never repo content.
graphify-out/

# DR3 source-merge: vendored upstream BUTR + Harmony + MonoMod + Cecil source (downloaded fresh from GitHub tags each session — see docs/migration/dr3-mcm-internalization-plan.md)
Dependencies/.vendor-source/

# Skill state files (per-skill working state — context snapshots, autonomous-loop
# results.tsv, etc.). Per ADR-010 + lint-cleanup-loop skill, autonomous campaigns
# follow karpathy/autoresearch's pattern of an untracked results.tsv plus
# transient state files.
.claude/state/

# Knowledge-base raw materials (see docs/raw/README.md + ADR-010):
# Large binary source materials (PDFs, screenshots, video) live alongside the
# markdown summaries but should not bloat the repo. Markdown + small inline
# images < 500KB commit normally; large binaries are user-local only.
docs/raw/**/*.pdf
docs/raw/**/*.mp4
docs/raw/**/*.mov
docs/raw/**/*.zip
docs/raw/**/*.tar.gz

# Tool-sandbox scratch that regenerates inside the repo root:
# .dotnet_cli_home/ — the sandboxed Bash env points DOTNET_CLI_HOME at the CWD,
# so dotnet build/test recreate first-run sentinels + queued telemetry here.
# .codex_tmp*/ — Codex CLI sandbox temp dirs (restrictive ACLs spam git warnings).
.dotnet_cli_home/
.codex_tmp*/

# Raw Codex/adversarial review transcripts (2-4 MB each): kept on disk for
# reference, never committed. The durable record is the committed distillate
# (prompt + RCA + REVIEW-LOG entry + LESSONS-LEARNED). See docs/reviews/REVIEW-GUIDE.md.
docs/reviews/raw/

# Voice-design auditions from the elevenlabs MCP server. This path is also the
# server's ELEVENLABS_MCP_BASE_PATH sandbox in .mcp.json, so it is the only place
# that server can write: auditions never land in ModuleSounds by accident, and the
# batch render goes through tools/generate_voices.py instead. Keep the chosen voice
# ID (in the manifest), discard the takes. See docs/features/kingdom-voices.md.
.voice-scratch/

# Secrets and credentials. Nothing of this shape has ever been committed here
# (full history swept 2026-09-01 across every ref: the only hit was the tracked
# tools/.env.example, which is a documented template with no values in it).
# These rules exist so that a stray `git add -A` can never be the first time.
#
# .env is the one that is actually live: tools/.env.example lists the vars, and
# the real tools/.env sits next to it holding machine-local paths. Root-level
# patterns with no slash match at every depth, so one block covers tools/,
# Main/, and anywhere else a script decides to drop one. The two negations keep
# the committed template visible.
.env
.env.*
*.env
!.env.example
!*.env.example

# Private keys and certificate material. No file with any of these extensions
# exists in the repo or its history, so the globs cost nothing today and cover
# the day someone drops a signing key or a dev cert in the tree. Deliberately
# NOT including *.asc / *.sig, because a detached release signature is meant
# to be committed.
*.pem
*.key
*.p12
*.pfx
*.ppk
*.keystore
*.jks
*.crt
*.cer
*.der
*.gpg
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Tool + package-manager credential files.
.npmrc
.pypirc
.netrc
_netrc
secrets.json
credentials.json
