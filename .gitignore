nul

# Local MCP configuration (contains machine-specific paths)
.vscode/mcp.json
tools/runes/raw_ai/
tools/runes/preview/

# Translator artifacts (backups/exports kept locally, not in repo)
Main/_Module/ModuleData/Languages/*.zip

# Node tool dependencies (FBX/TPAC analysis tools — install via npm)
tools/node_modules/

# Claude Code / Codex transient runtime state
.claude/scheduled_tasks.lock
.claude/worktrees/
.codex-temp/
.dotnet-cli-home/

# Python bytecode caches (anywhere under tools/)
tools/**/__pycache__/
tools/**/*.pyc

# Audit-MeshRefs.ps1 report output (regenerated per run)
tools/reports/

# Serena MCP code-indexing cache
.serena/cache/
.serena/project.local.yml

# DR3 source-merge: vendored upstream BUTR + Harmony + MonoMod + Cecil source (downloaded fresh from GitHub tags each session — see docs/migration/dr3-mcm-internalization-plan.md)
Dependencies/.vendor-source/

# Knowledge-base raw materials (see docs/raw/README.md + ADR-010):
# Large binary source materials (PDFs, screenshots, video) live alongside the
# markdown summaries but should not bloat the repo. Markdown + small inline
# images < 500KB commit normally; large binaries are user-local only.
docs/raw/**/*.pdf
docs/raw/**/*.mp4
docs/raw/**/*.mov
docs/raw/**/*.zip
docs/raw/**/*.tar.gz
